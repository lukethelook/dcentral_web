---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Manifest from '../components/Manifest.astro';
import Leistungen from '../components/Leistungen.astro';
import Films from '../components/Films.astro';
import Work from '../components/Work.astro';
import Studio from '../components/Studio.astro';
import Accelerator from '../components/Accelerator.astro';
import Region from '../components/Region.astro';
import Prozess from '../components/Prozess.astro';
import Faq from '../components/Faq.astro';
import Footer from '../components/Footer.astro';
import PhotoShowcase from '../components/PhotoShowcase.astro';
import Haltung from '../components/Haltung.astro';
---

<Layout>
  <Nav home />
  <main id="main">
    <Hero />
    <Manifest />
    <Leistungen />
    <Films />
    <Work />
    <Studio />
    <Haltung />
    <PhotoShowcase />
    <Accelerator />
    <Region />
    <Prozess />
    <Faq />
  </main>
  <Footer home />
</Layout>

<script>
  // Homepage-only systems of „Von hier. Weiter." (see docs/brand/DESIGN.md).
  import '../scripts/landscapes.js';
  import '../scripts/discipline-patterns.js';
  import '../scripts/concept.js';
  import '../scripts/project-gallery.js';
  import '../scripts/home-motion.js';
</script>
