---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import SoundscapeDemo from '../../components/SoundscapeDemo.astro';

export async function getStaticPaths() {
  const cases = await getCollection('cases');
  return cases.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const d = entry.data;
const paragraphs = (d.body ?? '').split(/\n{2,}/).map((p) => p.trim()).filter(Boolean);
// Keystatic image fields may store just a filename — tolerate both forms.
const src = (p: string) => (/^(https?:|\/)/.test(p) ? p : `/images/cases/${p}`);
const disciplines = [d.discipline, ...d.also];

// neighbouring cases for prev/next navigation + gallery index for the cover colour
const all = (await getCollection('cases')).sort((a, b) => a.data.order - b.data.order);
const idx = all.findIndex((c) => c.id === entry.id);
const next = all[(idx + 1) % all.length];

// Real cover first; otherwise the first preview (flagged while it is a dummy); else the line cover.
const visual = d.cover
  ? { src: src(d.cover), dummy: false }
  : d.previews[0]
    ? { src: src(d.previews[0]), dummy: d.previewDummy }
    : { src: `/assets/project-lines-${idx % 4}.svg`, dummy: false };
const showcase = d.showcase?.desktop ? d.showcase : null;
const phones = (d.showcase?.phones ?? []).filter((p): p is string => !!p).slice(0, 3);
const screens = d.screens.filter((s) => s.image);
// Group screens into rows: a desktop followed by a phone share a row ("combo"),
// consecutive phones or images sit side by side, "wide" images get a row each.
type Screen = (typeof screens)[number];
const rows: { kind: string; items: Screen[] }[] = [];
for (const s of screens) {
  const last = rows.at(-1);
  if (last && last.kind === 'desktop' && s.device === 'mobile' && last.items.length === 1) { last.kind = 'combo'; last.items.push(s); }
  else if (last && last.kind === s.device && s.device !== 'wide' && s.device !== 'desktop' && last.items.length < 4) last.items.push(s);
  else rows.push({ kind: s.device, items: [s] });
}
const liveHost = d.url ? d.url.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '') : null;
const arrow = 'M6 18 18 6M6 6h12v12';
// Signal phrase: the part of the title that carries the promise gets the chartreuse marker.
const signalAt = d.signal ? d.title.indexOf(d.signal) : -1;
const signalParts = signalAt >= 0 ? [d.title.slice(0, signalAt), d.title.slice(signalAt + d.signal!.length)] : null;
---

<Layout title={`${d.title} — ${disciplines.join(' & ')} für ${d.client} · dcentral`} description={d.summary} heroTheme="light">
  <Nav />
  <main class="page shell" id="main">
    <a href="/#arbeiten" class="page-back">
      <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M19 12H5m7-7-7 7 7 7"></path></svg>
      Alle Arbeiten
    </a>
    <p class="page-eyebrow">{disciplines.join(' · ')} · {d.year}</p>
    <h1 class="case-title">
      {signalParts ? <>{signalParts[0]}<mark class="signal">{d.signal}</mark>{signalParts[1]}</> : d.title}
    </h1>
    <p class="case-client">
      {d.client}
      {d.url && <> · <a class="case-live" href={d.url} rel="noopener" target="_blank">{liveHost} <svg aria-hidden="true" viewBox="0 0 24 24"><path d={arrow}></path></svg></a></>}
    </p>

    {phones.length > 0 ? (
      <div class={`case-visual case-showcase case-showcase--phones cover-${idx % 4}`} aria-label={`Mockup: ${d.client} auf dem Smartphone`} role="img">
        {phones.map((p, i) => (
          <div class={`sc-phone sc-float sc-float--${i}`} aria-hidden="true">
            <div class="sc-screen"><img src={src(p)} alt="" decoding="async" /></div>
          </div>
        ))}
      </div>
    ) : showcase ? (
      <div class={`case-visual case-showcase cover-${idx % 4}`} aria-label={`Animiertes Mockup: ${d.client} auf Desktop und Smartphone`} role="img">
        <div class="sc-browser" aria-hidden="true">
          <div class="sc-bar"><i></i><i></i><i></i><span>{showcase.label || liveHost || d.client}</span></div>
          <div class="sc-screen"><img class="sc-scroll" src={src(showcase.desktop!)} alt="" decoding="async" /></div>
        </div>
        {showcase.mobile && (
          <div class="sc-phone" aria-hidden="true">
            <div class="sc-screen"><img class="sc-scroll sc-scroll--phone" src={src(showcase.mobile)} alt="" decoding="async" /></div>
          </div>
        )}
      </div>
    ) : (
      <div class={`case-visual cover-${idx % 4}`}>
        <img src={visual.src} alt={visual.dummy ? '' : d.title} />
        {visual.dummy && <span class="case-flag">Dummymotiv · Originale folgen</span>}
      </div>
    )}

    <div class="case-body">
      <div>
        <p class="case-lead">{d.summary}</p>
        <div class="case-prose">{paragraphs.map((p) => <p>{p}</p>)}</div>
      </div>
      <dl class="case-meta">
        <div><dt>Leistung</dt><dd>{disciplines.join(' · ')}</dd></div>
        <div><dt>Jahr</dt><dd>{d.year}</dd></div>
        {d.url && <div><dt>Live</dt><dd><a class="case-live" href={d.url} rel="noopener" target="_blank">{liveHost} <svg aria-hidden="true" viewBox="0 0 24 24"><path d={arrow}></path></svg></a></dd></div>}
        {d.tags.length > 0 && (
          <div><dt>Themen</dt><dd><ul class="tags">{d.tags.map((t) => <li>{t}</li>)}</ul></dd></div>
        )}
      </dl>
    </div>

    {d.highlights.length > 0 && (
      <section class="case-section" aria-labelledby="case-highlights">
        <h2 id="case-highlights" class="case-h2">{d.highlightsTitle || 'Was gebaut wurde'}</h2>
        <div class="case-highlights">
          {d.highlights.map((h, i) => (
            <article>
              <span>{String(i + 1).padStart(2, '0')}</span>
              <h3>{h.t}</h3>
              <p>{h.d}</p>
            </article>
          ))}
        </div>
      </section>
    )}

    {d.demo === 'soundscape' && <SoundscapeDemo />}

    {rows.map((row) => (
      <section class={`case-screens case-screens--${row.kind}`} style={`--n:${row.items.length}`} aria-label="Screens">
        {row.items.map((s) => (
          <figure class={`case-screen case-screen--${s.device}`}>
            {s.device === 'desktop' ? (
              <div class="sc-browser sc-browser--static">
                <div class="sc-bar" aria-hidden="true"><i></i><i></i><i></i><span>{liveHost || d.client}</span></div>
                <img src={src(s.image!)} alt={s.caption || `${d.client} – Desktop`} loading="lazy" decoding="async" />
              </div>
            ) : s.device === 'mobile' ? (
              <div class="sc-phone sc-phone--static">
                <div class="sc-screen"><img src={src(s.image!)} alt={s.caption || `${d.client} – Smartphone`} loading="lazy" decoding="async" /></div>
              </div>
            ) : (
              <img class="case-image" src={src(s.image!)} alt={s.caption || d.client} loading="lazy" decoding="async" />
            )}
            {s.caption && <figcaption>{s.caption}</figcaption>}
          </figure>
        ))}
      </section>
    ))}

    {d.loop.length > 0 && (
      <section class="case-section" aria-labelledby="case-loop">
        <h2 id="case-loop" class="case-h2">{d.loopTitle || 'So funktioniert es'}</h2>
        <ol class="steps case-loop" data-signal-loop>
          <span class="case-loop-signal" aria-hidden="true"></span>
          {d.loop.map((s, i) => (
            <li>
              <span>{String(i + 1).padStart(2, '0')}</span>
              <h3>{s.t}</h3>
              <p>{s.d}</p>
            </li>
          ))}
        </ol>
      </section>
    )}

    {d.stack.length > 0 && (
      <section class="case-section case-section--stack" aria-labelledby="case-stack">
        <h2 id="case-stack" class="case-h2">Techstack</h2>
        <ul class="case-stack">{d.stack.map((t) => <li>{t}</li>)}</ul>
      </section>
    )}

    <section class="case-cta" aria-labelledby="case-cta">
      <div>
        <h2 id="case-cta">Du hast etwas Ähnliches <em>vor?</em></h2>
        <p>Vom Auftritt bis zur KI, die ihn weiterentwickelt: Ich baue Systeme, die für dich arbeiten – ein Ansprechpartner, ein Netzwerk dahinter.</p>
      </div>
      <a class="action magnetic" href="/#kontakt">
        Projekt starten
        <svg aria-hidden="true" viewBox="0 0 24 24"><path d={arrow}></path></svg>
      </a>
    </section>

    <a href={`/arbeiten/${next.id}`} class="case-next">
      <span>Nächstes Projekt</span>
      <strong>{next.data.client} — {next.data.title}</strong>
    </a>
  </main>
  <Footer />
</Layout>
