---
// Gallery editor (/cms/galerien). Project galleries and the homepage photo module,
// visual and drag & drop. Local: writes files; online: commits via GitHub with the
// Keystatic login (see src/cms/api.ts). Same JSON as Keystatic.
import '../styles/fonts.css';
export const prerender = false;
---

<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="robots" content="noindex" />
  <title>Galerien · dcentral CMS</title>
  <!-- global: most of the UI is rendered from JS and would miss Astro's scoped styles -->
  <style is:global>
    :root { --paper:#f3f4ec; --ink:#153e35; --muted:#52685c; --line:#cbd4c6; --soft:#e8ece0; --lime:#d4ff3f; --forest:#102f28; --red:#a3352a; --ease:cubic-bezier(.23,1,.32,1); }
    * { box-sizing: border-box; }
    body { margin: 0; background: var(--paper); color: var(--ink); font: 400 15px/1.5 Manrope, system-ui, sans-serif; padding-bottom: 96px; }
    button, input, select, textarea { font: inherit; color: inherit; }
    button { cursor: pointer; }
    [hidden] { display: none !important; }

    header { position: sticky; top: 0; z-index: 20; display: flex; align-items: center; gap: 18px; padding: 12px 28px; background: var(--forest); color: var(--paper); }
    .brand { font-weight: 800; font-size: 20px; letter-spacing: -.05em; white-space: nowrap; }
    .brand span { color: var(--lime); }
    .tabs { display: flex; gap: 4px; }
    .tabs button { background: none; border: 1px solid transparent; color: inherit; padding: 7px 15px; border-radius: 99px; }
    .tabs button[aria-pressed=true] { border-color: var(--lime); color: var(--lime); }
    header .grow { flex: 1; }
    header a { color: rgba(243,244,236,.7); font-size: 13px; }
    .badge-mode { font-size: 12px; padding: 4px 10px; border-radius: 99px; background: rgba(212,255,63,.12); color: var(--lime); white-space: nowrap; }

    main { max-width: 1400px; margin: 0 auto; padding: 28px 28px 40px; }
    section + section { margin-top: 48px; }
    .head { display: flex; flex-wrap: wrap; align-items: end; gap: 16px 24px; margin-bottom: 14px; }
    h1 { font-size: 30px; font-weight: 600; letter-spacing: -.04em; margin: 0; line-height: 1.1; }
    h2 { font-size: 22px; font-weight: 600; letter-spacing: -.03em; margin: 0; }
    .field { display: grid; gap: 5px; }
    .field label { font-size: 11px; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); }
    select, input[type=text], input[type=search], textarea { padding: 10px 12px; border: 1px solid var(--line); border-radius: 9px; background: #fff; }
    #case { min-width: 320px; font-weight: 600; }
    #gtitle { min-width: 300px; }
    textarea { min-height: 80px; resize: vertical; width: 100%; }
    .hint { color: var(--muted); font-size: 13.5px; margin: 0 0 16px; }

    /* gallery: the photos of this project, in order */
    .gal { display: grid; grid-template-columns: repeat(auto-fill, minmax(210px, 1fr)); gap: 16px; padding: 16px; background: var(--soft); border-radius: 14px; min-height: 180px; }
    .gal-empty { grid-column: 1/-1; align-self: center; text-align: center; color: var(--muted); padding: 40px 10px; }
    .card { position: relative; background: #fff; border-radius: 11px; overflow: hidden; box-shadow: 0 1px 0 rgba(16,47,40,.08); transition: transform 180ms var(--ease), box-shadow 180ms var(--ease), opacity 180ms ease; }
    .card .img { position: relative; aspect-ratio: 4/3; background: #ccd3c4; }
    .gal .card .img { cursor: grab; }
    .card .img img { width: 100%; height: 100%; object-fit: cover; display: block; pointer-events: none; }
    .card .no { position: absolute; left: 9px; top: 9px; background: var(--lime); color: var(--forest); font-weight: 800; font-size: 13px; min-width: 26px; text-align: center; padding: 2px 8px; border-radius: 99px; }
    .card .grip { position: absolute; right: 9px; top: 9px; background: rgba(16,47,40,.7); color: #fff; font-size: 11px; padding: 3px 8px; border-radius: 99px; }
    .card .meta { padding: 9px 11px 11px; }
    .card .title { font-weight: 600; font-size: 13.5px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .card .sub { font-size: 12px; color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .card .actions { display: flex; gap: 6px; margin-top: 8px; flex-wrap: wrap; }
    .btn { border: 1px solid var(--line); background: #fff; padding: 5px 11px; border-radius: 99px; font-size: 12.5px; }
    .btn:hover:not(:disabled) { border-color: var(--ink); }
    .btn:disabled { opacity: .35; cursor: default; }
    .btn.danger { color: var(--red); }
    .btn.danger:hover { border-color: var(--red); background: #fbeeec; }
    .btn.icon { padding: 5px 10px; }
    .card.dragging { opacity: .35; }
    .card.over { box-shadow: 0 0 0 3px var(--lime); transform: scale(.97); }
    .card.hidden-home { opacity: .5; }
    .card .flag { position: absolute; left: 9px; bottom: 9px; background: rgba(16,47,40,.82); color: #fff; font-size: 11px; padding: 2px 8px; border-radius: 99px; }
    .warn { display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: #e59a2f; margin-left: 6px; vertical-align: middle; }

    /* add photos */
    .dropzone { display: grid; place-items: center; text-align: center; border: 2px dashed var(--ink); border-radius: 14px; padding: 26px; margin-bottom: 22px; background: #fff; cursor: pointer; transition: background 160ms ease, border-color 160ms ease; }
    .dropzone:hover { background: #f6ffd6; border-color: var(--forest); }
    .dropzone strong { font-size: 17px; }
    .dropzone span { color: var(--muted); font-size: 13.5px; }
    .tools { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; margin-bottom: 14px; }
    .tools input[type=search] { width: 260px; }
    .pills { display: flex; flex-wrap: wrap; gap: 6px; }
    .pills button { border: 1px solid var(--line); background: none; padding: 6px 12px; border-radius: 99px; font-size: 13px; }
    .pills button[aria-pressed=true] { background: var(--ink); border-color: var(--ink); color: var(--paper); }
    .lib { display: grid; grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); gap: 14px; }
    .lib .card .img { cursor: pointer; }
    .add { width: 100%; border: 0; padding: 8px; font-weight: 700; font-size: 13px; background: var(--forest); color: var(--lime); }
    .add.on { background: var(--lime); color: var(--forest); }
    .lib .card.on { box-shadow: 0 0 0 3px var(--lime); }

    /* save bar */
    .savebar { position: fixed; left: 50%; bottom: 18px; z-index: 30; display: flex; align-items: center; gap: 14px; padding: 10px 12px 10px 20px; border-radius: 99px; background: var(--forest); color: var(--paper); box-shadow: 0 16px 40px rgba(16,47,40,.35); transform: translate(-50%, 160%); transition: transform 260ms var(--ease); max-width: calc(100vw - 32px); }
    .savebar.show { transform: translate(-50%, 0); }
    .savebar .what { font-size: 14px; }
    .savebar button { border: 0; border-radius: 99px; padding: 9px 18px; font-weight: 700; }
    .savebar .discard { background: none; color: rgba(243,244,236,.75); font-weight: 500; }
    .savebar .save { background: var(--lime); color: var(--forest); }
    .savebar .save:disabled { opacity: .5; }

    dialog { border: 0; border-radius: 16px; padding: 0; width: min(760px, 94vw); box-shadow: 0 30px 80px rgba(16,47,40,.35); }
    dialog::backdrop { background: rgba(16,47,40,.55); }
    .dlg { display: grid; grid-template-columns: 1fr 1fr; }
    .dlg img { width: 100%; height: 100%; object-fit: cover; display: block; min-height: 340px; }
    .dlg form { padding: 22px; display: grid; gap: 14px; }
    .dlg .row-btns { display: flex; gap: 8px; align-items: center; margin-top: 4px; }
    .dlg .row-btns .grow { flex: 1; }
    .dlg .ok { border: 0; background: var(--lime); color: var(--forest); font-weight: 700; padding: 9px 18px; border-radius: 99px; }
    .dlg .usage { font-size: 12.5px; color: var(--muted); margin: 0; }

    .toast { position: fixed; top: 70px; left: 50%; transform: translate(-50%, -10px); opacity: 0; background: var(--forest); color: var(--paper); padding: 10px 18px; border-radius: 99px; font-size: 13.5px; transition: transform 220ms var(--ease), opacity 220ms ease; z-index: 50; pointer-events: none; }
    .toast.show { transform: translate(-50%, 0); opacity: 1; }
    .drop-all { position: fixed; inset: 0; z-index: 40; display: none; place-items: center; background: rgba(16,47,40,.86); color: var(--paper); font-size: 24px; font-weight: 600; text-align: center; }
    .drop-all.show { display: grid; }
    .drop-all small { display: block; font-size: 14px; font-weight: 400; opacity: .75; margin-top: 8px; }
    .login { position: fixed; inset: 0; z-index: 60; display: grid; place-items: center; background: var(--forest); color: var(--paper); text-align: center; padding: 24px; }
    .login h1 { font-size: clamp(30px, 4vw, 44px); margin: 14px 0 10px; }
    .login p { max-width: 46ch; margin: 0 auto 22px; color: rgba(243,244,236,.75); }
    .login a { display: inline-block; background: var(--lime); color: var(--forest); font-weight: 700; padding: 11px 20px; border-radius: 99px; text-decoration: none; }
    .home-only { display: none; }
    body.home .home-only { display: revert; }
    body.home .case-only { display: none; }
    @media (prefers-reduced-motion: reduce) { .card, .savebar, .toast { transition: none; } }
  </style>
</head>
<body>
  <header>
    <div class="brand">dcentral<span>.</span> Galerien</div>
    <nav class="tabs" aria-label="Bereich">
      <button type="button" data-mode="case" aria-pressed="true">Projekt-Galerien</button>
      <button type="button" data-mode="home" aria-pressed="false">Startseite</button>
    </nav>
    <div class="grow"></div>
    <span class="badge-mode" id="modebadge"></span>
    <a href="/keystatic" target="_blank" rel="noopener">Keystatic</a>
  </header>

  <main>
    <!-- 1 · the gallery itself -->
    <section aria-labelledby="g-h">
      <div class="head case-only">
        <div class="field"><label for="case">Projekt</label><select id="case"></select></div>
        <div class="field"><label for="gtitle">Überschrift über der Galerie</label><input id="gtitle" type="text" placeholder="z. B. Aus der Bildwelt" /></div>
      </div>
      <div class="head">
        <h1 id="g-h"><span class="case-only">Galerie</span><span class="home-only">Startseite · „Bilder, die bleiben.“</span> <small id="count" style="font-size:16px;color:var(--muted);font-weight:500"></small></h1>
      </div>
      <p class="hint case-only">So erscheinen die Fotos auf der Projektseite. Reihenfolge per Ziehen oder mit ‹ › ändern. <b>Entfernen</b> nimmt ein Foto nur aus dieser Galerie – es bleibt in der Bibliothek.</p>
      <p class="hint home-only">Die Startseite zeigt die ersten 7 Fotos in dieser Reihenfolge. Reihenfolge per Ziehen oder mit ‹ › ändern.</p>
      <div class="gal" id="gal"></div>
    </section>

    <!-- 2 · add photos -->
    <section aria-labelledby="a-h">
      <div class="head"><h2 id="a-h">Fotos hinzufügen</h2></div>
      <label class="dropzone" for="file">
        <div>
          <strong>Neue Fotos hochladen</strong><br />
          <span id="dzinfo">Hierher ziehen oder klicken</span>
        </div>
      </label>
      <input id="file" type="file" accept="image/*" multiple hidden />
      <div class="tools">
        <input id="q" type="search" placeholder="Bibliothek durchsuchen …" />
        <div class="pills" id="series"></div>
      </div>
      <div class="lib" id="lib"></div>
    </section>
  </main>

  <div class="savebar" id="savebar" role="region" aria-label="Speichern">
    <span class="what" id="what"></span>
    <button type="button" class="discard" id="discard">Verwerfen</button>
    <button type="button" class="save" id="save">Speichern</button>
  </div>
  <div class="toast" id="toast" role="status"></div>
  <div class="drop-all" id="dropall"><div>Loslassen zum Hochladen<small id="dropinfo"></small></div></div>
  <div class="login" id="login" hidden>
    <div>
      <div class="brand">dcentral<span>.</span> Galerien</div>
      <h1>Bitte zuerst anmelden.</h1>
      <p>Der Galerie-Editor nutzt deine Keystatic-Anmeldung über GitHub. Nur wer im Repository schreiben darf, kann speichern.</p>
      <a href="/keystatic">In Keystatic mit GitHub anmelden</a>
      <p style="margin-top:16px;font-size:13px">Danach diese Seite neu laden.</p>
    </div>
  </div>

  <dialog id="dlg">
    <div class="dlg">
      <img id="dimg" alt="" />
      <form method="dialog">
        <div class="field"><label for="dtitle">Titel</label><input id="dtitle" type="text" /></div>
        <div class="field"><label for="dalt">Bildbeschreibung (Alt-Text)</label><textarea id="dalt" placeholder="Was ist zu sehen? Wichtig für Barrierefreiheit und Google."></textarea></div>
        <div class="field"><label for="dseries">Serie (Filter auf der Fotografie-Seite)</label><input id="dseries" type="text" list="serieslist" /><datalist id="serieslist"></datalist></div>
        <div class="field"><label for="dproject">Gehört zu Projekt</label><select id="dproject"></select></div>
        <p class="usage" id="dusage"></p>
        <div class="row-btns">
          <button type="button" class="btn danger" id="ddelete">Foto löschen …</button>
          <span class="grow"></span>
          <button class="btn" value="cancel">Abbrechen</button>
          <button class="ok" value="save">Übernehmen</button>
        </div>
      </form>
    </div>
  </dialog>

  <script>
    type Photo = { id: string; image: string; thumb?: string; title?: string; alt?: string; series?: string; project?: string | null; featured?: boolean; order?: number; width?: number; height?: number; preview?: string };
    type Case = { id: string; title: string; client: string; galleryTitle: string; galleryPhotos: string[] };
    type NewPhoto = { id: string; json: Photo; big: string; sm: string };
    const $ = <T extends HTMLElement = HTMLElement>(s: string) => document.querySelector(s) as T;
    const esc = (s: unknown) => String(s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);

    let cases: Case[] = [], photos: Photo[] = [], byId = new Map<string, Photo>();
    let mode: 'case' | 'home' = 'case', current = '', selection: string[] = [], seriesFilter = 'Alle', query = '';
    let store: 'local' | 'github' = 'local', branch = '', imageBase = '';
    // everything waits here until "Speichern" (online that is one commit)
    let newPhotos = new Map<string, NewPhoto>(), photoEdits: Record<string, Partial<Photo>> = {}, deletes = new Set<string>();
    let baseline = '', titleBase = '';
    const src = (p: Photo) => p.preview || imageBase + (p.thumb || p.image);

    /* ── server ── */
    class LoginNeeded extends Error {}
    async function call(action: string, init?: RequestInit, retry = true): Promise<any> {
      const r = await fetch(`/api/cms/${action}`, init);
      if (r.status === 401) {
        // the GitHub token from Keystatic lasts ~8 h; Keystatic can renew it with its refresh cookie
        if (retry && (await fetch('/api/keystatic/github/refresh-token', { method: 'POST' })).ok) return call(action, init, false);
        throw new LoginNeeded();
      }
      const d = await r.json().catch(() => ({}));
      if (!r.ok) throw new Error(d.error || r.statusText);
      return d;
    }
    const postJson = (action: string, body: unknown) => call(action, { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(body) });

    let toastTimer = 0;
    function toast(msg: string, ms = 2800) { const t = $('#toast'); t.textContent = msg; t.classList.add('show'); clearTimeout(toastTimer); toastTimer = window.setTimeout(() => t.classList.remove('show'), ms); }

    /* ── state ── */
    function changes() {
      const out: string[] = [];
      if (selection.join(',') !== baseline) out.push(mode === 'case' ? 'Galerie geändert' : 'Startseite geändert');
      if (mode === 'case' && $<HTMLInputElement>('#gtitle').value !== titleBase) out.push('Überschrift');
      if (newPhotos.size) out.push(`${newPhotos.size} neue${newPhotos.size === 1 ? 's Foto' : ' Fotos'}`);
      const e = Object.keys(photoEdits).length; if (e) out.push(`${e} Foto-Info${e === 1 ? '' : 's'}`);
      if (deletes.size) out.push(`${deletes.size} gelöscht`);
      return out;
    }
    const isDirty = () => changes().length > 0;
    function refreshBar() {
      const c = changes();
      $('#what').textContent = c.length ? `Nicht gespeichert: ${c.join(' · ')}` : '';
      $('#savebar').classList.toggle('show', c.length > 0);
    }

    async function load() {
      let s;
      try { s = await call('state'); } catch (e) { if (e instanceof LoginNeeded) { $('#login').hidden = false; return; } toast(String((e as Error).message), 6000); return; }
      store = s.mode; branch = s.branch || ''; imageBase = s.imageBase || '';
      $('#modebadge').textContent = store === 'github' ? `Online · speichert auf ${branch}` : 'Lokal';
      cases = s.cases; photos = s.photos; byId = new Map(photos.map((p: Photo) => [p.id, p]));
      newPhotos = new Map(); photoEdits = {}; deletes = new Set();
      $('#case').innerHTML = cases.map((c) => `<option value="${c.id}">${esc(c.client)} — ${esc(c.title)}</option>`).join('');
      $('#dproject').innerHTML = '<option value="">– keinem Projekt –</option>' + cases.map((c) => `<option value="${c.id}">${esc(c.client)}</option>`).join('');
      const wanted = new URLSearchParams(location.search).get('projekt');
      current = cases.some((c) => c.id === wanted) ? wanted! : cases.some((c) => c.id === current) ? current : cases[0]?.id || '';
      $<HTMLSelectElement>('#case').value = current;
      $('#serieslist').innerHTML = [...new Set(photos.map((p) => p.series).filter(Boolean))].map((x) => `<option value="${esc(x)}">`).join('');
      pick();
    }
    function pick() {
      if (mode === 'case') {
        const c = cases.find((x) => x.id === current)!;
        selection = c.galleryPhotos.filter((id) => byId.has(id));
        $<HTMLInputElement>('#gtitle').value = titleBase = c.galleryTitle || '';
      } else selection = photos.filter((p) => p.featured).sort((a, b) => (a.order ?? 0) - (b.order ?? 0)).map((p) => p.id);
      baseline = selection.join(',');
      const c = cases.find((x) => x.id === current);
      $('#dzinfo').textContent = mode === 'case' && c ? `Hierher ziehen oder klicken – landen direkt in der Galerie von ${c.client}` : 'Hierher ziehen oder klicken – landen in der Bibliothek und auf der Startseite';
      render();
    }

    /* ── render ── */
    function render() {
      $('#count').textContent = `${selection.length} ${selection.length === 1 ? 'Foto' : 'Fotos'}`;
      $('#gal').innerHTML = selection.length ? selection.map((id, i) => {
        const p = byId.get(id)!, hidden = mode === 'home' && i >= 7;
        return `<article class="card${hidden ? ' hidden-home' : ''}" draggable="true" data-id="${id}">
          <div class="img"><img src="${src(p)}" alt="" loading="lazy"><span class="no">${i + 1}</span><span class="grip" aria-hidden="true">⋮⋮ ziehen</span>${hidden ? '<span class="flag">nicht sichtbar (nur 7)</span>' : ''}</div>
          <div class="meta"><div class="title">${esc(p.title || id)}${p.alt ? '' : '<span class="warn" title="Alt-Text fehlt"></span>'}</div><div class="sub">${esc(p.series)}</div>
            <div class="actions">
              <button type="button" class="btn icon" data-move="-1" data-id="${id}" aria-label="Nach vorne"${i === 0 ? ' disabled' : ''}>‹</button>
              <button type="button" class="btn icon" data-move="1" data-id="${id}" aria-label="Nach hinten"${i === selection.length - 1 ? ' disabled' : ''}>›</button>
              <button type="button" class="btn" data-edit="${id}">Bearbeiten</button>
              <button type="button" class="btn danger" data-remove="${id}">Entfernen</button>
            </div></div></article>`;
      }).join('') : `<div class="gal-empty">${mode === 'case' ? 'Diese Galerie ist noch leer.<br>Unten Fotos hinzufügen oder neue hochladen.' : 'Noch keine Fotos für die Startseite gewählt.'}</div>`;

      const all = ['Alle', ...(mode === 'case' ? ['Dieses Projekt'] : []), ...new Set(photos.map((p) => p.series || 'Fotografie'))];
      $('#series').innerHTML = all.map((x) => `<button type="button" aria-pressed="${x === seriesFilter}" data-s="${esc(x)}">${esc(x)}</button>`).join('');
      const q = query.toLowerCase();
      const list = photos.filter((p) => {
        if (seriesFilter === 'Dieses Projekt' ? p.project !== current : seriesFilter !== 'Alle' && (p.series || 'Fotografie') !== seriesFilter) return false;
        return !q || [p.id, p.title, p.alt, p.series].join(' ').toLowerCase().includes(q);
      });
      $('#lib').innerHTML = list.map((p) => {
        const at = selection.indexOf(p.id);
        return `<article class="card${at >= 0 ? ' on' : ''}">
          <div class="img" data-toggle="${p.id}"><img src="${src(p)}" alt="" loading="lazy">${newPhotos.has(p.id) ? '<span class="no">neu</span>' : ''}</div>
          <div class="meta"><div class="title">${esc(p.title || p.id)}${p.alt ? '' : '<span class="warn" title="Alt-Text fehlt"></span>'}</div><div class="sub">${esc(p.series)} · <a href="#" data-edit="${p.id}" style="color:inherit">Bearbeiten</a></div></div>
          <button type="button" class="add${at >= 0 ? ' on' : ''}" data-toggle="${p.id}">${at >= 0 ? `✓ In der ${mode === 'case' ? 'Galerie' : 'Auswahl'} (Nr. ${at + 1})` : '+ Hinzufügen'}</button>
        </article>`;
      }).join('') || '<p class="hint">Keine Fotos gefunden.</p>';
      refreshBar();
    }
    function toggle(id: string) {
      const i = selection.indexOf(id);
      if (i >= 0) selection.splice(i, 1); else { selection.push(id); toast(`Hinzugefügt als Nr. ${selection.length}`, 1400); }
      render();
    }
    function move(id: string, d: number) {
      const i = selection.indexOf(id), j = i + d;
      if (i < 0 || j < 0 || j >= selection.length) return;
      selection.splice(j, 0, selection.splice(i, 1)[0]); render();
    }

    /* ── save / discard ── */
    async function save() {
      if (!isDirty()) return;
      const btn = $<HTMLButtonElement>('#save'); btn.disabled = true; btn.textContent = 'Speichert …';
      try {
        // keep each request under Vercel's 4.5 MB body limit: big uploads go first in their own commits
        const pending = [...newPhotos.values()], size = (n: NewPhoto) => n.big.length + n.sm.length;
        const chunks: NewPhoto[][] = [[]]; let used = 0;
        for (const n of pending) { if (used + size(n) > 3_200_000 && chunks.at(-1)!.length) { chunks.push([]); used = 0; } chunks.at(-1)!.push(n); used += size(n); }
        for (const chunk of chunks.slice(0, -1)) await postJson('save', { kind: 'files', newPhotos: chunk });
        const base = { photoEdits, newPhotos: chunks.at(-1), deletePhotos: [...deletes], photos: selection };
        if (mode === 'case') await postJson('save', { ...base, kind: 'gallery', case: current, galleryTitle: $<HTMLInputElement>('#gtitle').value });
        else await postJson('save', { ...base, kind: 'home' });
        if (mode === 'case') { const c = cases.find((x) => x.id === current)!; c.galleryPhotos = [...selection]; c.galleryTitle = titleBase = $<HTMLInputElement>('#gtitle').value; }
        else photos.forEach((p) => { const at = selection.indexOf(p.id); p.featured = at >= 0; if (at >= 0) p.order = at; });
        for (const id of deletes) cases.forEach((c) => { c.galleryPhotos = c.galleryPhotos.filter((x) => x !== id); });
        newPhotos.forEach((n) => { const p = byId.get(n.id); if (p) delete p.preview; });
        baseline = selection.join(','); newPhotos = new Map(); photoEdits = {}; deletes = new Set();
        render();
        toast(store === 'github' ? 'Gespeichert ✓ – auf der Website in ca. 1–2 Minuten sichtbar.' : 'Gespeichert ✓', 4000);
      } catch (e) {
        if (e instanceof LoginNeeded) { $('#login').hidden = false; return; }
        toast(String((e as Error).message), 6000);
      } finally { btn.disabled = false; btn.textContent = 'Speichern'; }
    }
    $('#save').addEventListener('click', save);
    $('#discard').addEventListener('click', () => { if (confirm('Alle ungespeicherten Änderungen verwerfen?')) load(); });
    addEventListener('keydown', (e) => { if ((e.metaKey || e.ctrlKey) && e.key === 's') { e.preventDefault(); save(); } });
    addEventListener('beforeunload', (e) => { if (isDirty()) e.preventDefault(); });

    /* ── upload ── */
    // downscale in the browser first (EXIF-rotated), so even 20 MB camera files fit through
    async function shrink(file: File): Promise<Blob> {
      try {
        const bmp = await createImageBitmap(file);
        const k = Math.min(1, 2400 / Math.max(bmp.width, bmp.height));
        const c = document.createElement('canvas'); c.width = Math.round(bmp.width * k); c.height = Math.round(bmp.height * k);
        c.getContext('2d')!.drawImage(bmp, 0, 0, c.width, c.height);
        return await new Promise((res) => c.toBlob((b) => res(b || file), 'image/jpeg', 0.92));
      } catch { return file; }
    }
    async function upload(files: File[]) {
      const list = files.filter((f) => f.type.startsWith('image/'));
      if (!list.length) return;
      const c = cases.find((x) => x.id === current);
      let n = 0;
      for (const f of list) {
        toast(`Bild ${++n} von ${list.length} wird vorbereitet …`, 60000);
        try {
          const form = new FormData();
          form.append('file', await shrink(f), f.name.replace(/\.[^.]+$/, '') + '.jpg');
          form.append('name', f.name);
          form.append('series', mode === 'case' && c ? c.client : 'Fotografie');
          if (mode === 'case' && c) form.append('project', c.id);
          form.append('taken', [...byId.keys()].join(','));
          const r = await call('process', { method: 'POST', body: form });
          const p: Photo = { id: r.id, ...r.json, preview: `data:image/webp;base64,${r.sm}` };
          newPhotos.set(r.id, { id: r.id, json: r.json, big: r.big, sm: r.sm });
          photos.push(p); byId.set(p.id, p); selection.push(p.id);
          render();
        } catch (e) {
          if (e instanceof LoginNeeded) { $('#login').hidden = false; return; }
          toast(`${f.name}: ${(e as Error).message}`, 5000);
        }
      }
      toast(`${list.length} ${list.length === 1 ? 'Foto' : 'Fotos'} hinzugefügt – Alt-Text ergänzen (Bearbeiten), dann speichern.`, 4500);
    }
    $<HTMLInputElement>('#file').addEventListener('change', () => { const i = $<HTMLInputElement>('#file'); if (i.files) upload([...i.files]); i.value = ''; });
    let depth = 0;
    const hasFiles = (e: DragEvent) => [...(e.dataTransfer?.types || [])].includes('Files');
    addEventListener('dragenter', (e) => { if (!hasFiles(e)) return; depth++; $('#dropinfo').textContent = $('#dzinfo').textContent; $('#dropall').classList.add('show'); });
    addEventListener('dragleave', (e) => { if (!hasFiles(e)) return; if (--depth <= 0) { depth = 0; $('#dropall').classList.remove('show'); } });
    addEventListener('dragover', (e) => { if (hasFiles(e)) e.preventDefault(); });
    addEventListener('drop', (e) => { if (!hasFiles(e)) return; e.preventDefault(); depth = 0; $('#dropall').classList.remove('show'); upload([...e.dataTransfer!.files]); });

    /* ── events ── */
    function switchTo(fn: () => void) {
      if (isDirty() && !confirm('Ungespeicherte Änderungen verwerfen?')) return false;
      if (isDirty()) { photos = photos.filter((p) => !newPhotos.has(p.id)); newPhotos.forEach((_, id) => byId.delete(id)); newPhotos = new Map(); photoEdits = {}; deletes = new Set(); }
      fn(); return true;
    }
    $('#case').addEventListener('change', () => {
      const next = $<HTMLSelectElement>('#case').value;
      if (!switchTo(() => { current = next; seriesFilter = 'Alle'; history.replaceState(null, '', `?projekt=${current}`); pick(); })) $<HTMLSelectElement>('#case').value = current;
    });
    $('#gtitle').addEventListener('input', refreshBar);
    document.querySelectorAll<HTMLButtonElement>('[data-mode]').forEach((b) => b.addEventListener('click', () => {
      if (b.dataset.mode === mode) return;
      switchTo(() => {
        mode = b.dataset.mode as 'case' | 'home'; document.body.classList.toggle('home', mode === 'home');
        document.querySelectorAll('[data-mode]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        seriesFilter = 'Alle'; pick();
      });
    }));
    $('#q').addEventListener('input', () => { query = $<HTMLInputElement>('#q').value; render(); });
    $('#series').addEventListener('click', (e) => { const b = (e.target as HTMLElement).closest('button'); if (b) { seriesFilter = b.dataset.s!; render(); } });
    document.querySelector('main')!.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      const edit = t.closest<HTMLElement>('[data-edit]'); if (edit) { e.preventDefault(); openEdit(edit.dataset.edit!); return; }
      const rm = t.closest<HTMLElement>('[data-remove]'); if (rm) { toggle(rm.dataset.remove!); return; }
      const mv = t.closest<HTMLElement>('[data-move]'); if (mv) { move(mv.dataset.id!, Number(mv.dataset.move)); return; }
      const tg = t.closest<HTMLElement>('[data-toggle]'); if (tg) toggle(tg.dataset.toggle!);
    });

    // reorder by dragging cards inside the gallery
    let dragId: string | null = null;
    const gal = $('#gal');
    gal.addEventListener('dragstart', (e) => { const c = (e.target as HTMLElement).closest<HTMLElement>('.card'); if (!c) return; dragId = c.dataset.id!; c.classList.add('dragging'); e.dataTransfer!.effectAllowed = 'move'; e.dataTransfer!.setData('text/plain', dragId); });
    gal.addEventListener('dragend', () => { dragId = null; gal.querySelectorAll('.card').forEach((c) => c.classList.remove('dragging', 'over')); });
    gal.addEventListener('dragover', (e) => { if (!dragId) return; e.preventDefault(); const c = (e.target as HTMLElement).closest<HTMLElement>('.card'); gal.querySelectorAll('.card.over').forEach((x) => x !== c && x.classList.remove('over')); c?.classList.add('over'); });
    gal.addEventListener('drop', (e) => {
      if (!dragId) return; e.preventDefault(); e.stopPropagation();
      const c = (e.target as HTMLElement).closest<HTMLElement>('.card'), from = selection.indexOf(dragId);
      const to = c ? selection.indexOf(c.dataset.id!) : selection.length - 1;
      if (from >= 0 && to >= 0 && from !== to) { selection.splice(to, 0, selection.splice(from, 1)[0]); render(); }
    });

    /* ── photo details + delete ── */
    let editing = '';
    function usage(id: string) {
      const where = cases.filter((c) => (mode === 'case' && c.id === current ? selection : c.galleryPhotos).includes(id)).map((c) => c.client);
      const home = mode === 'home' ? selection.includes(id) : !!byId.get(id)?.featured;
      return [...where.map((w) => `Galerie ${w}`), ...(home ? ['Startseite'] : [])];
    }
    function openEdit(id: string) {
      const p = byId.get(id)!; editing = id;
      $<HTMLImageElement>('#dimg').src = src(p);
      $<HTMLInputElement>('#dtitle').value = p.title || '';
      $<HTMLTextAreaElement>('#dalt').value = p.alt || '';
      $<HTMLInputElement>('#dseries').value = p.series || '';
      $<HTMLSelectElement>('#dproject').value = p.project || '';
      $('#dusage').textContent = `Verwendet in: ${usage(id).join(', ') || 'keiner Galerie'} · ${p.width ?? '?'} × ${p.height ?? '?'} px`;
      $<HTMLDialogElement>('#dlg').showModal();
    }
    $('#dlg').addEventListener('close', () => {
      if ($<HTMLDialogElement>('#dlg').returnValue !== 'save' || !editing) return;
      const edit = { title: $<HTMLInputElement>('#dtitle').value, alt: $<HTMLTextAreaElement>('#dalt').value, series: $<HTMLInputElement>('#dseries').value, project: $<HTMLSelectElement>('#dproject').value || null };
      Object.assign(byId.get(editing)!, edit);
      const fresh = newPhotos.get(editing);
      if (fresh) Object.assign(fresh.json, edit); else photoEdits[editing] = { ...(photoEdits[editing] || {}), ...edit };
      render();
    });
    $('#ddelete').addEventListener('click', () => {
      const p = byId.get(editing); if (!p) return;
      const also = usage(editing);
      if (!confirm(`„${p.title || p.id}“ endgültig löschen?${also.length ? `\n\nEs wird auch entfernt aus: ${also.join(', ')}.` : ''}\n\nWirksam nach „Speichern“.`)) return;
      if (newPhotos.has(editing)) newPhotos.delete(editing); else deletes.add(editing);
      delete photoEdits[editing];
      selection = selection.filter((x) => x !== editing);
      photos = photos.filter((x) => x.id !== editing); byId.delete(editing);
      $<HTMLDialogElement>('#dlg').close('deleted');
      render();
    });

    load();
  </script>
</body>
</html>
