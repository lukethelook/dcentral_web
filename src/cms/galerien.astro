    }
    const isDirty = () => changes().length > 0;
    function refreshBar() {
      const c = changes();
      $('#what').textContent = c.length ? `Nicht gespeichert: ${c.join(' · ')}` : '';
      $('#savebar').classList.toggle('show', c.length > 0);
    }

    async function load() {
      let s;
      try { s = await call('state'); } catch (e) { if (e instanceof LoginNeeded) { $('#login').hidden = false; return; } toast(String((e as Error).message), 6000); return; }
      store = s.mode; branch = s.branch || ''; imageBase = s.imageBase || '';
      $('#modebadge').textContent = store === 'github' ? `Online · speichert auf ${branch}` : 'Lokal';
      cases = s.cases; photos = s.photos; archiveList = s.archive || []; byId = new Map(photos.map((p: Photo) => [p.id, p]));
      newPhotos = new Map(); newScreens = new Map(); photoEdits = {}; deletes = new Set();
      $('#case').innerHTML = cases.map((c) => `<option value="${c.id}">${esc(c.client)} — ${esc(c.title)}</option>`).join('');
      $('#dproject').innerHTML = '<option value="">– keinem Projekt –</option>' + cases.map((c) => `<option value="${c.id}">${esc(c.client)}</option>`).join('');
      const params = new URLSearchParams(location.search), wanted = params.get('projekt'), wantedMode = params.get('bereich') as Mode | null;
      current = cases.some((c) => c.id === wanted) ? wanted! : cases.some((c) => c.id === current) ? current : cases[0]?.id || '';
      if (wantedMode && ['case', 'projects', 'archive', 'home'].includes(wantedMode)) setMode(wantedMode, false);
      $<HTMLSelectElement>('#case').value = current;
      $('#serieslist').innerHTML = [...new Set(photos.map((p) => p.series).filter(Boolean))].map((x) => `<option value="${esc(x)}">`).join('');
      pick();
    }
    function pick() {
      if (mode === 'case') {
        const c = cases.find((x) => x.id === current)!;
        selection = c.galleryPhotos.filter((id) => byId.has(id));
        screens = c.screens.map((x) => ({ image: x.image, device: x.device || 'image', caption: x.caption || '' }));
        $<HTMLInputElement>('#gtitle').value = c.galleryTitle || '';
      } else if (mode === 'home') selection = photos.filter((p) => p.featured).sort((a, b) => (a.order ?? 0) - (b.order ?? 0)).map((p) => p.id);
      else if (mode === 'archive') { archiveAuto = archiveList.length === 0; selection = archiveAuto ? photos.map((p) => p.id) : archiveList.filter((id) => byId.has(id)); }
      else rows = cases.map((c) => ({ ...c, also: [...c.also] }));
      base = { sel: selection.join(','), title: $<HTMLInputElement>('#gtitle').value, screens: screensKey(), rows: rowsKey(), auto: archiveAuto };
      const c = cases.find((x) => x.id === current);
      $('#dzinfo').textContent = mode === 'case' && c ? `Hierher ziehen oder klicken – landen direkt in der Galerie von ${c.client}` : mode === 'archive' ? 'Hierher ziehen oder klicken – landen in der Bibliothek und auf der Fotografie-Seite' : 'Hierher ziehen oder klicken – landen in der Bibliothek und auf der Startseite';
      render();
    }

    /* ── render ── */
    function render() {
      if (mode === 'projects') return renderRows();
      const locked = mode === 'archive' && archiveAuto;
      $('#autonote').hidden = !(mode === 'archive' && archiveAuto);
      $('#manualnote').hidden = !(mode === 'archive' && !archiveAuto);
      $('#autocount').textContent = String(photos.length);
      $('#count').textContent = `${selection.length} ${selection.length === 1 ? 'Foto' : 'Fotos'}${locked ? ' (automatisch)' : ''}`;
      $('#gal').innerHTML = selection.length ? selection.map((id, i) => {
        const p = byId.get(id)!, hidden = mode === 'home' && i >= 7;
        return `<article class="card${hidden || locked ? ' dim' : ''}"${locked ? '' : ' draggable="true"'} data-id="${id}" data-list="sel">
          <div class="img"><img src="${src(p)}" alt="" loading="lazy"><span class="no">${i + 1}</span>${locked ? '' : '<span class="grip" aria-hidden="true">⋮⋮ ziehen</span>'}${hidden ? '<span class="flag">nicht sichtbar (nur 7)</span>' : ''}</div>
          <div class="meta"><div class="title">${esc(p.title || id)}${p.alt ? '' : '<span class="warn" title="Alt-Text fehlt"></span>'}</div><div class="sub">${esc(p.series)}</div>
            ${locked ? '' : `<div class="actions">
              <button type="button" class="btn icon" data-move="-1" data-id="${id}" aria-label="Nach vorne"${i === 0 ? ' disabled' : ''}>‹</button>
              <button type="button" class="btn icon" data-move="1" data-id="${id}" aria-label="Nach hinten"${i === selection.length - 1 ? ' disabled' : ''}>›</button>
              <button type="button" class="btn" data-edit="${id}">Bearbeiten</button>
              <button type="button" class="btn danger" data-remove="${id}">Entfernen</button>
            </div>`}</div></article>`;
      }).join('') : `<div class="gal-empty">${mode === 'case' ? 'Diese Galerie ist noch leer.<br>Unten Fotos hinzufügen oder neue hochladen.' : 'Noch keine Fotos gewählt.'}</div>`;

      if (mode === 'case') renderScreens();

      const all = ['Alle', ...(mode === 'case' ? ['Dieses Projekt'] : []), ...new Set(photos.map((p) => p.series || 'Fotografie'))];
      $('#series').innerHTML = all.map((x) => `<button type="button" aria-pressed="${x === seriesFilter}" data-s="${esc(x)}">${esc(x)}</button>`).join('');
      const q = query.toLowerCase();
      const list = photos.filter((p) => {
        if (seriesFilter === 'Dieses Projekt' ? p.project !== current : seriesFilter !== 'Alle' && (p.series || 'Fotografie') !== seriesFilter) return false;
        return !q || [p.id, p.title, p.alt, p.series].join(' ').toLowerCase().includes(q);
      });
      const where = { case: 'Galerie', archive: 'Fotografie-Seite', home: 'Auswahl' }[mode as 'case' | 'archive' | 'home'];
      $('#lib').innerHTML = list.map((p) => {
        const at = selection.indexOf(p.id);
        return `<article class="card${at >= 0 ? ' on' : ''}">
          <div class="img" data-toggle="${p.id}"><img src="${src(p)}" alt="" loading="lazy">${newPhotos.has(p.id) ? '<span class="no">neu</span>' : ''}</div>
          <div class="meta"><div class="title">${esc(p.title || p.id)}${p.alt ? '' : '<span class="warn" title="Alt-Text fehlt"></span>'}</div><div class="sub">${esc(p.series)} · <a href="#" data-edit="${p.id}" style="color:inherit">Bearbeiten</a></div></div>
          <button type="button" class="add${at >= 0 ? ' on' : ''}" data-toggle="${p.id}"${locked ? ' disabled' : ''}>${at >= 0 ? `✓ ${where} (Nr. ${at + 1})` : '+ Hinzufügen'}</button>
        </article>`;
      }).join('') || '<p class="hint">Keine Fotos gefunden.</p>';
      refreshBar();
    }
    function renderScreens() {
      $('#scount').textContent = `${screens.length}`;
      $('#screens').innerHTML = screens.length ? screens.map((sc, i) => `<article class="card" draggable="true" data-i="${i}" data-list="screens">
          <div class="img"><img src="${sc.preview || imgSrc(sc.image)}" alt="" loading="lazy"><span class="no">${i + 1}</span><span class="grip" aria-hidden="true">⋮⋮ ziehen</span></div>
          <div class="meta">
            <select data-sdev="${i}" aria-label="Typ">${DEVICES.map(([v, l]) => `<option value="${v}"${sc.device === v ? ' selected' : ''}>${l}</option>`).join('')}</select>
            <input type="text" data-scap="${i}" value="${esc(sc.caption)}" placeholder="Bildunterschrift (optional)" aria-label="Bildunterschrift" />
            <div class="actions">
              <button type="button" class="btn icon" data-smove="-1" data-i="${i}" aria-label="Nach vorne"${i === 0 ? ' disabled' : ''}>‹</button>
              <button type="button" class="btn icon" data-smove="1" data-i="${i}" aria-label="Nach hinten"${i === screens.length - 1 ? ' disabled' : ''}>›</button>
              <button type="button" class="btn danger" data-sremove="${i}">Entfernen</button>
            </div>
          </div></article>`).join('') : '<div class="gal-empty">Noch keine Screens. Unten hochladen.</div>';
    }
    function renderRows() {
      $('#pcount').textContent = `${rows.filter((r) => !r.hidden).length} sichtbar · ${rows.length} gesamt`;
      $('#rows').innerHTML = rows.map((r, i) => `<div class="row${r.hidden ? ' is-hidden' : ''}" draggable="true" data-row="${i}">
          <span class="pos" title="Ziehen zum Sortieren">${i + 1}</span>
          <span class="thumb" style="${r.thumb ? `background-image:url('${imgSrc(r.thumb)}')` : ''}"></span>
          <div>
            <div class="name">${esc(r.client)}<small>${esc(r.title)}${r.year ? ` · ${r.year}` : ''}</small></div>
            <div class="topics">${TOPICS.map((t) => `<button type="button" class="topic${t === r.discipline ? ' main' : r.also.includes(t) ? ' on' : ''}" data-topic="${esc(t)}" data-row="${i}">${esc(t)}</button>`).join('')}</div>
          </div>
          <div class="ctl">
            <label class="switch"><input type="checkbox" data-vis="${i}"${r.hidden ? '' : ' checked'} /> Sichtbar</label>
            <button type="button" class="btn icon" data-rmove="-1" data-row="${i}" aria-label="Nach oben"${i === 0 ? ' disabled' : ''}>↑</button>
            <button type="button" class="btn icon" data-rmove="1" data-row="${i}" aria-label="Nach unten"${i === rows.length - 1 ? ' disabled' : ''}>↓</button>
            <button type="button" class="btn" data-open="${r.id}">Galerie &amp; Screens</button>
            <a class="btn" href="/arbeiten/${r.id}" target="_blank" style="text-decoration:none">Ansehen ↗</a>
          </div>
        </div>`).join('');
      refreshBar();
    }
    function toggle(id: string) {
      if (mode === 'archive' && archiveAuto) return;
      const i = selection.indexOf(id);
      if (i >= 0) selection.splice(i, 1); else { selection.push(id); toast(`Hinzugefügt als Nr. ${selection.length}`, 1400); }
      render();
    }
    const moveIn = <T,>(list: T[], i: number, d: number) => { const j = i + d; if (i < 0 || j < 0 || j >= list.length) return; list.splice(j, 0, list.splice(i, 1)[0]); };

    /* ── save / discard ── */
    async function save() {
      if (!isDirty()) return;
      const btn = $<HTMLButtonElement>('#save'); btn.disabled = true; btn.textContent = 'Speichert …';
      try {
        // keep each request under Vercel's 4.5 MB body limit: big uploads go first in their own commits
        const pending = [...newPhotos.values()], size = (n: NewPhoto) => n.big.length + n.sm.length;
        const chunks: NewPhoto[][] = [[]]; let used = 0;
        for (const n of pending) { if (used + size(n) > 3_200_000 && chunks.at(-1)!.length) { chunks.push([]); used = 0; } chunks.at(-1)!.push(n); used += size(n); }
        for (const chunk of chunks.slice(0, -1)) await postJson('save', { kind: 'files', newPhotos: chunk });
        const common = { photoEdits, newPhotos: chunks.at(-1), deletePhotos: [...deletes] };
        if (mode === 'case') {
          // screen uploads: same limit, sent first in their own requests if large
          const ns = [...newScreens.entries()].filter(([p]) => screens.some((x) => x.image === p)).map(([path, data]) => ({ path, data }));
          const sChunks: { path: string; data: string }[][] = [[]]; let su = 0;
          for (const n of ns) { if (su + n.data.length > 3_200_000 && sChunks.at(-1)!.length) { sChunks.push([]); su = 0; } sChunks.at(-1)!.push(n); su += n.data.length; }
          const c = cases.find((x) => x.id === current)!;
          for (const chunk of sChunks.slice(0, -1)) await postJson('save', { kind: 'gallery', case: current, photos: c.galleryPhotos, newScreens: chunk });
          await postJson('save', { ...common, kind: 'gallery', case: current, galleryTitle: $<HTMLInputElement>('#gtitle').value, photos: selection, screens: screens.map(({ image, device, caption }) => ({ image, device, caption })), newScreens: sChunks.at(-1) });
          c.galleryPhotos = [...selection]; c.galleryTitle = $<HTMLInputElement>('#gtitle').value; c.screens = screens.map(({ image, device, caption, preview }) => ({ image, device, caption, preview }));
        } else if (mode === 'projects') {
          await postJson('save', { ...common, kind: 'projects', projects: rows.map((r) => ({ id: r.id, discipline: r.discipline, also: r.also, hidden: r.hidden })) });
          cases = rows.map((r, i) => ({ ...r, order: i }));
        } else if (mode === 'archive') {
          await postJson('save', { ...common, kind: 'archive', photos: archiveAuto ? [] : selection });
          archiveList = archiveAuto ? [] : [...selection];
        } else {
          await postJson('save', { ...common, kind: 'home', photos: selection });
          photos.forEach((p) => { const at = selection.indexOf(p.id); p.featured = at >= 0; if (at >= 0) p.order = at; });
        }
        for (const id of deletes) { cases.forEach((c) => { c.galleryPhotos = c.galleryPhotos.filter((x) => x !== id); }); archiveList = archiveList.filter((x) => x !== id); }
        newPhotos.forEach((n) => { const p = byId.get(n.id); if (p) delete p.preview; });
        newPhotos = new Map(); newScreens = new Map(); photoEdits = {}; deletes = new Set();
        base = { sel: selection.join(','), title: $<HTMLInputElement>('#gtitle').value, screens: screensKey(), rows: rowsKey(), auto: archiveAuto };
        render();
        toast(store === 'github' ? 'Gespeichert ✓ – auf der Website in ca. 1–2 Minuten sichtbar.' : 'Gespeichert ✓', 4000);
      } catch (e) {
        if (e instanceof LoginNeeded) { $('#login').hidden = false; return; }
        toast(String((e as Error).message), 6000);
      } finally { btn.disabled = false; btn.textContent = 'Speichern'; }
    }
    $('#save').addEventListener('click', save);
    $('#discard').addEventListener('click', () => { if (confirm('Alle ungespeicherten Änderungen verwerfen?')) load(); });
    addEventListener('keydown', (e) => { if ((e.metaKey || e.ctrlKey) && e.key === 's') { e.preventDefault(); save(); } });
    addEventListener('beforeunload', (e) => { if (isDirty()) e.preventDefault(); });

    /* ── uploads ── */
    // downscale in the browser first (EXIF-rotated), so even 20 MB camera files fit through Vercel's limit
    async function shrink(file: File, max = 2400): Promise<Blob> {
      try {
        const bmp = await createImageBitmap(file);
        const k = Math.min(1, max / Math.max(bmp.width, bmp.height));
        const c = document.createElement('canvas'); c.width = Math.round(bmp.width * k); c.height = Math.round(bmp.height * k);
        c.getContext('2d')!.drawImage(bmp, 0, 0, c.width, c.height);
        return await new Promise((res) => c.toBlob((b) => res(b || file), 'image/jpeg', 0.92));
      } catch { return file; }
    }
    async function upload(files: File[]) {
      const list = files.filter((f) => f.type.startsWith('image/'));
      if (!list.length || mode === 'projects') return;
      if (mode === 'archive' && archiveAuto) archiveAuto = false; // a new upload turns the archive into a curated list
      const c = cases.find((x) => x.id === current);
      let n = 0;
      for (const f of list) {
        toast(`Bild ${++n} von ${list.length} wird vorbereitet …`, 60000);
        try {
          const form = new FormData();
          form.append('file', await shrink(f), f.name.replace(/\.[^.]+$/, '') + '.jpg');
          form.append('name', f.name);
          form.append('series', mode === 'case' && c ? c.client : 'Fotografie');
          if (mode === 'case' && c) form.append('project', c.id);
          form.append('taken', [...byId.keys()].join(','));
          const r = await call('process', { method: 'POST', body: form });
          const p: Photo = { id: r.id, ...r.json, preview: `data:image/webp;base64,${r.sm}` };
          newPhotos.set(r.id, { id: r.id, json: r.json, big: r.big, sm: r.sm });
          photos.push(p); byId.set(p.id, p); selection.push(p.id);
          render();
        } catch (e) {
          if (e instanceof LoginNeeded) { $('#login').hidden = false; return; }
          toast(`${f.name}: ${(e as Error).message}`, 5000);
        }
      }
      toast(`${list.length} ${list.length === 1 ? 'Foto' : 'Fotos'} hinzugefügt – Alt-Text ergänzen (Bearbeiten), dann speichern.`, 4500);
    }
    async function uploadScreens(files: File[]) {
      const list = files.filter((f) => f.type.startsWith('image/'));
      if (!list.length || mode !== 'case') return;
      let n = 0;
      for (const f of list) {
        toast(`Screen ${++n} von ${list.length} wird vorbereitet …`, 60000);
        try {
          const form = new FormData();
          form.append('file', await shrink(f, 2600), f.name.replace(/\.[^.]+$/, '') + '.jpg');
          form.append('name', f.name); form.append('kind', 'screen'); form.append('project', current);
          const r = await call('process', { method: 'POST', body: form });
          newScreens.set(r.path, r.data);
          const portrait = r.height > r.width * 1.2;
          screens.push({ image: r.path, device: portrait ? 'poster' : 'image', caption: '', preview: `data:image/webp;base64,${r.data}` });
          render();
        } catch (e) {
          if (e instanceof LoginNeeded) { $('#login').hidden = false; return; }
          toast(`${f.name}: ${(e as Error).message}`, 5000);
        }
      }
      toast(`${list.length} ${list.length === 1 ? 'Screen' : 'Screens'} hinzugefügt – Typ und Bildunterschrift prüfen, dann speichern.`, 4500);
    }
    $<HTMLInputElement>('#file').addEventListener('change', () => { const i = $<HTMLInputElement>('#file'); if (i.files) upload([...i.files]); i.value = ''; });
    $<HTMLInputElement>('#sfile').addEventListener('change', () => { const i = $<HTMLInputElement>('#sfile'); if (i.files) uploadScreens([...i.files]); i.value = ''; });
    let depth = 0;
    const hasFiles = (e: DragEvent) => [...(e.dataTransfer?.types || [])].includes('Files');
    addEventListener('dragenter', (e) => { if (!hasFiles(e) || mode === 'projects') return; depth++; $('#dropinfo').textContent = $('#dzinfo').textContent; $('#dropall').classList.add('show'); });
    addEventListener('dragleave', (e) => { if (!hasFiles(e)) return; if (--depth <= 0) { depth = 0; $('#dropall').classList.remove('show'); } });
    addEventListener('dragover', (e) => { if (hasFiles(e)) e.preventDefault(); });
    addEventListener('drop', (e) => { if (!hasFiles(e)) return; e.preventDefault(); depth = 0; $('#dropall').classList.remove('show'); upload([...e.dataTransfer!.files]); });

    /* ── switching areas / projects ── */
    function discardPending() { photos = photos.filter((p) => !newPhotos.has(p.id)); newPhotos.forEach((_, id) => byId.delete(id)); newPhotos = new Map(); newScreens = new Map(); photoEdits = {}; deletes = new Set(); }
    function setMode(m: Mode, doPick = true) {
      mode = m; document.body.dataset.mode = m;
      document.querySelectorAll('[data-mode]').forEach((x) => { if (x.tagName === 'BUTTON') x.setAttribute('aria-pressed', String((x as HTMLElement).dataset.mode === m)); });
      seriesFilter = 'Alle';
      const u = new URL(location.href); u.searchParams.set('bereich', m); history.replaceState(null, '', u);
      if (doPick) pick();
    }
    function guarded(fn: () => void) {
      if (isDirty() && !confirm('Ungespeicherte Änderungen verwerfen?')) return false;
      if (isDirty()) discardPending();
      fn(); return true;
    }
    document.querySelectorAll<HTMLButtonElement>('header [data-mode]').forEach((b) => b.addEventListener('click', () => { if (b.dataset.mode !== mode) guarded(() => setMode(b.dataset.mode as Mode)); }));
    $('#case').addEventListener('change', () => {
      const next = $<HTMLSelectElement>('#case').value;
      if (!guarded(() => { current = next; seriesFilter = 'Alle'; const u = new URL(location.href); u.searchParams.set('projekt', current); history.replaceState(null, '', u); pick(); })) $<HTMLSelectElement>('#case').value = current;
    });
    $('#gtitle').addEventListener('input', refreshBar);
    $('#takeover').addEventListener('click', () => { archiveAuto = false; render(); });
    $('#backauto').addEventListener('click', () => { if (confirm('Wieder automatisch alle Fotos zeigen? Deine Reihenfolge wird verworfen.')) { archiveAuto = true; selection = photos.map((p) => p.id); render(); } });
    $('#q').addEventListener('input', () => { query = $<HTMLInputElement>('#q').value; render(); });
    $('#series').addEventListener('click', (e) => { const b = (e.target as HTMLElement).closest('button'); if (b) { seriesFilter = b.dataset.s!; render(); } });

    document.querySelector('main')!.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      const edit = t.closest<HTMLElement>('[data-edit]'); if (edit) { e.preventDefault(); openEdit(edit.dataset.edit!); return; }
      const rm = t.closest<HTMLElement>('[data-remove]'); if (rm) { toggle(rm.dataset.remove!); return; }
      const mv = t.closest<HTMLElement>('[data-move]'); if (mv) { moveIn(selection, selection.indexOf(mv.dataset.id!), Number(mv.dataset.move)); render(); return; }
      const tg = t.closest<HTMLElement>('[data-toggle]'); if (tg) { toggle(tg.dataset.toggle!); return; }
      const sm = t.closest<HTMLElement>('[data-smove]'); if (sm) { moveIn(screens, Number(sm.dataset.i), Number(sm.dataset.smove)); render(); return; }
      const sr = t.closest<HTMLElement>('[data-sremove]'); if (sr) { const i = Number(sr.dataset.sremove); if (confirm('Diesen Screen aus dem Projekt entfernen?')) { screens.splice(i, 1); render(); } return; }
      const rmv = t.closest<HTMLElement>('[data-rmove]'); if (rmv) { moveIn(rows, Number(rmv.dataset.row), Number(rmv.dataset.rmove)); renderRows(); return; }
      const op = t.closest<HTMLElement>('[data-open]'); if (op) { guarded(() => { current = op.dataset.open!; $<HTMLSelectElement>('#case').value = current; setMode('case'); }); return; }
      const tp = t.closest<HTMLElement>('[data-topic]');
      if (tp) {
        const r = rows[Number(tp.dataset.row)], topic = tp.dataset.topic!;
        if (topic === r.discipline) { if (r.also.length) { r.discipline = r.also.shift()!; } else toast('Ein Projekt braucht mindestens ein Thema.', 2200); }
        else if (r.also.includes(topic)) { r.also = r.also.filter((x) => x !== topic); r.also.unshift(r.discipline); r.discipline = topic; } // active → becomes main
        else r.also.push(topic);
        r.also = r.also.filter((x, i, a) => x !== r.discipline && a.indexOf(x) === i);
        renderRows(); return;
      }
    });
    document.querySelector('main')!.addEventListener('change', (e) => {
      const t = e.target as HTMLElement;
      if (t.matches('[data-sdev]')) { screens[Number((t as HTMLElement).dataset.sdev)].device = (t as HTMLSelectElement).value; refreshBar(); }
      if (t.matches('[data-vis]')) { rows[Number((t as HTMLElement).dataset.vis)].hidden = !(t as HTMLInputElement).checked; renderRows(); }
    });
    document.querySelector('main')!.addEventListener('input', (e) => {
      const t = e.target as HTMLElement;
      if (t.matches('[data-scap]')) { screens[Number(t.dataset.scap)].caption = (t as HTMLInputElement).value; refreshBar(); }
    });

    // drag & drop reordering: gallery cards, screen cards, project rows
    let drag: { list: 'sel' | 'screens' | 'rows'; key: string } | null = null;
    const listOf = (el: HTMLElement) => (el.dataset.row !== undefined && el.classList.contains('row') ? 'rows' : el.dataset.list) as 'sel' | 'screens' | 'rows';
    const keyOf = (el: HTMLElement) => el.dataset.id ?? el.dataset.i ?? el.dataset.row ?? '';
    const itemSel = '.card[draggable], .row[draggable]';
    document.addEventListener('dragstart', (e) => { const el = (e.target as HTMLElement).closest<HTMLElement>(itemSel); if (!el) return; drag = { list: listOf(el), key: keyOf(el) }; el.classList.add('dragging'); e.dataTransfer!.effectAllowed = 'move'; e.dataTransfer!.setData('text/plain', drag.key); });
    document.addEventListener('dragend', () => { drag = null; document.querySelectorAll('.dragging, .over').forEach((x) => x.classList.remove('dragging', 'over')); });
    document.addEventListener('dragover', (e) => { if (!drag) return; const el = (e.target as HTMLElement).closest<HTMLElement>(itemSel); if (!el || listOf(el) !== drag.list) return; e.preventDefault(); document.querySelectorAll('.over').forEach((x) => x !== el && x.classList.remove('over')); el.classList.add('over'); });
    document.addEventListener('drop', (e) => {
      if (!drag) return; const el = (e.target as HTMLElement).closest<HTMLElement>(itemSel); if (!el || listOf(el) !== drag.list) return;
      e.preventDefault(); e.stopPropagation();
      if (drag.list === 'sel') { const from = selection.indexOf(drag.key), to = selection.indexOf(keyOf(el)); if (from >= 0 && to >= 0 && from !== to) { selection.splice(to, 0, selection.splice(from, 1)[0]); render(); } }
      else if (drag.list === 'screens') { const from = Number(drag.key), to = Number(keyOf(el)); if (from !== to) { screens.splice(to, 0, screens.splice(from, 1)[0]); render(); } }
      else { const from = Number(drag.key), to = Number(keyOf(el)); if (from !== to) { rows.splice(to, 0, rows.splice(from, 1)[0]); renderRows(); } }
    });

    /* ── photo details + delete ── */
    let editing = '';
    function usage(id: string) {
      const where = cases.filter((c) => (mode === 'case' && c.id === current ? selection : c.galleryPhotos).includes(id)).map((c) => `Galerie ${c.client}`);
      if (mode === 'home' ? selection.includes(id) : byId.get(id)?.featured) where.push('Startseite');
      if (mode === 'archive' ? !archiveAuto && selection.includes(id) : archiveList.includes(id)) where.push('Fotografie-Seite');
      return where;
    }
    function openEdit(id: string) {
      const p = byId.get(id)!; editing = id;
      $<HTMLImageElement>('#dimg').src = src(p);
      $<HTMLInputElement>('#dtitle').value = p.title || '';
      $<HTMLTextAreaElement>('#dalt').value = p.alt || '';
      $<HTMLInputElement>('#dseries').value = p.series || '';
      $<HTMLSelectElement>('#dproject').value = p.project || '';
      $('#dusage').textContent = `Verwendet in: ${usage(id).join(', ') || 'keiner Liste'} · ${p.width ?? '?'} × ${p.height ?? '?'} px`;
      $<HTMLDialogElement>('#dlg').showModal();
    }
    $('#dlg').addEventListener('close', () => {
      if ($<HTMLDialogElement>('#dlg').returnValue !== 'save' || !editing) return;
      const edit = { title: $<HTMLInputElement>('#dtitle').value, alt: $<HTMLTextAreaElement>('#dalt').value, series: $<HTMLInputElement>('#dseries').value, project: $<HTMLSelectElement>('#dproject').value || null };
      Object.assign(byId.get(editing)!, edit);
      const fresh = newPhotos.get(editing);
      if (fresh) Object.assign(fresh.json, edit); else photoEdits[editing] = { ...(photoEdits[editing] || {}), ...edit };
      render();
    });
    $('#ddelete').addEventListener('click', () => {
      const p = byId.get(editing); if (!p) return;
      const also = usage(editing);
      if (!confirm(`„${p.title || p.id}“ endgültig löschen?${also.length ? `\n\nEs wird auch entfernt aus: ${also.join(', ')}.` : ''}\n\nWirksam nach „Speichern“.`)) return;
      if (newPhotos.has(editing)) newPhotos.delete(editing); else deletes.add(editing);
      delete photoEdits[editing];
      selection = selection.filter((x) => x !== editing);
      photos = photos.filter((x) => x.id !== editing); byId.delete(editing);
      $<HTMLDialogElement>('#dlg').close('deleted');
      render();
    });

    load();
  </script>
</body>
</html>
