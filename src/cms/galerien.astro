---
// dcentral CMS editor (/cms/galerien): project galleries + screens, project order and
// topics, the photography archive and the homepage photo module — visual, drag & drop.
// Local: writes files; online: commits via GitHub with the Keystatic login
// (see src/cms/api.ts). Same JSON as Keystatic.
import '../styles/fonts.css';
export const prerender = false;
---

<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="robots" content="noindex" />
  <title>Editor · dcentral CMS</title>
  <!-- global: most of the UI is rendered from JS and would miss Astro's scoped styles -->
  <style is:global>
    :root { --paper:#f3f4ec; --ink:#153e35; --muted:#52685c; --line:#cbd4c6; --soft:#e8ece0; --lime:#d4ff3f; --forest:#102f28; --red:#a3352a; --ease:cubic-bezier(.23,1,.32,1); }
    * { box-sizing: border-box; }
    body { margin: 0; background: var(--paper); color: var(--ink); font: 400 15px/1.5 Manrope, system-ui, sans-serif; padding-bottom: 96px; }
    button, input, select, textarea { font: inherit; color: inherit; }
    button { cursor: pointer; }
    [hidden] { display: none !important; }

    header { position: sticky; top: 0; z-index: 20; display: flex; align-items: center; gap: 18px; padding: 12px 28px; background: var(--forest); color: var(--paper); flex-wrap: wrap; }
    .brand { font-weight: 800; font-size: 20px; letter-spacing: -.05em; white-space: nowrap; }
    .brand span { color: var(--lime); }
    .tabs { display: flex; gap: 4px; flex-wrap: wrap; }
    .tabs button { background: none; border: 1px solid transparent; color: inherit; padding: 7px 15px; border-radius: 99px; }
    .tabs button[aria-pressed=true] { border-color: var(--lime); color: var(--lime); }
    header .grow { flex: 1; }
    header a { color: rgba(243,244,236,.7); font-size: 13px; }
    .badge-mode { font-size: 12px; padding: 4px 10px; border-radius: 99px; background: rgba(212,255,63,.12); color: var(--lime); white-space: nowrap; }

    main { max-width: 1400px; margin: 0 auto; padding: 28px 28px 40px; }
    section + section { margin-top: 48px; }
    .head { display: flex; flex-wrap: wrap; align-items: end; gap: 16px 24px; margin-bottom: 14px; }
    h1 { font-size: 30px; font-weight: 600; letter-spacing: -.04em; margin: 0; line-height: 1.1; }
    h1 small { font-size: 16px; color: var(--muted); font-weight: 500; }
    h2 { font-size: 22px; font-weight: 600; letter-spacing: -.03em; margin: 0; }
    .field { display: grid; gap: 5px; }
    .field label { font-size: 11px; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); }
    select, input[type=text], input[type=search], textarea { padding: 10px 12px; border: 1px solid var(--line); border-radius: 9px; background: #fff; }
    #case { min-width: 320px; font-weight: 600; }
    #gtitle { min-width: 300px; }
    textarea { min-height: 80px; resize: vertical; width: 100%; }
    .hint { color: var(--muted); font-size: 13.5px; margin: 0 0 16px; }
    .note { background: #fff; border: 1px solid var(--line); border-radius: 12px; padding: 14px 16px; margin: 0 0 16px; display: flex; gap: 14px; align-items: center; flex-wrap: wrap; }
    .note p { margin: 0; flex: 1; min-width: 240px; }

    .gal { display: grid; grid-template-columns: repeat(auto-fill, minmax(210px, 1fr)); gap: 16px; padding: 16px; background: var(--soft); border-radius: 14px; min-height: 160px; }
    .gal-empty { grid-column: 1/-1; align-self: center; text-align: center; color: var(--muted); padding: 34px 10px; }
    .card { position: relative; background: #fff; border-radius: 11px; overflow: hidden; box-shadow: 0 1px 0 rgba(16,47,40,.08); transition: transform 180ms var(--ease), box-shadow 180ms var(--ease), opacity 180ms ease; }
    .card .img { position: relative; aspect-ratio: 4/3; background: #ccd3c4; }
    .gal .card .img { cursor: grab; }
    .card .img img { width: 100%; height: 100%; object-fit: cover; display: block; pointer-events: none; }
    .screens .card .img img { object-fit: contain; background: #e9ece4; }
    .card .no { position: absolute; left: 9px; top: 9px; background: var(--lime); color: var(--forest); font-weight: 800; font-size: 13px; min-width: 26px; text-align: center; padding: 2px 8px; border-radius: 99px; }
    .card .grip { position: absolute; right: 9px; top: 9px; background: rgba(16,47,40,.7); color: #fff; font-size: 11px; padding: 3px 8px; border-radius: 99px; }
    .card .meta { padding: 9px 11px 11px; display: grid; gap: 6px; }
    .card .title { font-weight: 600; font-size: 13.5px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .card .sub { font-size: 12px; color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .card .meta select, .card .meta input { padding: 6px 9px; font-size: 13px; width: 100%; }
    .card .actions { display: flex; gap: 6px; flex-wrap: wrap; }
    .btn { border: 1px solid var(--line); background: #fff; padding: 5px 11px; border-radius: 99px; font-size: 12.5px; }
    .btn:hover:not(:disabled) { border-color: var(--ink); }
    .btn:disabled { opacity: .35; cursor: default; }
    .btn.danger { color: var(--red); }
    .btn.danger:hover { border-color: var(--red); background: #fbeeec; }
    .btn.icon { padding: 5px 10px; }
    .btn.primary { background: var(--forest); color: var(--lime); border-color: var(--forest); }
    .card.dragging { opacity: .35; }
    .card.over { box-shadow: 0 0 0 3px var(--lime); transform: scale(.97); }
    .card.dim { opacity: .5; }
    .card .flag { position: absolute; left: 9px; bottom: 9px; background: rgba(16,47,40,.82); color: #fff; font-size: 11px; padding: 2px 8px; border-radius: 99px; }
    .warn { display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: #e59a2f; margin-left: 6px; vertical-align: middle; }

    .dropzone { display: grid; place-items: center; text-align: center; border: 2px dashed var(--ink); border-radius: 14px; padding: 22px; margin-bottom: 22px; background: #fff; cursor: pointer; transition: background 160ms ease; }
    .dropzone:hover { background: #f6ffd6; }
    .dropzone strong { font-size: 17px; }
    .dropzone span { color: var(--muted); font-size: 13.5px; }
    .tools { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; margin-bottom: 14px; }
    .tools input[type=search] { width: 260px; }
    .pills { display: flex; flex-wrap: wrap; gap: 6px; }
    .pills button { border: 1px solid var(--line); background: none; padding: 6px 12px; border-radius: 99px; font-size: 13px; }
    .pills button[aria-pressed=true] { background: var(--ink); border-color: var(--ink); color: var(--paper); }
    .lib { display: grid; grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); gap: 14px; }
    .lib .card .img { cursor: pointer; }
    .add { width: 100%; border: 0; padding: 8px; font-weight: 700; font-size: 13px; background: var(--forest); color: var(--lime); }
    .add.on { background: var(--lime); color: var(--forest); }
    .lib .card.on { box-shadow: 0 0 0 3px var(--lime); }

    /* projects: order, topics, visibility */
    .rows { display: grid; gap: 10px; }
    .row { display: grid; grid-template-columns: 34px 92px minmax(0, 1fr) auto; gap: 16px; align-items: center; background: #fff; border-radius: 12px; padding: 10px 14px; box-shadow: 0 1px 0 rgba(16,47,40,.08); transition: transform 180ms var(--ease), box-shadow 180ms var(--ease), opacity 180ms ease; }
    .row.dragging { opacity: .35; }
    .row.over { box-shadow: 0 0 0 3px var(--lime); }
    .row.is-hidden { opacity: .55; }
    .row .pos { font-weight: 800; font-size: 13px; background: var(--lime); color: var(--forest); border-radius: 99px; text-align: center; padding: 3px 0; cursor: grab; }
    .row .thumb { width: 92px; aspect-ratio: 4/3; border-radius: 8px; background: #ccd3c4 center/cover no-repeat; }
    .row .name { font-weight: 700; }
    .row .name small { display: block; font-weight: 400; color: var(--muted); font-size: 12.5px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .row .topics { display: flex; gap: 6px; flex-wrap: wrap; margin-top: 8px; align-items: center; }
    .topic { border: 1px solid var(--line); background: none; padding: 4px 10px; border-radius: 99px; font-size: 12.5px; }
    .topic.on { background: var(--soft); border-color: var(--ink); }
    .topic.main { background: var(--forest); color: var(--lime); border-color: var(--forest); }
    .topic-hint { font-size: 11.5px; color: var(--muted); }
    .row .ctl { display: flex; gap: 6px; align-items: center; flex-wrap: wrap; justify-content: end; }
    .switch { display: inline-flex; align-items: center; gap: 7px; font-size: 12.5px; color: var(--muted); }
    .switch input { width: 36px; height: 20px; appearance: none; background: var(--line); border-radius: 99px; position: relative; cursor: pointer; transition: background 160ms ease; }
    .switch input::after { content: ''; position: absolute; left: 3px; top: 3px; width: 14px; height: 14px; border-radius: 50%; background: #fff; transition: transform 160ms var(--ease); }
    .switch input:checked { background: var(--forest); }
    .switch input:checked::after { transform: translateX(16px); }

    .savebar { position: fixed; left: 50%; bottom: 18px; z-index: 30; display: flex; align-items: center; gap: 14px; padding: 10px 12px 10px 20px; border-radius: 99px; background: var(--forest); color: var(--paper); box-shadow: 0 16px 40px rgba(16,47,40,.35); transform: translate(-50%, 160%); transition: transform 260ms var(--ease); max-width: calc(100vw - 32px); }
    .savebar.show { transform: translate(-50%, 0); }
    .savebar .what { font-size: 14px; }
    .savebar button { border: 0; border-radius: 99px; padding: 9px 18px; font-weight: 700; }
    .savebar .discard { background: none; color: rgba(243,244,236,.75); font-weight: 500; }
    .savebar .save { background: var(--lime); color: var(--forest); }
    .savebar .save:disabled { opacity: .5; }

    dialog { border: 0; border-radius: 16px; padding: 0; width: min(760px, 94vw); box-shadow: 0 30px 80px rgba(16,47,40,.35); }
    dialog::backdrop { background: rgba(16,47,40,.55); }
    .dlg { display: grid; grid-template-columns: 1fr 1fr; }
    .dlg img { width: 100%; height: 100%; object-fit: cover; display: block; min-height: 340px; }
    .dlg form { padding: 22px; display: grid; gap: 14px; }
    .dlg .row-btns { display: flex; gap: 8px; align-items: center; margin-top: 4px; }
    .dlg .row-btns .grow { flex: 1; }
    .dlg .ok { border: 0; background: var(--lime); color: var(--forest); font-weight: 700; padding: 9px 18px; border-radius: 99px; }
    .dlg .usage { font-size: 12.5px; color: var(--muted); margin: 0; }

    .toast { position: fixed; top: 70px; left: 50%; transform: translate(-50%, -10px); opacity: 0; background: var(--forest); color: var(--paper); padding: 10px 18px; border-radius: 99px; font-size: 13.5px; transition: transform 220ms var(--ease), opacity 220ms ease; z-index: 50; pointer-events: none; }
    .toast.show { transform: translate(-50%, 0); opacity: 1; }
    .drop-all { position: fixed; inset: 0; z-index: 40; display: none; place-items: center; background: rgba(16,47,40,.86); color: var(--paper); font-size: 24px; font-weight: 600; text-align: center; }
    .drop-all.show { display: grid; }
    .drop-all small { display: block; font-size: 14px; font-weight: 400; opacity: .75; margin-top: 8px; }
    .login { position: fixed; inset: 0; z-index: 60; display: grid; place-items: center; background: var(--forest); color: var(--paper); text-align: center; padding: 24px; }
    .login h1 { font-size: clamp(30px, 4vw, 44px); margin: 14px 0 10px; }
    .login p { max-width: 46ch; margin: 0 auto 22px; color: rgba(243,244,236,.75); }
    .login a { display: inline-block; background: var(--lime); color: var(--forest); font-weight: 700; padding: 11px 20px; border-radius: 99px; text-decoration: none; }

    /* which blocks each area shows */
    body[data-mode=case] [data-show]:not([data-show~=case]), body[data-mode=projects] [data-show]:not([data-show~=projects]),
    body[data-mode=archive] [data-show]:not([data-show~=archive]), body[data-mode=home] [data-show]:not([data-show~=home]) { display: none !important; }
    @media (max-width: 760px) { .row { grid-template-columns: 30px 64px minmax(0, 1fr); } .row .thumb { width: 64px; } .row .ctl { grid-column: 1/-1; justify-content: start; } }
    @media (prefers-reduced-motion: reduce) { .card, .row, .savebar, .toast { transition: none; } }
  </style>
</head>
<body data-mode="case">
  <header>
    <div class="brand">dcentral<span>.</span> Editor</div>
    <nav class="tabs" aria-label="Bereich">
      <button type="button" data-mode="case" aria-pressed="true">Galerie &amp; Screens</button>
      <button type="button" data-mode="projects" aria-pressed="false">Projekte</button>
      <button type="button" data-mode="archive" aria-pressed="false">Fotografie-Seite</button>
      <button type="button" data-mode="home" aria-pressed="false">Startseite</button>
    </nav>
    <div class="grow"></div>
    <span class="badge-mode" id="modebadge"></span>
    <a href="/keystatic" target="_blank" rel="noopener">Keystatic</a>
  </header>

  <main>
    <!-- PROJECTS: order, topics, visibility -->
    <section data-show="projects" aria-labelledby="p-h">
      <div class="head"><h1 id="p-h">Projekte <small id="pcount"></small></h1></div>
      <p class="hint">Die Reihenfolge gilt für die Startseite („Was daraus entsteht“) und für jede Themenseite. Ziehen an der Nummer oder ‹ › ändert sie. Themen per Klick zuordnen – das <b>dunkle</b> Thema ist das Hauptthema (Klick auf ein aktives Thema macht es zum Hauptthema, zweiter Klick entfernt es). <b>Sichtbar</b> aus = Projekt erscheint in keiner Liste, die Seite bleibt erreichbar.</p>
      <div class="rows" id="rows"></div>
    </section>

    <!-- GALLERY (case) / ARCHIVE / HOME: an ordered photo selection -->
    <section data-show="case archive home" aria-labelledby="g-h">
      <div class="head" data-show="case">
        <div class="field"><label for="case">Projekt</label><select id="case"></select></div>
        <div class="field"><label for="gtitle">Überschrift über der Galerie</label><input id="gtitle" type="text" placeholder="z. B. Aus der Bildwelt" /></div>
      </div>
      <div class="head">
        <h1 id="g-h"><span data-show="case">Galerie</span><span data-show="archive">Fotografie-Seite · „Aus dem Archiv.“</span><span data-show="home">Startseite · „Bilder, die bleiben.“</span> <small id="count"></small></h1>
      </div>
      <p class="hint" data-show="case">Die Fotos aus der Bibliothek, wie sie auf der Projektseite erscheinen. Reihenfolge per Ziehen oder ‹ ›. <b>Entfernen</b> nimmt ein Foto nur aus dieser Galerie.</p>
      <p class="hint" data-show="archive">Diese Fotos zeigt die Seite <a href="/fotografie" target="_blank">/fotografie</a>, in dieser Reihenfolge. Die Filter dort entstehen automatisch aus den Serien.</p>
      <p class="hint" data-show="home">Die Startseite zeigt die ersten 7 Fotos in dieser Reihenfolge.</p>
      <div class="note" id="autonote" hidden>
        <p><b>Automatisch:</b> Die Fotografie-Seite zeigt derzeit einfach alle <span id="autocount"></span> Fotos der Bibliothek. Willst du auswählen und sortieren, übernimm sie als eigene Liste.</p>
        <button type="button" class="btn primary" id="takeover">Auswahl selbst festlegen</button>
      </div>
      <div class="note" id="manualnote" hidden>
        <p>Eigene Auswahl aktiv. Neue Fotos erscheinen erst, wenn du sie hier hinzufügst.</p>
        <button type="button" class="btn" id="backauto">Wieder automatisch alle zeigen</button>
      </div>
      <div class="gal" id="gal"></div>
    </section>

    <!-- SCREENS (case only): screenshots, mockups, posters stored with the project -->
    <section data-show="case" aria-labelledby="s-h" class="screens">
      <div class="head"><h2 id="s-h">Screens &amp; Bilder des Projekts <small id="scount" style="font-size:14px;color:var(--muted);font-weight:500"></small></h2></div>
      <p class="hint">Screenshots, Mockups, Plakate – erscheinen auf der Projektseite unter dem Text. <b>Typ</b> bestimmt die Darstellung: Desktop/Handy im Geräte-Rahmen, Bild (nebeneinander), volle Breite, Plakat (ungeschnitten).</p>
      <div class="gal" id="screens"></div>
      <label class="dropzone" for="sfile" style="margin-top:14px">
        <div><strong>Screens hochladen</strong><br /><span>Klicken und Bilder wählen – landen bei diesem Projekt</span></div>
      </label>
      <input id="sfile" type="file" accept="image/*" multiple hidden />
    </section>

    <!-- ADD PHOTOS -->
    <section data-show="case archive home" aria-labelledby="a-h">
      <div class="head"><h2 id="a-h">Fotos hinzufügen</h2></div>
      <label class="dropzone" for="file">
        <div><strong>Neue Fotos hochladen</strong><br /><span id="dzinfo">Hierher ziehen oder klicken</span></div>
      </label>
      <input id="file" type="file" accept="image/*" multiple hidden />
      <div class="tools">
        <input id="q" type="search" placeholder="Bibliothek durchsuchen …" />
        <div class="pills" id="series"></div>
      </div>
      <div class="lib" id="lib"></div>
    </section>
  </main>

  <div class="savebar" id="savebar" role="region" aria-label="Speichern">
    <span class="what" id="what"></span>
    <button type="button" class="discard" id="discard">Verwerfen</button>
    <button type="button" class="save" id="save">Speichern</button>
  </div>
  <div class="toast" id="toast" role="status"></div>
  <div class="drop-all" id="dropall"><div>Loslassen zum Hochladen<small id="dropinfo"></small></div></div>
  <div class="login" id="login" hidden>
    <div>
      <div class="brand">dcentral<span>.</span> Editor</div>
      <h1>Bitte zuerst anmelden.</h1>
      <p>Der Editor nutzt deine Keystatic-Anmeldung über GitHub. Nur wer im Repository schreiben darf, kann speichern.</p>
      <a href="/keystatic">In Keystatic mit GitHub anmelden</a>
      <p style="margin-top:16px;font-size:13px">Danach diese Seite neu laden.</p>
    </div>
  </div>

  <dialog id="dlg">
    <div class="dlg">
      <img id="dimg" alt="" />
      <form method="dialog">
        <div class="field"><label for="dtitle">Titel</label><input id="dtitle" type="text" /></div>
        <div class="field"><label for="dalt">Bildbeschreibung (Alt-Text)</label><textarea id="dalt" placeholder="Was ist zu sehen? Wichtig für Barrierefreiheit und Google."></textarea></div>
        <div class="field"><label for="dseries">Serie (Filter auf der Fotografie-Seite)</label><input id="dseries" type="text" list="serieslist" /><datalist id="serieslist"></datalist></div>
        <div class="field"><label for="dproject">Gehört zu Projekt</label><select id="dproject"></select></div>
        <p class="usage" id="dusage"></p>
        <div class="row-btns">
          <button type="button" class="btn danger" id="ddelete">Foto löschen …</button>
          <span class="grow"></span>
          <button class="btn" value="cancel">Abbrechen</button>
          <button class="ok" value="save">Übernehmen</button>
        </div>
      </form>
    </div>
  </dialog>

  <script>
    type Photo = { id: string; image: string; thumb?: string; title?: string; alt?: string; series?: string; project?: string | null; featured?: boolean; order?: number; width?: number; height?: number; preview?: string };
    type Screen = { image: string; device: string; caption: string; preview?: string };
    type Case = { id: string; title: string; client: string; year?: number; order: number; discipline: string; also: string[]; hidden: boolean; thumb: string | null; galleryTitle: string; galleryPhotos: string[]; screens: Screen[] };
    type NewPhoto = { id: string; json: Photo; big: string; sm: string };
    type Mode = 'case' | 'projects' | 'archive' | 'home';
    const TOPICS = ['Foto', 'Film & Aerial', 'Web', 'KI'];
    const DEVICES: [string, string][] = [['desktop', 'Desktop (Browser)'], ['mobile', 'Handy'], ['image', 'Bild'], ['wide', 'Volle Breite'], ['poster', 'Plakat / Hochformat']];
    const $ = <T extends HTMLElement = HTMLElement>(s: string) => document.querySelector(s) as T;
    const esc = (s: unknown) => String(s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);

    let cases: Case[] = [], photos: Photo[] = [], byId = new Map<string, Photo>(), archiveList: string[] = [];
    let mode: Mode = 'case', current = '', seriesFilter = 'Alle', query = '';
    let store: 'local' | 'github' = 'local', branch = '', imageBase = '';
    // edits wait here until "Speichern" (online that is one commit)
    let selection: string[] = [], screens: Screen[] = [], rows: Case[] = [], archiveAuto = false;
    let newPhotos = new Map<string, NewPhoto>(), newScreens = new Map<string, string>(), photoEdits: Record<string, Partial<Photo>> = {}, deletes = new Set<string>();
    let base = { sel: '', title: '', screens: '', rows: '', auto: false };
    const src = (p: Photo) => p.preview || imageBase + (p.thumb || p.image);
    const imgSrc = (path: string | null | undefined) => (path ? (/^https?:/.test(path) ? path : imageBase + path) : '');
    const screensKey = () => JSON.stringify(screens.map(({ image, device, caption }) => ({ image, device, caption })));
    const rowsKey = () => JSON.stringify(rows.map((r) => [r.id, r.discipline, r.also, r.hidden]));

    /* ── server ── */
    class LoginNeeded extends Error {}
    async function call(action: string, init?: RequestInit, retry = true): Promise<any> {
      const r = await fetch(`/api/cms/${action}`, init);
      if (r.status === 401) {
        // the GitHub token from Keystatic lasts ~8 h; Keystatic can renew it with its refresh cookie
        if (retry && (await fetch('/api/keystatic/github/refresh-token', { method: 'POST' })).ok) return call(action, init, false);
        throw new LoginNeeded();
      }
      const d = await r.json().catch(() => ({}));
      if (!r.ok) throw new Error(d.error || r.statusText);
      return d;
    }
    const postJson = (action: string, body: unknown) => call(action, { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(body) });
    let toastTimer = 0;
    function toast(msg: string, ms = 2800) { const t = $('#toast'); t.textContent = msg; t.classList.add('show'); clearTimeout(toastTimer); toastTimer = window.setTimeout(() => t.classList.remove('show'), ms); }

    /* ── state ── */
    function changes() {
      const out: string[] = [];
      if (mode === 'projects') { if (rowsKey() !== base.rows) out.push('Projekte geändert'); }
      else {
        if (mode === 'archive' && archiveAuto !== base.auto) out.push(archiveAuto ? 'wieder automatisch' : 'eigene Auswahl');
        else if (selection.join(',') !== base.sel) out.push({ case: 'Galerie geändert', archive: 'Fotografie-Seite geändert', home: 'Startseite geändert' }[mode]);
        if (mode === 'case' && $<HTMLInputElement>('#gtitle').value !== base.title) out.push('Überschrift');
        if (mode === 'case' && screensKey() !== base.screens) out.push('Screens');
      }
      if (newPhotos.size) out.push(`${newPhotos.size} neue${newPhotos.size === 1 ? 's Foto' : ' Fotos'}`);
      const e = Object.keys(photoEdits).length; if (e) out.push(`${e} Foto-Info${e === 1 ? '' : 's'}`);
      if (deletes.size) out.push(`${deletes.size} gelöscht`);
