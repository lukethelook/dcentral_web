---
// Gallery editor (/cms/galerien). Visual, drag & drop editing of project galleries
// and the homepage photo module. Local: writes files; online: commits via GitHub
// with the Keystatic login (see src/cms/api.ts). Same JSON as Keystatic.
import '../styles/fonts.css';
export const prerender = false;
---

<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="robots" content="noindex" />
  <title>Galerien · dcentral CMS</title>
  <!-- global: most of the UI is rendered from JS and would miss Astro's scoped styles -->
  <style is:global>
    :root { --paper:#f3f4ec; --ink:#153e35; --muted:#52685c; --line:#cbd4c6; --soft:#e8ece0; --lime:#d4ff3f; --forest:#102f28; }
    * { box-sizing: border-box; }
    body { margin: 0; background: var(--paper); color: var(--ink); font: 400 14px/1.45 Manrope, system-ui, sans-serif; }
    button, input, select, textarea { font: inherit; color: inherit; }
    header { position: sticky; top: 0; z-index: 20; display: flex; align-items: center; gap: 20px; padding: 14px 24px; background: var(--forest); color: var(--paper); }
    header .brand { font-weight: 800; font-size: 20px; letter-spacing: -.05em; }
    header .brand span { color: var(--lime); }
    header nav { display: flex; gap: 4px; }
    header nav button { background: none; border: 1px solid transparent; color: inherit; padding: 7px 14px; border-radius: 99px; cursor: pointer; }
    header nav button[aria-pressed=true] { border-color: var(--lime); color: var(--lime); }
    header .spacer { flex: 1; }
    header a { color: rgba(243,244,236,.7); font-size: 13px; }
    .status { font-size: 13px; color: rgba(243,244,236,.75); min-width: 120px; text-align: right; }
    .save { background: var(--lime); color: var(--forest); border: 0; font-weight: 700; padding: 9px 18px; border-radius: 99px; cursor: pointer; }
    .save:disabled { opacity: .35; cursor: default; }
    main { display: grid; grid-template-columns: minmax(340px, 34%) 1fr; min-height: calc(100vh - 60px); }
    aside { border-right: 1px solid var(--line); padding: 22px 22px 60px; position: sticky; top: 60px; height: calc(100vh - 60px); overflow: auto; }
    .lib { padding: 22px 24px 60px; }
    label.f { display: block; font-size: 11px; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); margin: 0 0 6px; }
    select, input[type=text], input[type=search], textarea { width: 100%; padding: 9px 11px; border: 1px solid var(--line); border-radius: 8px; background: #fff; }
    textarea { min-height: 70px; resize: vertical; }
    .row { margin-bottom: 16px; }
    .hint { color: var(--muted); font-size: 12.5px; margin: 6px 0 0; }
    h2 { font-size: 15px; font-weight: 700; margin: 22px 0 10px; display: flex; justify-content: space-between; align-items: baseline; }
    h2 small { font-weight: 400; color: var(--muted); }
    .sel { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; min-height: 120px; padding: 8px; border: 1px dashed var(--line); border-radius: 10px; background: var(--soft); }
    .sel:empty::before { content: 'Noch leer – rechts Fotos anklicken oder Bilder hierher ziehen.'; grid-column: 1/-1; align-self: center; text-align: center; color: var(--muted); padding: 30px 10px; }
    .chip { position: relative; aspect-ratio: 4/3; border-radius: 7px; overflow: hidden; background: #ccd3c4; cursor: grab; outline: 2px solid transparent; transition: transform 160ms cubic-bezier(.23,1,.32,1), outline-color 160ms ease; }
    .chip img { width: 100%; height: 100%; object-fit: cover; display: block; pointer-events: none; }
    .chip .no { position: absolute; left: 6px; top: 6px; background: var(--lime); color: var(--forest); font-weight: 800; font-size: 11px; padding: 1px 6px; border-radius: 99px; }
    .chip .x { position: absolute; right: 5px; top: 5px; width: 22px; height: 22px; border-radius: 50%; border: 0; background: rgba(16,47,40,.82); color: #fff; cursor: pointer; line-height: 1; }
    .chip.dragging { opacity: .35; }
    .chip.over { outline-color: var(--lime); transform: scale(.96); }
    .tools { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; margin-bottom: 14px; }
    .tools input[type=search] { max-width: 280px; }
    .pills { display: flex; gap: 6px; flex-wrap: wrap; }
    .pills button { border: 1px solid var(--line); background: none; padding: 6px 12px; border-radius: 99px; cursor: pointer; font-size: 13px; }
    .pills button[aria-pressed=true] { background: var(--ink); border-color: var(--ink); color: var(--paper); }
    .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(170px, 1fr)); gap: 12px; }
    .ph { position: relative; border-radius: 9px; overflow: hidden; background: #ccd3c4; cursor: pointer; aspect-ratio: 4/3; outline: 3px solid transparent; outline-offset: -3px; }
    .ph img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 300ms cubic-bezier(.23,1,.32,1); }
    @media (hover: hover) and (pointer: fine) { .ph:hover img { transform: scale(1.04); } }
    .ph.on { outline-color: var(--lime); }
    .ph .badge { position: absolute; left: 8px; top: 8px; background: var(--lime); color: var(--forest); font-weight: 800; font-size: 12px; padding: 2px 8px; border-radius: 99px; }
    .ph .cap { position: absolute; inset: auto 0 0 0; padding: 22px 9px 7px; background: linear-gradient(transparent, rgba(16,47,40,.85)); color: #fff; font-size: 12px; line-height: 1.3; }
    .ph .cap b { display: block; font-weight: 600; }
    .ph .cap span { opacity: .75; }
    .ph .edit { position: absolute; right: 7px; top: 7px; border: 0; border-radius: 99px; padding: 3px 9px; font-size: 11.5px; background: rgba(243,244,236,.92); color: var(--forest); cursor: pointer; opacity: 0; transition: opacity 160ms ease; }
    .ph:hover .edit, .ph:focus-within .edit { opacity: 1; }
    .ph .warn { position: absolute; right: 7px; bottom: 7px; width: 9px; height: 9px; border-radius: 50%; background: #f4b04a; box-shadow: 0 0 0 2px rgba(16,47,40,.6); }
    .drop { position: fixed; inset: 0; z-index: 40; display: none; place-items: center; background: rgba(16,47,40,.86); color: var(--paper); font-size: 22px; font-weight: 600; letter-spacing: -.02em; }
    .drop.show { display: grid; }
    .drop small { display: block; font-size: 14px; font-weight: 400; opacity: .7; margin-top: 8px; text-align: center; }
    .upload label { border: 1px dashed var(--ink); padding: 8px 14px; border-radius: 99px; cursor: pointer; font-size: 13px; }
    .upload input { display: none; }
    dialog { border: 0; border-radius: 14px; padding: 0; width: min(720px, 94vw); box-shadow: 0 30px 80px rgba(16,47,40,.35); }
    dialog::backdrop { background: rgba(16,47,40,.55); }
    .dlg { display: grid; grid-template-columns: 1fr 1fr; }
    .dlg img { width: 100%; height: 100%; object-fit: cover; display: block; min-height: 320px; }
    .dlg form { padding: 22px; }
    .dlg .btns { display: flex; gap: 8px; justify-content: flex-end; margin-top: 10px; }
    .ghost { background: none; border: 1px solid var(--line); padding: 8px 14px; border-radius: 99px; cursor: pointer; }
    .toast { position: fixed; bottom: 18px; left: 50%; transform: translate(-50%, 20px); opacity: 0; background: var(--forest); color: var(--paper); padding: 10px 18px; border-radius: 99px; font-size: 13px; transition: transform 220ms cubic-bezier(.23,1,.32,1), opacity 220ms ease; z-index: 50; }
    .toast.show { transform: translate(-50%, 0); opacity: 1; }
    .ph .new { position: absolute; left: 8px; bottom: 34px; background: var(--forest); color: var(--lime); font-weight: 700; font-size: 11px; padding: 2px 8px; border-radius: 99px; }
    .hint.mode { margin: -4px 0 10px; color: var(--ink); }
    .login { position: fixed; inset: 0; z-index: 60; display: grid; place-items: center; background: var(--forest); color: var(--paper); text-align: center; padding: 24px; }
    .login[hidden] { display: none; }
    .login .brand { font-weight: 800; font-size: 22px; letter-spacing: -.05em; margin: 0 0 18px; }
    .login .brand span { color: var(--lime); }
    .login h1 { font-weight: 600; font-size: clamp(30px, 4vw, 44px); letter-spacing: -.04em; margin: 0 0 10px; }
    .login p { max-width: 46ch; margin: 0 auto 22px; color: rgba(243,244,236,.75); }
    .login a.save { display: inline-block; text-decoration: none; }
    .login .hint { margin-top: 16px; color: rgba(243,244,236,.55); }
    .home-only, body.home .case-only { display: none; }
    body.home .home-only { display: block; }
    @media (prefers-reduced-motion: reduce) { .chip, .ph img, .toast { transition: none; } }
  </style>
</head>
<body>
  <header>
    <div class="brand">dcentral<span>.</span> Galerien</div>
    <nav>
      <button type="button" data-mode="case" aria-pressed="true">Projekt-Galerien</button>
      <button type="button" data-mode="home" aria-pressed="false">Startseite</button>
    </nav>
    <div class="spacer"></div>
    <a href="/keystatic" target="_blank" rel="noopener">Keystatic öffnen</a>
    <span class="status" id="status"></span>
    <button class="save" id="save" type="button" disabled>Speichern <kbd style="opacity:.6">⌘S</kbd></button>
  </header>

  <main>
    <aside>
      <div class="case-only">
        <div class="row">
          <label class="f" for="case">Projekt</label>
          <select id="case"></select>
        </div>
        <div class="row">
          <label class="f" for="gtitle">Überschrift der Galerie</label>
          <input id="gtitle" type="text" placeholder="z. B. Aus der Fotoserie" />
        </div>
        <h2>Galerie <small id="count"></small></h2>
      </div>
      <div class="home-only">
        <h2>„Bilder, die bleiben.“ <small id="hcount"></small></h2>
        <p class="hint" style="margin-top:-4px">Die Startseite zeigt bis zu 7 Fotos in dieser Reihenfolge.</p>
      </div>
      <div class="sel" id="sel"></div>
      <p class="hint">Ziehen zum Sortieren · Klick öffnet die Details · × entfernt aus der Auswahl (das Foto bleibt in der Bibliothek).</p>
    </aside>

    <section class="lib">
      <div class="tools">
        <input id="q" type="search" placeholder="Fotos suchen …" />
        <div class="pills" id="series"></div>
        <div style="flex:1"></div>
        <div class="upload">
          <label for="file">+ Bilder hochladen</label>
          <input id="file" type="file" accept="image/*" multiple />
        </div>
      </div>
      <p class="hint mode" id="modeinfo"></p>
      <p class="hint" style="margin:-4px 0 14px">Klick auf ein Foto = zur Auswahl hinzufügen / entfernen. Bilder einfach ins Fenster ziehen, um sie hochzuladen. <span style="color:#b97a12">●</span> = Alt-Text fehlt.</p>
      <div class="grid" id="grid"></div>
    </section>
  </main>

  <div class="drop" id="drop"><div>Loslassen zum Hochladen<small id="dropinfo"></small></div></div>
  <div class="toast" id="toast" role="status"></div>
  <div class="login" id="login" hidden>
    <div>
      <p class="brand">dcentral<span>.</span> Galerien</p>
      <h1>Bitte zuerst anmelden.</h1>
      <p>Der Galerie-Editor nutzt deine Keystatic-Anmeldung über GitHub. Nur wer im Repository schreiben darf, kann speichern.</p>
      <a class="save" href="/keystatic">In Keystatic mit GitHub anmelden</a>
      <p class="hint">Danach diese Seite neu laden.</p>
    </div>
  </div>

  <dialog id="dlg">
    <div class="dlg">
      <img id="dimg" alt="" />
      <form method="dialog">
        <div class="row"><label class="f" for="dtitle">Titel</label><input id="dtitle" type="text" /></div>
        <div class="row"><label class="f" for="dalt">Bildbeschreibung (Alt-Text)</label><textarea id="dalt"></textarea></div>
        <div class="row"><label class="f" for="dseries">Serie</label><input id="dseries" type="text" list="serieslist" /><datalist id="serieslist"></datalist></div>
        <div class="row"><label class="f" for="dproject">Gehört zu Projekt</label><select id="dproject"></select></div>
        <p class="hint" id="dmeta"></p>
        <div class="btns"><button class="ghost" value="cancel">Abbrechen</button><button class="save" value="save">Übernehmen</button></div>
      </form>
    </div>
  </dialog>

  <script>
    type Photo = { id: string; image: string; thumb?: string; title?: string; alt?: string; series?: string; project?: string | null; featured?: boolean; order?: number; width?: number; height?: number; preview?: string };
    type Case = { id: string; title: string; client: string; galleryTitle: string; galleryPhotos: string[] };
    type NewPhoto = { id: string; json: Photo; big: string; sm: string };
    const $ = <T extends HTMLElement = HTMLElement>(s: string) => document.querySelector(s) as T;
    let cases: Case[] = [], photos: Photo[] = [], byId = new Map<string, Photo>();
    let mode: 'case' | 'home' = 'case', current = '', selection: string[] = [], dirty = false, seriesFilter = 'Alle', query = '';
    let store: 'local' | 'github' = 'local', branch = '', imageBase = '';
    // everything waits here until "Speichern" (online that is one commit)
    let newPhotos = new Map<string, NewPhoto>(), photoEdits: Record<string, Partial<Photo>> = {};
    const esc = (s: unknown) => String(s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
    const src = (p: Photo) => p.preview || imageBase + (p.thumb || p.image);

    class LoginNeeded extends Error {}
    async function call(action: string, init?: RequestInit, retry = true): Promise<any> {
      const r = await fetch(`/api/cms/${action}`, init);
      if (r.status === 401) {
        // the GitHub token from Keystatic lasts ~8 h; Keystatic can renew it with its refresh cookie
        if (retry && (await fetch('/api/keystatic/github/refresh-token', { method: 'POST' })).ok) return call(action, init, false);
        throw new LoginNeeded();
      }
      const d = await r.json();
      if (!r.ok) throw new Error(d.error || r.statusText);
      return d;
    }
    const postJson = (action: string, body: unknown) => call(action, { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(body) });

    let toastTimer = 0;
    function toast(msg: string, ms = 2600) { const t = $('#toast'); t.textContent = msg; t.classList.add('show'); clearTimeout(toastTimer); toastTimer = window.setTimeout(() => t.classList.remove('show'), ms); }
    function setDirty(v: boolean) {
      dirty = v; $<HTMLButtonElement>('#save').disabled = !v;
      $('#status').textContent = v ? 'Nicht gespeichert' : store === 'github' ? `Online · ${branch}` : 'Lokal';
    }
    function showLogin() { $('#login').hidden = false; }

    async function load() {
      let s;
      try { s = await call('state'); } catch (e) { if (e instanceof LoginNeeded) return showLogin(); throw e; }
      store = s.mode; branch = s.branch || ''; imageBase = s.imageBase || '';
      $('#modeinfo').textContent = store === 'github'
        ? `Online-Modus: Speichern erzeugt einen Commit auf „${branch}“. Die Website zeigt es nach dem nächsten Vercel-Build (ca. 1–2 Minuten).`
        : 'Lokaler Modus: Speichern schreibt direkt in die Projektdateien.';
      cases = s.cases; photos = s.photos; byId = new Map(photos.map((p: Photo) => [p.id, p]));
      newPhotos = new Map(); photoEdits = {};
      $('#case').innerHTML = cases.map((c) => `<option value="${c.id}">${esc(c.client)} — ${esc(c.title)}</option>`).join('');
      $('#dproject').innerHTML = '<option value="">– keinem –</option>' + cases.map((c) => `<option value="${c.id}">${esc(c.client)}</option>`).join('');
      const wanted = new URLSearchParams(location.search).get('projekt');
      current = cases.some((c) => c.id === wanted) ? wanted! : cases.some((c) => c.id === current) ? current : cases[0]?.id || '';
      $<HTMLSelectElement>('#case').value = current;
      $('#serieslist').innerHTML = [...new Set(photos.map((p) => p.series).filter(Boolean))].map((x) => `<option value="${esc(x)}">`).join('');
      pick();
    }
    function pick() {
      if (mode === 'case') {
        const c = cases.find((x) => x.id === current)!;
        selection = c.galleryPhotos.filter((id) => byId.has(id));
        $<HTMLInputElement>('#gtitle').value = c.galleryTitle || '';
      } else selection = photos.filter((p) => p.featured).sort((a, b) => (a.order ?? 0) - (b.order ?? 0)).map((p) => p.id);
      setDirty(newPhotos.size > 0 || Object.keys(photoEdits).length > 0); render();
    }

    function renderSeries() {
      const all = ['Alle', ...(mode === 'case' ? ['Dieses Projekt'] : []), ...new Set(photos.map((p) => p.series || 'Fotografie'))];
      $('#series').innerHTML = all.map((x) => `<button type="button" aria-pressed="${x === seriesFilter}" data-s="${esc(x)}">${esc(x)}</button>`).join('');
    }
    function visible() {
      const q = query.toLowerCase();
      return photos.filter((p) => {
        if (seriesFilter === 'Dieses Projekt' ? p.project !== current : seriesFilter !== 'Alle' && (p.series || 'Fotografie') !== seriesFilter) return false;
        return !q || [p.id, p.title, p.alt, p.series].join(' ').toLowerCase().includes(q);
      });
    }
    function render() {
      renderSeries();
      $('#sel').innerHTML = selection.map((id, i) => {
        const p = byId.get(id)!;
        return `<div class="chip" draggable="true" data-id="${id}" title="${esc(p.title || id)}"><img src="${src(p)}" alt="" loading="lazy"><span class="no">${i + 1}</span><button class="x" type="button" data-x="${id}" aria-label="Aus der Auswahl entfernen">×</button></div>`;
      }).join('');
      $('#count').textContent = `${selection.length} ${selection.length === 1 ? 'Foto' : 'Fotos'}`;
      $('#hcount').textContent = `${selection.length} gewählt${selection.length > 7 ? ' · nur 7 sichtbar' : ''}`;
      $('#grid').innerHTML = visible().map((p) => {
        const at = selection.indexOf(p.id), fresh = newPhotos.has(p.id);
        return `<div class="ph${at >= 0 ? ' on' : ''}" data-id="${p.id}" tabindex="0" role="button" aria-pressed="${at >= 0}" aria-label="${esc(p.title || p.id)}">${at >= 0 ? `<span class="badge">${at + 1}</span>` : ''}${fresh ? '<span class="new">neu</span>' : ''}<img src="${src(p)}" alt="" loading="lazy"><button class="edit" type="button" data-edit="${p.id}">Bearbeiten</button>${p.alt ? '' : '<span class="warn" title="Alt-Text fehlt"></span>'}<div class="cap"><b>${esc(p.title || p.id)}</b><span>${esc(p.series)}</span></div></div>`;
      }).join('');
    }
    function toggle(id: string) { const i = selection.indexOf(id); if (i >= 0) selection.splice(i, 1); else selection.push(id); setDirty(true); render(); }

    async function save() {
      if (!dirty) return;
      $('#status').textContent = store === 'github' ? 'Speichert auf GitHub …' : 'Speichert …';
      $<HTMLButtonElement>('#save').disabled = true;
      try {
        // keep each request under Vercel's 4.5 MB body limit: big uploads go first in their own commits
        const pending = [...newPhotos.values()];
        const size = (n: NewPhoto) => n.big.length + n.sm.length;
        const chunks: NewPhoto[][] = [[]]; let used = 0;
        for (const n of pending) { if (used + size(n) > 3_200_000 && chunks.at(-1)!.length) { chunks.push([]); used = 0; } chunks.at(-1)!.push(n); used += size(n); }
        for (const chunk of chunks.slice(0, -1)) await postJson('save', { kind: 'files', newPhotos: chunk });
        const base = { photoEdits, newPhotos: chunks.at(-1), photos: selection };
        if (mode === 'case') await postJson('save', { ...base, kind: 'gallery', case: current, galleryTitle: $<HTMLInputElement>('#gtitle').value });
        else await postJson('save', { ...base, kind: 'home' });
        if (mode === 'case') { const c = cases.find((x) => x.id === current)!; c.galleryPhotos = [...selection]; c.galleryTitle = $<HTMLInputElement>('#gtitle').value; }
        else photos.forEach((p) => { const at = selection.indexOf(p.id); p.featured = at >= 0; if (at >= 0) p.order = at; });
        newPhotos = new Map(); photoEdits = {};
        setDirty(false);
        toast(store === 'github' ? 'Gespeichert – auf der Website in ca. 1–2 Minuten sichtbar.' : 'Gespeichert.', 3600);
      } catch (e) {
        setDirty(true);
        if (e instanceof LoginNeeded) { showLogin(); return; }
        $('#status').textContent = 'Fehler beim Speichern'; toast(String((e as Error).message), 6000);
      }
    }

    // downscale in the browser first (EXIF-rotated), so even 20 MB camera files fit through
    async function shrink(file: File): Promise<Blob> {
      try {
        const bmp = await createImageBitmap(file);
        const k = Math.min(1, 2400 / Math.max(bmp.width, bmp.height));
        const c = document.createElement('canvas'); c.width = Math.round(bmp.width * k); c.height = Math.round(bmp.height * k);
        c.getContext('2d')!.drawImage(bmp, 0, 0, c.width, c.height);
        return await new Promise((res) => c.toBlob((b) => res(b || file), 'image/jpeg', 0.92));
      } catch { return file; }
    }
    async function upload(files: FileList | File[]) {
      const list = [...files].filter((f) => f.type.startsWith('image/'));
      if (!list.length) return;
      const c = cases.find((x) => x.id === current);
      let done = 0;
      for (const f of list) {
        $('#status').textContent = `Bereitet Bild ${++done} von ${list.length} vor …`;
        try {
          const form = new FormData();
          form.append('file', await shrink(f), f.name.replace(/\.[^.]+$/, '') + '.jpg');
          form.append('name', f.name);
          form.append('series', mode === 'case' && c ? c.client : 'Fotografie');
          if (mode === 'case' && c) form.append('project', c.id);
          form.append('taken', [...byId.keys()].join(','));
          const r = await call('process', { method: 'POST', body: form });
          const p: Photo = { id: r.id, ...r.json, preview: `data:image/webp;base64,${r.sm}` };
          newPhotos.set(r.id, { id: r.id, json: r.json, big: r.big, sm: r.sm });
          photos.push(p); byId.set(p.id, p); selection.push(p.id);
          render();
        } catch (e) {
          if (e instanceof LoginNeeded) { showLogin(); return; }
          toast(`${f.name}: ${(e as Error).message}`, 5000);
        }
      }
      setDirty(true);
      toast(`${list.length} ${list.length === 1 ? 'Bild' : 'Bilder'} bereit – Alt-Texte ergänzen, dann speichern.`, 4000);
    }

    // ── events ──
    $('#case').addEventListener('change', () => {
      const next = $<HTMLSelectElement>('#case').value;
      if (dirty && !confirm('Ungespeicherte Änderungen verwerfen?')) { $<HTMLSelectElement>('#case').value = current; return; }
      if (dirty) { newPhotos.forEach((_, id) => { byId.delete(id); }); photos = photos.filter((p) => !newPhotos.has(p.id)); newPhotos = new Map(); photoEdits = {}; }
      current = next; seriesFilter = 'Alle'; history.replaceState(null, '', `?projekt=${current}`); pick();
    });
    $('#gtitle').addEventListener('input', () => setDirty(true));
    document.querySelectorAll<HTMLButtonElement>('[data-mode]').forEach((b) => b.addEventListener('click', () => {
      if (b.dataset.mode === mode) return;
      if (dirty && !confirm('Ungespeicherte Änderungen verwerfen?')) return;
      if (dirty) { photos = photos.filter((p) => !newPhotos.has(p.id)); newPhotos.forEach((_, id) => byId.delete(id)); newPhotos = new Map(); photoEdits = {}; }
      mode = b.dataset.mode as 'case' | 'home'; document.body.classList.toggle('home', mode === 'home');
      document.querySelectorAll('[data-mode]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      seriesFilter = 'Alle'; pick();
    }));
    $('#q').addEventListener('input', () => { query = $<HTMLInputElement>('#q').value; render(); });
    $('#series').addEventListener('click', (e) => { const b = (e.target as HTMLElement).closest('button'); if (b) { seriesFilter = b.dataset.s!; render(); } });
    $('#grid').addEventListener('click', (e) => {
      const t = e.target as HTMLElement, edit = t.closest<HTMLElement>('[data-edit]');
      if (edit) { openEdit(edit.dataset.edit!); return; }
      const ph = t.closest<HTMLElement>('.ph'); if (ph) toggle(ph.dataset.id!);
    });
    $('#grid').addEventListener('keydown', (e) => { const ph = (e.target as HTMLElement).closest<HTMLElement>('.ph'); if (ph && (e.key === 'Enter' || e.key === ' ')) { e.preventDefault(); toggle(ph.dataset.id!); } });
    $('#sel').addEventListener('click', (e) => {
      const x = (e.target as HTMLElement).closest<HTMLElement>('[data-x]');
      if (x) { toggle(x.dataset.x!); return; }
      const c = (e.target as HTMLElement).closest<HTMLElement>('.chip'); if (c) openEdit(c.dataset.id!);
    });
    $('#save').addEventListener('click', save);
    addEventListener('keydown', (e) => { if ((e.metaKey || e.ctrlKey) && e.key === 's') { e.preventDefault(); save(); } });
    addEventListener('beforeunload', (e) => { if (dirty) e.preventDefault(); });
    $<HTMLInputElement>('#file').addEventListener('change', () => { const input = $<HTMLInputElement>('#file'); if (input.files) upload([...input.files]); input.value = ''; });

    // reorder inside the selection (HTML5 drag & drop)
    let dragId: string | null = null;
    const sel = $('#sel');
    sel.addEventListener('dragstart', (e) => { const c = (e.target as HTMLElement).closest<HTMLElement>('.chip'); if (!c) return; dragId = c.dataset.id!; c.classList.add('dragging'); e.dataTransfer!.effectAllowed = 'move'; e.dataTransfer!.setData('text/plain', dragId); });
    sel.addEventListener('dragend', () => { dragId = null; document.querySelectorAll('.chip').forEach((c) => c.classList.remove('dragging', 'over')); });
    sel.addEventListener('dragover', (e) => { if (!dragId) return; e.preventDefault(); const c = (e.target as HTMLElement).closest<HTMLElement>('.chip'); document.querySelectorAll('.chip.over').forEach((x) => x !== c && x.classList.remove('over')); c?.classList.add('over'); });
    sel.addEventListener('drop', (e) => {
      if (!dragId) return; e.preventDefault(); e.stopPropagation();
      const c = (e.target as HTMLElement).closest<HTMLElement>('.chip'), from = selection.indexOf(dragId);
      const to = c ? selection.indexOf(c.dataset.id!) : selection.length - 1;
      if (from >= 0 && to >= 0 && from !== to) { selection.splice(to, 0, selection.splice(from, 1)[0]); setDirty(true); render(); }
    });

    // files dragged in from Finder → upload
    let depth = 0; const drop = $('#drop');
    const hasFiles = (e: DragEvent) => [...(e.dataTransfer?.types || [])].includes('Files');
    addEventListener('dragenter', (e) => {
      if (!hasFiles(e)) return; depth++;
      const c = cases.find((x) => x.id === current);
      $('#dropinfo').textContent = mode === 'case' && c ? `Neue Fotos für ${c.client} (Serie „${c.client}“)` : 'Neue Fotos für die Bibliothek';
      drop.classList.add('show');
    });
    addEventListener('dragleave', (e) => { if (!hasFiles(e)) return; if (--depth <= 0) { depth = 0; drop.classList.remove('show'); } });
    addEventListener('dragover', (e) => { if (hasFiles(e)) e.preventDefault(); });
    addEventListener('drop', (e) => { if (!hasFiles(e)) return; e.preventDefault(); depth = 0; drop.classList.remove('show'); upload([...e.dataTransfer!.files]); });

    // photo details: collected and saved together with the gallery
    let editing = '';
    function openEdit(id: string) {
      const p = byId.get(id)!; editing = id;
      $<HTMLImageElement>('#dimg').src = src(p);
      $<HTMLInputElement>('#dtitle').value = p.title || '';
      $<HTMLTextAreaElement>('#dalt').value = p.alt || '';
      $<HTMLInputElement>('#dseries').value = p.series || '';
      $<HTMLSelectElement>('#dproject').value = p.project || '';
      $('#dmeta').textContent = `${id} · ${p.width ?? '?'} × ${p.height ?? '?'} px`;
      $<HTMLDialogElement>('#dlg').showModal();
    }
    $('#dlg').addEventListener('close', () => {
      if ($<HTMLDialogElement>('#dlg').returnValue !== 'save' || !editing) return;
      const edit = { title: $<HTMLInputElement>('#dtitle').value, alt: $<HTMLTextAreaElement>('#dalt').value, series: $<HTMLInputElement>('#dseries').value, project: $<HTMLSelectElement>('#dproject').value || null };
      const p = byId.get(editing)!; Object.assign(p, edit);
      const fresh = newPhotos.get(editing);
      if (fresh) Object.assign(fresh.json, edit); else photoEdits[editing] = { ...(photoEdits[editing] || {}), ...edit };
      setDirty(true); render();
    });

    load();
  </script>
</body>
</html>
