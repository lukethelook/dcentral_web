---
import c from '../content/site/contact.json';
import { hl } from '../lib/text';

interface Props { home?: boolean }
const { home = false } = Astro.props;
const top = home ? '#top' : '/';
const year = new Date().getFullYear();
const arrow = 'M6 18 18 6M6 6h12v12';
---

<footer class="contact" id="kontakt">
  <div class="shell">
    <div class="section-rail">
      <span>{c.eyebrow}</span>
      <a aria-label="Zum Seitenanfang" href={top}>
        <svg aria-hidden="true" viewBox="0 0 24 24"><path d={arrow}></path></svg>
      </a>
    </div>
    <h2 set:html={hl(c.headline)} />
    <a class="contact-mail magnetic" href={`mailto:${c.email}`}>
      {c.email}
      <svg aria-hidden="true" viewBox="0 0 24 24"><path d={arrow}></path></svg>
    </a>
    <div class="contact-grid">
      <div>
        <span>Direkt</span>
        <a href={`tel:${c.phoneHref.replace(/\s+/g, '')}`}>{c.phone}</a>
        <a href={`mailto:${c.email}`}>{c.email}</a>
        {c.social.map((s: { label: string; href: string }) => <a href={s.href} rel="me noopener" target="_blank">{s.label}</a>)}
      </div>
      <div>
        <span>Vor Ort</span>
        <p set:html={c.location.join('<br />')} />
      </div>
      <div>
        <span>Antwort</span>
        <p set:html={c.response.map((r) => r.replace(/</g, '&lt;')).join('<br />')} />
      </div>
    </div>
    <div class="footer-base">
      <a class="brand" href={top}>dcentral<span>.</span></a>
      <span>© {year} · {c.name} · Foto · Film · Web · KI</span>
      <div>
        <a href="/impressum">Impressum</a>
        <a href="/datenschutz">Datenschutz</a>
        <a href="/bildnachweis">Bildnachweis</a>
      </div>
    </div>
  </div>
</footer>
