---
import a from '../content/site/accelerator.json';
import { hl } from '../lib/text';
---

<section class="impact section" id="impact">
  <div class="shell">
    <div class="impact-grid">
      <div>
        <h2 set:html={hl(a.title)} />
        <p class="impact-lead">{a.lead}</p>
        <ul class="tags causes">{a.causes.map((c) => <li>{c}</li>)}</ul>
        <a class="action magnetic" href={a.ctaHref} data-contact="purpose">
          {a.ctaLabel}
          <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M6 18 18 6M6 6h12v12"></path></svg>
        </a>
      </div>
      <div class="impact-offers">
        <h3>{a.offerTitle}</h3>
        {a.offer.map((o) => (
          <div>
            <h4>{o.t}</h4>
            <p>{o.d}</p>
          </div>
        ))}
      </div>
    </div>
    <ol class="impact-steps">
      {a.steps.map((s) => (
        <li>
          <span>{s.no}</span>
          <h3>{s.t}</h3>
          <p>{s.d}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
