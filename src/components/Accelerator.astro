---
import data from '../content/site/accelerator.json';
import { hl } from '../lib/text';
---

<section class="acc" id="impact">
  <div class="shell shell--wide acc__head">
    <p class="eyebrow" data-st>[ 03 ] {data.eyebrow}</p>
    <h2 class="acc__title display" data-st set:html={hl(data.title)}></h2>
    <p class="acc__lead" data-st>{data.lead}</p>
    <ul class="acc__causes" data-st aria-label="Themenfelder">
      {data.causes.map((c) => <li>{c}</li>)}
    </ul>
  </div>

  <div class="shell shell--wide acc__grid">
    <div class="acc__viz" data-st>
      <canvas id="acc-canvas" aria-hidden="true"></canvas>
      <span class="acc__viz-note meta" aria-hidden="true">// skills rein · wirkung raus</span>
    </div>

    <div class="acc__copy">
      <h3 class="acc__sub" data-st>Was ich einbringe</h3>
      <ul class="acc__offer">
        {data.offer.map((o) => (
          <li data-st><span class="acc__offer-t">{o.t}</span><span class="acc__offer-d">{o.d}</span></li>
        ))}
      </ul>
      <a href={data.ctaHref} class="btn btn--signal acc__cta" data-st data-magnetic>
        <span>{data.ctaLabel}</span>
        <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
    </div>
  </div>

  <div class="shell shell--wide">
    <hr class="rule" />
    <ol class="acc__steps">
      {data.steps.map((s) => (
        <li class="acc__step" data-st>
          <span class="acc__step-no meta">{s.no}</span>
          <h4 class="acc__step-t">{s.t}</h4>
          <p class="acc__step-d">{s.d}</p>
        </li>
      ))}
    </ol>
  </div>

  <script type="application/json" id="acc-data" set:html={JSON.stringify(data.causes)}></script>
</section>

<style>
  .acc { padding-block: var(--section-y); position: relative; overflow: hidden; }
  .acc::before {
    content: ""; position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background: radial-gradient(60% 60% at 50% 30%, color-mix(in srgb, var(--color-signal) 7%, transparent), transparent 70%);
  }
  .acc__head { text-align: center; }
  .acc__head .eyebrow { justify-content: center; }
  .acc__title { font-size: var(--step-4); margin: 1rem 0 1.2rem; }
  .acc__title em { font-style: normal; color: var(--color-signal); }
  .acc__lead { margin: 0 auto; max-width: 56ch; font-size: var(--step-1); line-height: 1.6; color: var(--color-paper); }
  .acc__causes { list-style: none; display: flex; flex-wrap: wrap; justify-content: center; gap: 0.5rem; padding: 0; margin: 1.6rem 0 0; }
  .acc__causes li {
    font-family: var(--font-mono); font-size: var(--step--1); text-transform: uppercase; letter-spacing: 0.04em;
    padding: 0.4rem 0.85rem; border: 1px solid var(--color-line); color: var(--color-ash);
  }

  .acc__grid {
    display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2.4rem, 5vw, 5rem);
    align-items: center; margin-top: clamp(2.6rem, 6vw, 4.5rem);
  }
  .acc__viz { position: relative; aspect-ratio: 1 / 1; border: 1px solid var(--color-line); }
  #acc-canvas { width: 100%; height: 100%; display: block; }
  .acc__viz-note { position: absolute; bottom: 0.8rem; left: 0.8rem; }

  .acc__sub { font-family: var(--font-mono); font-size: var(--step--1); text-transform: uppercase; letter-spacing: 0.12em; color: var(--color-signal); margin: 0 0 1.4rem; font-weight: 400; }
  .acc__offer { list-style: none; padding: 0; margin: 0 0 2rem; display: grid; grid-template-columns: 1fr 1fr; gap: 1.4rem 1.6rem; }
  .acc__offer li { display: flex; flex-direction: column; gap: 0.3rem; border-top: 1px solid var(--color-line); padding-top: 0.9rem; }
  .acc__offer-t { font-family: var(--font-display); font-variation-settings: "wght" 640, "wdth" 105; text-transform: uppercase; font-size: var(--step-1); letter-spacing: -0.01em; }
  .acc__offer-d { color: var(--color-ash); font-size: var(--step-0); }
  .acc__cta { margin-top: 0.4rem; }

  .acc__steps { list-style: none; margin: clamp(2.4rem, 5vw, 3.4rem) 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(1.4rem, 3vw, 2.4rem); }
  .acc__step-no { color: var(--color-signal); }
  .acc__step-t { font-family: var(--font-display); font-variation-settings: "wght" 640, "wdth" 105; text-transform: uppercase; font-size: var(--step-1); margin: 0.5rem 0 0.5rem; }
  .acc__step-d { margin: 0; color: var(--color-ash); font-size: var(--step-0); line-height: 1.5; }

  @media (max-width: 860px) {
    .acc__grid { grid-template-columns: 1fr; }
    .acc__viz { max-width: 460px; margin-inline: auto; width: 100%; }
    .acc__steps { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) { .acc__offer { grid-template-columns: 1fr; } }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { prefersReducedMotion, registerGsap, whenVisible, magnetic } from '../lib/motion';

  document.querySelectorAll<HTMLElement>('#impact [data-magnetic]').forEach((el) => magnetic(el, 0.3));

  if (!prefersReducedMotion) {
    registerGsap();
    gsap.from('#impact [data-st]', { y: 28, opacity: 0, duration: 0.9, ease: 'expo.out', stagger: 0.06, scrollTrigger: { trigger: '#impact', start: 'top 72%' } });
  }

  /* ── Impact Core: causes feed energy into a central core that amplifies it
        back out as rings (skills in → impact out). ── */
  const canvas = document.getElementById('acc-canvas') as HTMLCanvasElement | null;
  const dataEl = document.getElementById('acc-data');
  if (canvas && dataEl) {
    const causes: string[] = JSON.parse(dataEl.textContent || '[]');
    const ctx = canvas.getContext('2d')!;
    const SIGNAL = '194,242,61', PAPER = '244,244,240', ASH = '138,138,133';
    let W = 0, H = 0, cx = 0, cy = 0, R = 0;

    type Feed = { ax: number; ay: number; label: string; particles: { t: number; speed: number }[]; phase: number };
    let feeds: Feed[] = [];
    const rings: { r: number; max: number }[] = [];

    const build = () => {
      const rect = canvas.getBoundingClientRect();
      W = rect.width; H = rect.height; cx = W / 2; cy = H / 2; R = Math.min(W, H) * 0.4;
      const dpr = Math.min(window.devicePixelRatio, 2);
      canvas.width = W * dpr; canvas.height = H * dpr; ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      feeds = causes.map((label, i) => {
        const a = (i / causes.length) * Math.PI * 2 - Math.PI / 2;
        const particles = Array.from({ length: 3 }, (_, k) => ({ t: k / 3 + Math.random() * 0.2, speed: 0.004 + Math.random() * 0.004 }));
        return { ax: cx + Math.cos(a) * R, ay: cy + Math.sin(a) * R, label, particles, phase: a };
      });
    };
    build();
    addEventListener('resize', build);

    const mouse = { x: -9999, y: -9999 };
    canvas.addEventListener('pointermove', (e) => { const r = canvas.getBoundingClientRect(); mouse.x = e.clientX - r.left; mouse.y = e.clientY - r.top; });
    canvas.addEventListener('pointerleave', () => { mouse.x = -9999; mouse.y = -9999; });

    let t = 0, running = false, ringTimer = 0;
    const hexA = (rgb: string, a: number) => `rgba(${rgb},${a})`;

    const draw = () => {
      t += 0.006; ctx.clearRect(0, 0, W, H);

      // feeds: faint line + flowing particles toward core
      ctx.lineCap = 'round';
      for (const f of feeds) {
        const near = Math.max(0, 1 - Math.hypot(mouse.x - f.ax, mouse.y - f.ay) / 130);
        ctx.strokeStyle = hexA(ASH, 0.14 + near * 0.25); ctx.lineWidth = 0.6;
        ctx.beginPath(); ctx.moveTo(f.ax, f.ay); ctx.lineTo(cx, cy); ctx.stroke();

        ctx.globalCompositeOperation = 'lighter';
        for (const p of f.particles) {
          p.t += p.speed * (1 + near * 2.5);
          if (p.t > 1) p.t -= 1 + Math.random() * 0.15;
          const x = f.ax + (cx - f.ax) * p.t, y = f.ay + (cy - f.ay) * p.t;
          const fade = Math.min(1, p.t * 1.6); // brighter near the core
          const sz = (1.6 + near * 1.6) * 4;
          const g = ctx.createRadialGradient(x, y, 0, x, y, sz);
          g.addColorStop(0, hexA(SIGNAL, 0.9 * fade)); g.addColorStop(1, hexA(SIGNAL, 0));
          ctx.fillStyle = g; ctx.beginPath(); ctx.arc(x, y, sz, 0, Math.PI * 2); ctx.fill();
        }
        ctx.globalCompositeOperation = 'source-over';

        // node + label
        ctx.fillStyle = hexA(PAPER, 0.7 + near * 0.3);
        ctx.beginPath(); ctx.arc(f.ax, f.ay, 3 + near * 1.5, 0, Math.PI * 2); ctx.fill();
        ctx.font = '10px "JetBrains Mono", monospace'; ctx.textAlign = 'center';
        ctx.fillStyle = near > 0.3 ? `rgb(${SIGNAL})` : hexA(ASH, 0.7);
        const ox = f.ax + (f.ax - cx) * 0.08, oy = f.ay + (f.ay - cy) * 0.08;
        ctx.fillText(f.label.toUpperCase(), ox, oy + (f.ay < cy ? -8 : 16));
      }

      // core: emitted rings (impact out) + breathing glow
      ctx.globalCompositeOperation = 'lighter';
      ringTimer += 1;
      if (ringTimer > 52) { ringTimer = 0; rings.push({ r: 12, max: R * 1.05 }); }
      for (let i = rings.length - 1; i >= 0; i--) {
        const ring = rings[i]; ring.r += 1.3;
        const a = Math.max(0, 1 - ring.r / ring.max);
        ctx.strokeStyle = hexA(SIGNAL, a * 0.45); ctx.lineWidth = 1;
        ctx.beginPath(); ctx.arc(cx, cy, ring.r, 0, Math.PI * 2); ctx.stroke();
        if (ring.r >= ring.max) rings.splice(i, 1);
      }
      const breathe = 26 + Math.sin(t * 1.5) * 7;
      const cg = ctx.createRadialGradient(cx, cy, 0, cx, cy, breathe);
      cg.addColorStop(0, hexA(SIGNAL, 0.85)); cg.addColorStop(0.5, hexA(SIGNAL, 0.25)); cg.addColorStop(1, hexA(SIGNAL, 0));
      ctx.fillStyle = cg; ctx.beginPath(); ctx.arc(cx, cy, breathe, 0, Math.PI * 2); ctx.fill();
      ctx.globalCompositeOperation = 'source-over';
      ctx.fillStyle = `rgb(${SIGNAL})`; ctx.beginPath(); ctx.arc(cx, cy, 5, 0, Math.PI * 2); ctx.fill();
      ctx.font = '11px "JetBrains Mono", monospace'; ctx.textAlign = 'center';
      ctx.fillStyle = `rgb(${SIGNAL})`; ctx.fillText('IMPACT', cx, cy + breathe + 16);

      if (running) requestAnimationFrame(draw);
    };
    const start = () => { if (running) return; running = true; draw(); };
    document.addEventListener('visibilitychange', () => { running = !document.hidden; if (running && !prefersReducedMotion) start(); });
    if (prefersReducedMotion) draw(); else whenVisible(canvas, start);
  }
</script>
