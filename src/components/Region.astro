---
import r from '../content/site/region.json';
import { hl } from '../lib/text';
---

<section class="region shell section" id="region">
  <h2 set:html={hl(r.title)} />
  <div class="client-list">{r.clients.map((c) => <span>{c}</span>)}</div>
  <div class="stats">
    {r.stats.map((s) => (
      <div>
        <strong>{s.n}</strong>
        <span>{s.l}</span>
      </div>
    ))}
  </div>
</section>
