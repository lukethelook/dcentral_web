---
import r from '../content/site/region.json';
import { getCollection } from 'astro:content';
import { hl } from '../lib/text';
// Stats may use {projekte} / {fotos}: counted live from the collections, so the
// numbers can never drift from what the site actually shows.
const counts: Record<string, number> = {
  projekte: (await getCollection('cases')).filter((c) => !c.data.previewDummy).length,
  fotos: (await getCollection('photos')).length,
};
const fill = (n: string) => n.replace(/\{(projekte|fotos)\}/g, (_, k) => String(counts[k]));
---

<section class="region shell section" id="region">
  <h2 set:html={hl(r.title)} />
  <div class="client-list">{r.clients.map((c) => <span>{c}</span>)}</div>
  <div class="stats">
    {r.stats.map((s) => (
      <div>
        <strong>{fill(s.n)}</strong>
        <span>{s.l}</span>
      </div>
    ))}
  </div>
</section>
