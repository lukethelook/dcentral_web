---
// Homepage photography module — „Zoom Parallax“ (after the 21st.dev pattern):
// seven featured photos form a collage; as you scroll through the section each
// image scales up at its own rate until the centre photo fills the screen.
// Scroll-linked (never hijacked). Reduced motion: a static collage grid.
import { getCollection } from 'astro:content';

const photos = (await getCollection('photos'))
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 7)
  .map((p) => p.data);
---

{photos.length >= 3 && (
  <section class="pz" id="fotografie" aria-labelledby="pz-title">
    <div class="pz-intro shell">
      <p class="pz-eyebrow"><span></span>Fotografie</p>
      <h2 id="pz-title">Bilder, die <em>bleiben.</em></h2>
      <p class="pz-lead">Menschen, Räume, Material, Landschaft – fotografiert mit Blick für das, was einen Ort oder eine Marke ausmacht.</p>
    </div>
    <div class="pz-track" data-photo-zoom>
      <div class="pz-sticky">
        {photos.map((p, i) => (
          <div class={`pz-layer pz-layer--${i}`} data-pz-layer={i}>
            <div class="pz-frame">
              <img src={i === 0 ? p.image : p.thumb || p.image} alt={p.alt} loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />
            </div>
          </div>
        ))}
        <div class="pz-outro" data-pz-outro>
          <p>{photos[0].alt}</p>
          <a class="action magnetic" href="/fotografie">
            Zur Fotografie
            <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M6 18 18 6M6 6h12v12"></path></svg>
          </a>
        </div>
      </div>
    </div>
  </section>
)}

<script>
  import { animate, scroll } from 'motion';
  const track = document.querySelector('[data-photo-zoom]');
  const reduced = matchMedia('(prefers-reduced-motion: reduce)');
  if (track && !reduced.matches) {
    track.classList.add('is-live');
    const scales = [4, 5, 6, 5, 6, 8, 9];
    const opts = { target: track, offset: ['start start', 'end end'] };
    track.querySelectorAll('[data-pz-layer]').forEach((layer) => {
      const s = scales[Number(layer.dataset.pzLayer)] ?? 5;
      scroll(animate(layer, { transform: ['scale(1)', `scale(${s})`] }, { ease: 'linear' }), opts);
    });
    const outro = track.querySelector('[data-pz-outro]');
    scroll(animate(outro, { opacity: [0, 0, 1], transform: ['translateY(24px)', 'translateY(24px)', 'translateY(0px)'] }, { ease: 'linear', times: [0, 0.82, 1] }), opts);
  }
</script>
