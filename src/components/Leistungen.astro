---
import l from '../content/site/leistungen.json';
import { hl } from '../lib/text';

type Service = (typeof l.services)[number] & { short?: string; slug?: string };
const services = l.services as Service[];
---

<section class="services section shell" id="leistungen">
  <div class="section-title">
    <h2 set:html={hl(l.title)} />
  </div>
  <div class="discipline-stage">
    <div aria-label="Disziplin auswählen" aria-orientation="vertical" class="discipline-tabs" role="tablist">
      {services.map((s, i) => (
        <button
          aria-controls={`disziplin-${i}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          data-discipline={i}
          id={`tab-${i}`}
          role="tab"
          tabindex={i === 0 ? 0 : -1}
          type="button"
        >
          <span class="tab-index">{s.no}</span>
          <span>{s.short || s.title}</span>
          <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M5 12h14m-6-6 6 6-6 6"></path></svg>
        </button>
      ))}
    </div>
    <div class="service-grid">
      {services.map((s, i) => (
        <article aria-labelledby={`tab-${i}`} class={`service service-${i}`} id={`disziplin-${i}`} role="tabpanel" tabindex="0" hidden={i !== 0}>
          <div aria-label={`Abstraktes Linienmuster für ${s.title}`} class="service-art landscape" data-pattern={i % 4} role="img">
            <canvas aria-hidden="true"></canvas>
            <span class="art-label">{s.tag}</span>
          </div>
          <div class="service-copy">
            <h4>{s.tag}</h4>
            <p>{s.body}</p>
            <ul class="tags">{s.items.map((t) => <li>{t}</li>)}</ul>
            <p class="entry">{s.entry}</p>
            {s.slug && <a class="text-link service-more" href={`/${s.slug}`}>Mehr zu {s.short || s.title}<svg aria-hidden="true" viewBox="0 0 24 24"><path d="M6 18 18 6M6 6h12v12"></path></svg></a>}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
