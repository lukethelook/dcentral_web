---
import data from '../content/site/leistungen.json';
import { hl } from '../lib/text';
const services = data.services;
---

<section class="lst" id="leistungen">
  <div class="shell shell--wide lst__head">
    <p class="eyebrow" data-st>[ 01 ] {data.eyebrow}</p>
    <h2 class="lst__title display" data-st set:html={hl(data.title)}></h2>
  </div>

  <div class="shell shell--wide">
    <hr class="rule" />
    <ul class="lst__list">
      {services.map((s) => (
        <li class="row" data-st>
          <button class="row__head" aria-expanded="false">
            <span class="row__no meta">{s.no}</span>
            <span class="row__title display">{s.title}</span>
            <span class="row__tag">{s.tag}</span>
            <span class="row__plus" aria-hidden="true"></span>
          </button>
          <div class="row__panel">
            <div class="row__panel-inner">
              <div class="row__grid">
                <p class="row__body">{s.body}</p>
                <div class="row__aside">
                  <p class="row__entry">{s.entry}</p>
                  <ul class="row__chips">{s.items.map((i) => <li>{i}</li>)}</ul>
                </div>
              </div>
            </div>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .lst { padding-block: var(--section-y); background: var(--color-void); }
  .lst__head { display: flex; align-items: flex-end; justify-content: space-between; gap: 1.4rem; flex-wrap: wrap; margin-bottom: clamp(2rem, 5vw, 3.4rem); }
  .lst__title { font-size: var(--step-4); text-align: right; }
  .lst__title em { font-style: normal; color: var(--color-signal); }

  .lst__list { list-style: none; margin: 0; padding: 0; }
  .row { border-bottom: 1px solid var(--color-line); }
  .row__head {
    width: 100%; background: none; border: 0; cursor: pointer; text-align: left; color: var(--color-paper);
    display: grid; align-items: center; gap: clamp(0.8rem, 3vw, 2rem);
    grid-template-columns: 3rem 1fr auto 1.4rem; padding: clamp(1.1rem, 2.6vw, 1.9rem) 0;
    transition: padding-left 0.5s var(--ease-out);
  }
  .row:hover .row__head { padding-left: clamp(0.4rem, 1.5vw, 1.2rem); }
  .row__no { color: var(--color-signal); }
  .row__title { font-size: clamp(1.6rem, 4.5vw, 3.4rem); transition: color 0.3s ease; }
  .row:hover .row__title, .row[data-open] .row__title { color: var(--color-signal); }
  .row__tag { color: var(--color-ash); font-size: var(--step-0); justify-self: end; text-align: right; }

  .row__plus { position: relative; width: 14px; height: 14px; justify-self: end; }
  .row__plus::before, .row__plus::after { content: ""; position: absolute; inset: 0; margin: auto; background: var(--color-signal); transition: transform 0.5s var(--ease-out); }
  .row__plus::before { width: 14px; height: 1.5px; }
  .row__plus::after { width: 1.5px; height: 14px; }
  .row[data-open] .row__plus::after { transform: scaleY(0); }

  .row__panel { display: grid; grid-template-rows: 0fr; transition: grid-template-rows 0.55s var(--ease-out); }
  .row[data-open] .row__panel { grid-template-rows: 1fr; }
  .row__panel-inner { overflow: hidden; }
  .row__grid { display: grid; grid-template-columns: 1.4fr 1fr; gap: clamp(1.4rem, 4vw, 3rem); padding: 0.4rem 0 clamp(1.6rem, 3vw, 2.4rem); }
  .row__body { margin: 0; max-width: 56ch; font-size: var(--step-1); line-height: 1.5; color: var(--color-paper); }
  .row__entry { margin: 0 0 1rem; font-family: var(--font-mono); font-size: var(--step--1); color: var(--color-signal); }
  .row__chips { list-style: none; display: flex; flex-wrap: wrap; gap: 0.45rem; padding: 0; margin: 0; }
  .row__chips li { font-family: var(--font-mono); font-size: var(--step--1); padding: 0.35rem 0.75rem; border: 1px solid var(--color-line); color: var(--color-ash); text-transform: uppercase; letter-spacing: 0.04em; }

  @media (max-width: 760px) {
    .row__head { grid-template-columns: 2.2rem 1fr 1.2rem; }
    .row__tag { display: none; }
    .row__grid { grid-template-columns: 1fr; }
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { prefersReducedMotion, registerGsap } from '../lib/motion';

  const rows = document.querySelectorAll<HTMLElement>('#leistungen .row');
  rows.forEach((row) => {
    row.querySelector<HTMLButtonElement>('.row__head')!.addEventListener('click', () => {
      const open = row.hasAttribute('data-open');
      rows.forEach((r) => { r.removeAttribute('data-open'); r.querySelector('.row__head')?.setAttribute('aria-expanded', 'false'); });
      if (!open) { row.setAttribute('data-open', ''); row.querySelector('.row__head')?.setAttribute('aria-expanded', 'true'); }
      ScrollTrigger.refresh();
    });
  });
  rows[0]?.setAttribute('data-open', '');
  rows[0]?.querySelector('.row__head')?.setAttribute('aria-expanded', 'true');

  if (!prefersReducedMotion) {
    registerGsap();
    gsap.from('#leistungen [data-st]', { y: 30, opacity: 0, duration: 0.9, ease: 'expo.out', stagger: 0.07, scrollTrigger: { trigger: '#leistungen', start: 'top 72%' } });
  }
</script>
