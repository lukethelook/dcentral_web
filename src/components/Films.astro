---
// Film section (homepage): client films as expanding panels. Hovering a panel opens
// it and plays its muted loop; a click opens the player, which grows out of the panel.
// Phones get a swipeable row. Content: Keystatic „Film" (films collection + film singleton).
// Interaction inspired by 21st.dev „Hover Expand Gallery" + „Interactive Video Player".
import { getCollection } from 'astro:content';
import s from '../content/site/film.json';
import { hl } from '../lib/text';
import '../styles/films.css';

const films = (await getCollection('films'))
  .filter((f) => !f.data.hidden && (f.data.film || f.data.vimeo || f.data.youtube))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 6);
// Keystatic file fields may store just a filename — tolerate both forms.
const src = (p: string) => (/^(https?:|\/)/.test(p) ? p : `/videos/${p}`);
const pad = (n: number) => String(n).padStart(2, '0');
const arrow = 'M6 18 18 6M6 6h12v12';
const play = 'M7 4.5v15l13-7.5-13-7.5Z';
---

{films.length > 0 && (
  <section class="films section" id="film" aria-labelledby="films-title">
    <div class="shell">
      <div class="section-rail">
        <span>{s.railLeft}</span>
        <span>{s.railRight}</span>
      </div>
      <div class="films-head">
        <h2 id="films-title" set:html={hl(s.title)} />
        {s.lead && <p class="films-lead">{s.lead}</p>}
      </div>

      <div class="films-stage" data-films>
        {films.map(({ data: f }, i) => {
          const provider = f.film ? 'file' : f.youtube ? 'youtube' : 'vimeo';
          const meta = [f.category, f.year].filter(Boolean).join(' · ');
          return (
            <article class="film" aria-current={i === 0 ? 'true' : undefined}>
              <button
                type="button"
                class="film-hit"
                data-play={f.film ? src(f.film) : f.youtube || f.vimeo}
                data-provider={provider}
                data-title={f.title}
                data-client={f.client}
                data-case={f.case ?? ''}
                aria-label={`Film abspielen: ${f.title}, ${f.client}${f.duration ? ` (${f.duration})` : ''}`}
              >
                {f.loop
                  ? <video class="film-media" data-loop={src(f.loop)} poster={f.poster ? src(f.poster) : undefined} muted loop playsinline preload="none" aria-hidden="true"></video>
                  : f.poster && <img class="film-media" src={src(f.poster)} alt="" loading="lazy" decoding="async" />}
                <span class="film-shade" aria-hidden="true"></span>
                <span class="film-rail" aria-hidden="true"><b>{pad(i + 1)}</b>{f.client}</span>
                <span class="film-meta">
                  <span class="film-kicker">{pad(i + 1)}{meta && ` · ${meta}`}</span>
                  <span class="film-title">{f.title}</span>
                  <span class="film-client">{f.client}{f.duration && ` · ${f.duration}`}</span>
                </span>
                <span class="film-badge" aria-hidden="true"><svg viewBox="0 0 24 24"><path d={play}></path></svg></span>
                <span class="film-cursor" aria-hidden="true"><svg viewBox="0 0 24 24"><path d={play}></path></svg>Abspielen</span>
              </button>
              {f.case && (
                <a class="film-case" href={`/arbeiten/${f.case}`}>
                  Zum Projekt <svg aria-hidden="true" viewBox="0 0 24 24"><path d={arrow}></path></svg>
                </a>
              )}
            </article>
          );
        })}
      </div>
    </div>

    <dialog class="film-modal" aria-label="Film">
      <div class="fm-frame">
        <video class="fm-video" playsinline preload="none"></video>
        <div class="fm-embed" hidden></div>
        <div class="fm-controls">
          <button type="button" class="fm-play" aria-label="Pause">
            <svg class="i-pause" aria-hidden="true" viewBox="0 0 24 24"><path d="M8 5v14M16 5v14"></path></svg>
            <svg class="i-play" aria-hidden="true" viewBox="0 0 24 24"><path d={play}></path></svg>
          </button>
          <input class="fm-range" type="range" min="0" max="1000" step="1" value="0" aria-label="Position im Film" />
          <span class="fm-time">0:00</span>
          <button type="button" class="fm-mute" aria-label="Ton aus">
            <svg class="i-sound" aria-hidden="true" viewBox="0 0 24 24"><path d="M4 9v6h4l5 4V5L8 9H4Zm12.5 3a4.5 4.5 0 0 0-2.2-3.9v7.8a4.5 4.5 0 0 0 2.2-3.9Z"></path></svg>
            <svg class="i-muted" aria-hidden="true" viewBox="0 0 24 24"><path d="M4 9v6h4l5 4V5L8 9H4Zm12 0 5 6m0-6-5 6"></path></svg>
          </button>
          <button type="button" class="fm-full" aria-label="Vollbild">
            <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5"></path></svg>
          </button>
        </div>
      </div>
      <div class="fm-caption">
        <span class="fm-title"></span>
        <span class="fm-client"></span>
        <a class="fm-case" href="#">Zum Projekt <svg aria-hidden="true" viewBox="0 0 24 24"><path d={arrow}></path></svg></a>
      </div>
      <button type="button" class="fm-close" aria-label="Film schließen">
        <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M6 6l12 12M18 6 6 18"></path></svg>
      </button>
    </dialog>
  </section>
)}

<script>
  import '../scripts/films.js';
</script>
