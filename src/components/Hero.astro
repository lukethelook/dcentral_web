---
import h from '../content/site/hero.json';
import { hl } from '../lib/text';

// First line plain, *accent* line in Instrument Serif — as in the concept.
const [first, ...rest] = h.headline.split('\n');
const second = rest.join(' ');
const plain = (s: string) => s.replace(/\*/g, '');
---

<section aria-label={plain(h.headline.replace(/\n/g, ' '))} class="hero" id="top">
  <div class="landscape hero-landscape" data-landscape="hero">
    <canvas aria-label="Interaktive Linienlandschaft des Traunsteins"></canvas>
  </div>
  <div class="hero-copy">
    <p class="location">{h.location}</p>
    <p class="hero-intro">{h.intro}</p>
    <h1>
      <span set:html={hl(first)} />{second && <><br /><em>{plain(second)}</em></>}
    </h1>
    <p class="hero-network" set:html={hl(h.network)} />
    <a class="action magnetic" href="#kontakt">
      {h.ctaPrimary}
      <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M6 18 18 6M6 6h12v12"></path></svg>
    </a>
  </div>
  <div class="hero-bottom">
    <a href="#leistungen">
      {h.ticker.map((t, i) => <>{i > 0 && <span>·</span>}{t}</>)}
      <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"></path></svg>
    </a>
    <div class="hero-controls">
      <button aria-label="Helle Hero-Ansicht aktivieren" aria-pressed="true" id="hero-theme-toggle" type="button">
        <svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M2 12h2M20 12h2M5 5l1.4 1.4M17.6 17.6l1.4 1.4M5 19l1.4-1.4M17.6 6.4 19 5"></path></svg>
        <span>Helle Ansicht</span>
      </button>
      <button aria-label="Animationen pausieren" aria-pressed="false" id="motion-toggle" type="button">
        <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M9 6v12M15 6v12"></path></svg>
        <span>Bewegung pausieren</span>
      </button>
    </div>
  </div>
</section>
