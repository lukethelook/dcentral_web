---
// Studio — the interactive node network, restyled as a Signal-lime wireframe
// blueprint. dcentral (you) at the centre, disciplines & partners orbiting.
import data from '../content/site/studio.json';
import { hl } from '../lib/text';
const nodes = data.nodes;
---

<section class="studio" id="studio">
  <div class="shell shell--wide studio__grid">
    <div class="studio__copy">
      <p class="eyebrow" data-st>[ 02 ] {data.eyebrow}</p>
      <h2 class="studio__title display" data-st set:html={hl(data.title)}></h2>
      <p class="studio__lead" data-st>{data.lead}</p>
      <ul class="studio__pts">
        {data.points.map((p, i) => (
          <li data-st><span class="meta">{String(i + 1).padStart(2, '0')}</span> {p}</li>
        ))}
      </ul>
      <a href="#kontakt" class="studio__cta link-underline" data-st>{data.cta}</a>
    </div>

    <div class="studio__viz" data-st>
      <canvas id="net-canvas" aria-hidden="true"></canvas>
      <div class="net-logo" aria-hidden="true"><canvas id="net-logo"></canvas></div>
      <span class="studio__viz-note meta" aria-hidden="true">// bewegt sich mit dir</span>
    </div>
  </div>

  <script type="application/json" id="net-data" set:html={JSON.stringify(nodes)}></script>
</section>

<style>
  .studio { padding-block: var(--section-y); overflow: hidden; }
  .studio__grid { display: grid; gap: clamp(2.4rem, 5vw, 5rem); align-items: center; grid-template-columns: 1fr 1fr; }
  .studio__title { font-size: var(--step-4); margin: 1rem 0 1.4rem; }
  .studio__title em { font-style: normal; color: var(--color-signal); }
  .studio__lead { margin: 0 0 2rem; max-width: 48ch; font-size: var(--step-1); line-height: 1.55; color: var(--color-paper); }
  .studio__pts { list-style: none; padding: 0; margin: 0 0 2.2rem; display: grid; gap: 0.9rem; }
  .studio__pts li { display: grid; grid-template-columns: auto 1fr; gap: 0.9rem; align-items: baseline; color: var(--color-ash); font-size: var(--step-0); }
  .studio__pts span { color: var(--color-signal); }
  .studio__cta { font-family: var(--font-mono); font-size: var(--step-0); color: var(--color-signal); text-transform: uppercase; letter-spacing: 0.05em; }

  .studio__viz { position: relative; aspect-ratio: 1 / 1; border: 1px solid var(--color-line); }
  #net-canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .net-logo {
    position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%);
    width: clamp(140px, 40%, 220px); height: clamp(46px, 13%, 74px);
    pointer-events: none; z-index: 2;
  }
  #net-logo { width: 100%; height: 100%; display: block; }
  .studio__viz-note { position: absolute; bottom: 0.8rem; left: 0.8rem; z-index: 3; }

  @media (max-width: 860px) { .studio__grid { grid-template-columns: 1fr; } .studio__viz { max-width: 460px; margin-inline: auto; width: 100%; } }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { prefersReducedMotion, registerGsap, whenVisible } from '../lib/motion';
  import { flowmapText } from '../lib/gl';

  if (!prefersReducedMotion) {
    registerGsap();
    gsap.from('#studio [data-st]', { y: 28, opacity: 0, duration: 0.9, ease: 'expo.out', stagger: 0.08, scrollTrigger: { trigger: '#studio', start: 'top 72%' } });
  }

  /* ── Central flowmap logo (same displace effect as the hero, smaller) ── */
  let logoActive = false;
  const logoCanvas = document.getElementById('net-logo') as HTMLCanvasElement | null;
  const paintLogo = (lctx: CanvasRenderingContext2D, w: number, h: number) => {
    lctx.fillStyle = '#F4F4F0';
    lctx.textBaseline = 'middle';
    lctx.textAlign = 'center';
    let size = 120;
    lctx.font = `800 ${size}px "Archivo Variable", sans-serif`;
    (lctx as any).letterSpacing = `${-size * 0.02}px`;
    const measured = lctx.measureText('dcentral').width;
    size = size * (w * 0.94) / measured;
    lctx.font = `800 ${size}px "Archivo Variable", sans-serif`;
    (lctx as any).letterSpacing = `${-size * 0.02}px`;
    lctx.fillText('dcentral', w / 2, h * 0.54);
  };
  if (logoCanvas && !prefersReducedMotion) {
    (document.fonts?.ready ?? Promise.resolve()).then(() => {
      try {
        const fm = flowmapText(logoCanvas, { paint: paintLogo, strength: 0.16, chromatic: 0.5, falloff: 0.24, dissipation: 0.9 });
        logoActive = true;
        fm.repaint();
        whenVisible(logoCanvas, () => fm.start());
        document.addEventListener('visibilitychange', () => { document.hidden ? fm.stop() : (logoActive && fm.start()); });
      } catch { if (logoCanvas) logoCanvas.style.display = 'none'; }
    });
  } else if (logoCanvas) {
    logoCanvas.style.display = 'none';
  }

  const canvas = document.getElementById('net-canvas') as HTMLCanvasElement | null;
  const dataEl = document.getElementById('net-data');
  if (canvas && dataEl) {
    type P = { label: string; kind: string };
    const pts: P[] = JSON.parse(dataEl.textContent || '[]');
    const ctx = canvas.getContext('2d')!;
    let W = 0, H = 0, cx = 0, cy = 0, R = 0;

    const SIGNAL = '194,242,61', PAPER = '244,244,240', ASH = '138,138,133';

    type Node = { baseAngle: number; baseRad: number; r: number; label: string; kind: string; phase: number; x: number; y: number; vx: number; vy: number; };
    type Pulse = { t: number; speed: number; size: number };
    type Link = { node: number; arc: number; pulses: Pulse[] };
    let nodes: Node[] = [];
    let links: Link[] = [];
    const rings: { r: number; max: number }[] = [];

    const build = () => {
      const rect = canvas.getBoundingClientRect();
      W = rect.width; H = rect.height; cx = W / 2; cy = H / 2; R = Math.min(W, H) * 0.38;
      const dpr = Math.min(window.devicePixelRatio, 2);
      canvas.width = W * dpr; canvas.height = H * dpr; ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

      nodes = [{ baseAngle: 0, baseRad: 0, r: 6, label: 'dcentral', kind: 'center', phase: 0, x: cx, y: cy, vx: 0, vy: 0 }];
      links = [];
      pts.forEach((p, i) => {
        const a = (i / pts.length) * Math.PI * 2 - Math.PI / 2;
        const rad = R * (p.kind === 'disc' ? 0.72 : 1.0);
        nodes.push({ baseAngle: a, baseRad: rad, r: p.kind === 'disc' ? 4 : 3, label: p.label, kind: p.kind, phase: a * 3, x: cx + Math.cos(a) * rad, y: cy + Math.sin(a) * rad, vx: 0, vy: 0 });
        const n = nodes.length - 1;
        const pulses: Pulse[] = [];
        const count = p.kind === 'disc' ? 3 : 2;
        for (let k = 0; k < count; k++) pulses.push({ t: (k / count) + Math.random() * 0.25, speed: 0.0018 + Math.random() * 0.0016, size: p.kind === 'disc' ? 2.4 : 1.8 });
        links.push({ node: n, arc: (i % 2 ? 1 : -1) * (0.12 + (i % 3) * 0.04), pulses });
      });
    };
    build();
    addEventListener('resize', build);

    const mouse = { x: -9999, y: -9999 };
    canvas.addEventListener('pointermove', (e) => { const r = canvas.getBoundingClientRect(); mouse.x = e.clientX - r.left; mouse.y = e.clientY - r.top; });
    canvas.addEventListener('pointerleave', () => { mouse.x = -9999; mouse.y = -9999; });

    // quadratic bezier helpers (arced links)
    const bz = (a: number, c: number, b: number, t: number) => (1 - t) * (1 - t) * a + 2 * (1 - t) * t * c + t * t * b;
    const ctrl = (ax: number, ay: number, bx: number, by: number, arc: number) => {
      const mx = (ax + bx) / 2, my = (ay + by) / 2;
      const dx = bx - ax, dy = by - ay;
      return [mx - dy * arc, my + dx * arc] as const;
    };

    let t = 0, rot = 0, running = false, ringTimer = 0, hovered = -1;
    const draw = () => {
      t += 0.006; rot += 0.0009;
      ctx.clearRect(0, 0, W, H);
      const C = nodes[0];

      // live node positions: rotation + breathing + organic drift + cursor repel
      let hov = -1, hovDist = 70;
      for (let i = 1; i < nodes.length; i++) {
        const n = nodes[i];
        const ang = n.baseAngle + rot;
        const rad = n.baseRad + Math.sin(t * 0.7 + n.phase) * 5;
        let tx = cx + Math.cos(ang) * rad + Math.cos(t * 1.3 + n.phase) * 4;
        let ty = cy + Math.sin(ang) * rad + Math.sin(t * 1.1 + n.phase) * 4;
        const dx = mouse.x - tx, dy = mouse.y - ty, d = Math.hypot(dx, dy);
        if (d < 130) { const f = (1 - d / 130) * 22; tx -= (dx / d) * f; ty -= (dy / d) * f; }
        n.x += (tx - n.x) * 0.08; n.y += (ty - n.y) * 0.08;
        if (d < hovDist) { hovDist = d; hov = i; }
      }
      hovered = hov;

      // ── arced links + travelling energy pulses ──
      ctx.lineCap = 'round';
      for (const link of links) {
        const n = nodes[link.node];
        const isHov = hovered === link.node;
        const dim = hovered >= 0 && !isHov ? 0.32 : 1;
        const [cpx, cpy] = ctrl(C.x, C.y, n.x, n.y, link.arc);

        // base line
        ctx.strokeStyle = `rgba(${ASH},${0.18 * dim})`;
        ctx.lineWidth = 0.6;
        ctx.beginPath(); ctx.moveTo(C.x, C.y); ctx.quadraticCurveTo(cpx, cpy, n.x, n.y); ctx.stroke();
        // signal overlay (brighter when hovered)
        ctx.strokeStyle = `rgba(${SIGNAL},${(isHov ? 0.7 : 0.12) * dim})`;
        ctx.lineWidth = isHov ? 1.6 : 0.7;
        ctx.beginPath(); ctx.moveTo(C.x, C.y); ctx.quadraticCurveTo(cpx, cpy, n.x, n.y); ctx.stroke();

        // pulses (additive)
        ctx.globalCompositeOperation = 'lighter';
        for (const p of link.pulses) {
          p.t += p.speed * (isHov ? 2.6 : 1);
          if (p.t > 1) p.t -= 1 + Math.random() * 0.2;
          if (p.t < 0) continue;
          const px = bz(C.x, cpx, n.x, p.t), py = bz(C.y, cpy, n.y, p.t);
          const fade = Math.sin(p.t * Math.PI); // dim at both ends
          const sz = p.size * (isHov ? 1.7 : 1);
          const g = ctx.createRadialGradient(px, py, 0, px, py, sz * 4);
          g.addColorStop(0, `rgba(${SIGNAL},${0.9 * fade * dim})`);
          g.addColorStop(1, `rgba(${SIGNAL},0)`);
          ctx.fillStyle = g; ctx.beginPath(); ctx.arc(px, py, sz * 4, 0, Math.PI * 2); ctx.fill();
        }
        ctx.globalCompositeOperation = 'source-over';
      }

      // ── central node: emitted rings + layered glow (additive) ──
      ctx.globalCompositeOperation = 'lighter';
      ringTimer += 1;
      if (ringTimer > 64) { ringTimer = 0; rings.push({ r: 8, max: R * 0.95 }); }
      for (let i = rings.length - 1; i >= 0; i--) {
        const ring = rings[i]; ring.r += 1.1;
        const a = Math.max(0, 1 - ring.r / ring.max);
        ctx.strokeStyle = `rgba(${SIGNAL},${a * 0.5})`; ctx.lineWidth = 1;
        ctx.beginPath(); ctx.arc(C.x, C.y, ring.r, 0, Math.PI * 2); ctx.stroke();
        if (ring.r >= ring.max) rings.splice(i, 1);
      }
      const breathe = 30 + Math.sin(t * 1.4) * 8;
      const cg = ctx.createRadialGradient(C.x, C.y, 0, C.x, C.y, breathe);
      cg.addColorStop(0, `rgba(${SIGNAL},0.8)`); cg.addColorStop(0.5, `rgba(${SIGNAL},0.25)`); cg.addColorStop(1, `rgba(${SIGNAL},0)`);
      ctx.fillStyle = cg; ctx.beginPath(); ctx.arc(C.x, C.y, breathe, 0, Math.PI * 2); ctx.fill();
      ctx.globalCompositeOperation = 'source-over';

      // ── nodes + labels ──
      // central dot only when the flowmap logo is NOT covering the centre
      if (!logoActive) {
        ctx.fillStyle = `rgb(${SIGNAL})`;
        ctx.beginPath(); ctx.arc(C.x, C.y, 5, 0, Math.PI * 2); ctx.fill();
      }

      for (let i = 1; i < nodes.length; i++) {
        const n = nodes[i];
        const isHov = hovered === i;
        const dim = hovered >= 0 && !isHov ? 0.4 : 1;
        // halo
        ctx.globalCompositeOperation = 'lighter';
        const hr = (n.r + 8) * (isHov ? 1.6 : 1);
        const hg = ctx.createRadialGradient(n.x, n.y, 0, n.x, n.y, hr);
        hg.addColorStop(0, `rgba(${SIGNAL},${(isHov ? 0.55 : 0.12) * dim})`);
        hg.addColorStop(1, `rgba(${SIGNAL},0)`);
        ctx.fillStyle = hg; ctx.beginPath(); ctx.arc(n.x, n.y, hr, 0, Math.PI * 2); ctx.fill();
        ctx.globalCompositeOperation = 'source-over';
        // dot
        ctx.fillStyle = isHov ? `rgb(${SIGNAL})` : `rgba(${PAPER},${0.85 * dim})`;
        ctx.beginPath(); ctx.arc(n.x, n.y, n.r + (isHov ? 1.5 : 0), 0, Math.PI * 2); ctx.fill();
        // label
        ctx.font = `10px "JetBrains Mono", monospace`;
        ctx.fillStyle = isHov ? `rgb(${SIGNAL})` : `rgba(${ASH},${0.7 * dim})`;
        ctx.textAlign = 'center'; ctx.fillText(n.label, n.x, n.y - n.r - 10);
      }
      // centre label only as fallback (the flowmap logo carries the wordmark otherwise)
      if (!logoActive) {
        ctx.font = `11px "JetBrains Mono", monospace`;
        ctx.fillStyle = `rgb(${SIGNAL})`; ctx.textAlign = 'center';
        ctx.fillText('dcentral', C.x, C.y - 16);
      }

      if (running) requestAnimationFrame(draw);
    };
    const start = () => { if (running) return; running = true; draw(); };
    document.addEventListener('visibilitychange', () => { running = !document.hidden; if (running && !prefersReducedMotion) start(); });
    if (prefersReducedMotion) draw(); else whenVisible(canvas, start);
  }
</script>
