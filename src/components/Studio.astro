---
import s from '../content/site/studio.json';
import { hl } from '../lib/text';

const img = /^(https?:|\/)/.test(s.image) ? s.image : `/images/studio/${s.image}`;
---

<section class="studio shell section" id="studio">
  <div class="studio-grid">
    <figure class="studio-visual">
      <div class="studio-frame" data-studio-line>
        <img alt={s.imageAlt} height="880" loading="lazy" src={img} width="1168" />
        <canvas class="sl-canvas" aria-hidden="true"></canvas>
        <button type="button" class="sl-words">Foto · Film · Web · KI <span aria-hidden="true">↺</span></button>
        <span class="sl-count" aria-hidden="true"></span>
      </div>
      {s.caption && <figcaption>{s.caption}</figcaption>}
    </figure>
    <div class="studio-copy">
      <h2 set:html={hl(s.title)} />
      {s.subtitle && <h3>{s.subtitle}</h3>}
      <p>{s.lead}</p>
      <ol class="studio-points">{s.points.map((p) => <li>{p}</li>)}</ol>
      <a class="text-link" href="#kontakt" data-contact="start">
        {s.cta}
        <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M6 18 18 6M6 6h12v12"></path></svg>
      </a>
    </div>
  </div>
</section>

<script>
  import '../scripts/studio-line.js';
</script>
