---
// Interactive 360° tour: equirectangular drone panoramas on a Three.js sphere.
// Drag to look around (with momentum), slow idle drift, scene switch with crossfade.
// Loads only when scrolled into view (panorama360.js).
interface Props {
  title: string;
  scenes: { image: string; title: string }[];
}
const { title, scenes } = Astro.props;
---

<section class="pano" data-panorama aria-labelledby="pano-title">
  <div class="pano-head">
    <p class="pano-eyebrow"><span></span>Zum Ausprobieren</p>
    <h2 id="pano-title" class="case-h2">{title}</h2>
  </div>
  <div class="pano-stage" tabindex="0" aria-label={`${title}: mit Maus, Finger oder Pfeiltasten umsehen`}>
    <canvas aria-hidden="true"></canvas>
    <p class="pano-hint" aria-hidden="true">
      <svg viewBox="0 0 24 24"><path d="M8 12h8m-8 0 3-3m-3 3 3 3m5-3-3-3m3 3-3 3"></path></svg>
      Ziehen zum Umsehen
    </p>
    <p class="pano-loading" aria-hidden="true">Panorama lädt …</p>
    <div class="pano-scenes" role="radiogroup" aria-label="Szene wählen">
      {scenes.map((s, i) => (
        <button type="button" role="radio" aria-checked={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-scene={i} data-src={s.image}>{s.title}</button>
      ))}
    </div>
  </div>
</section>

<script>
  import '../scripts/panorama360.js';
</script>
