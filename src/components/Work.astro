---
import { getCollection } from 'astro:content';
import w from '../content/site/work.json';
import { hl } from '../lib/text';

const cases = (await getCollection('cases')).sort((a, b) => a.data.order - b.data.order);
const filters = ['Alle', 'Foto', 'Film & Aerial', 'Web', 'KI'];
const arrow = 'M6 18 18 6M6 6h12v12';
// Keystatic image fields may store just a filename — tolerate both forms.
const src = (p: string) => (/^(https?:|\/)/.test(p) ? p : `/images/cases/${p}`);
---

<section class="work section" id="arbeiten">
  <div class="shell">
    <div class="section-rail">
      <span>{w.railLeft}</span>
      <span>{w.railRight}</span>
    </div>
    <div class="work-heading">
      <h2 set:html={hl(w.title)} />
      <div class="gallery-controls">
        <button aria-label="Automatischen Galeriedurchlauf pausieren" aria-pressed="false" class="gallery-play" id="gallery-play" type="button">
          <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M9 6v12M15 6v12"></path></svg><span>Pause</span>
        </button>
        <button aria-label="Vorherige Projekte" id="gallery-prev" type="button">
          <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M19 12H5m7-7-7 7 7 7"></path></svg>
        </button>
        <button aria-label="Nächste Projekte" id="gallery-next" type="button">
          <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"></path></svg>
        </button>
      </div>
    </div>
    <div aria-label="Projekte nach Disziplin filtern" class="filters" role="group">
      <span aria-hidden="true" class="filter-highlight"></span>
      {filters.map((f, i) => <button aria-pressed={i === 0 ? 'true' : 'false'} data-filter={f} type="button">{f}</button>)}
    </div>
  </div>
  <div aria-describedby="gallery-note" aria-label="Projektgalerie" class="gallery" tabindex="0">
    {cases.map(({ id, data: d }, i) => {
      const previews = d.previews.slice(0, 2).map(src);
      const cover = d.cover ? src(d.cover) : `/assets/project-lines-${i % 4}.svg`;
      return (
        <article class="project" data-discipline={d.discipline} data-project={id}>
          <a aria-label={`${d.client} — ${d.title}`} href={`/arbeiten/${id}`}>
            <div class={`project-cover cover-${i % 4}${d.cover ? ' has-photo' : ''}`}>
              <img alt="" height="700" loading="lazy" src={cover} width="900" />
              <span class="cover-top">{d.discipline} <span>{d.year}</span></span>
              <span class="cover-client">{d.client}</span>
              <span class="cover-arrow"><svg aria-hidden="true" viewBox="0 0 24 24"><path d={arrow}></path></svg></span>
              <span class="cover-open">Projekt ansehen <svg aria-hidden="true" viewBox="0 0 24 24"><path d={arrow}></path></svg></span>
              {previews.length > 0 && (
                <>
                  <div aria-hidden="true" class="project-preview">
                    {previews.map((p, k) => (
                      <img
                        alt=""
                        class="preview-frame"
                        data-src={p}
                        decoding="async"
                        height="750"
                        width="1000"
                        style={k > 0 && p === previews[0] ? 'object-position:75% 50%' : undefined}
                      />
                    ))}
                    <span class="preview-shade"></span>
                  </div>
                  <span class="preview-label">
                    {d.previewDummy ? 'Dummymotiv' : 'Projektvorschau'}{' '}
                    <span class="preview-count">01 / {String(previews.length).padStart(2, '0')}</span>
                  </span>
                </>
              )}
            </div>
            <div class="project-caption">
              <span>{d.title}</span>
              <span>{String(i + 1).padStart(2, '0')}</span>
            </div>
          </a>
        </article>
      );
    })}
  </div>
  {w.note ? <p class="gallery-note shell" id="gallery-note">{w.note}</p> : <p class="sr-only" id="gallery-note">Projektgalerie, horizontal scrollbar.</p>}
  <p class="sr-only" id="filter-status" role="status"></p>
</section>
