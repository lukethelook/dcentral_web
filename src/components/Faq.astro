---
import f from '../content/site/faq.json';
import { hl } from '../lib/text';

// FAQPage schema — eligible for rich results.
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: f.items.map((i) => ({
    '@type': 'Question',
    name: i.q,
    acceptedAnswer: { '@type': 'Answer', text: i.a },
  })),
};
---

<section class="faq section shell" id="faq">
  <div class="faq-heading">
    <span class="section-label">{f.eyebrow}</span>
    <h2 set:html={hl(f.title)} />
    <a class="text-link" href="#kontakt">
      {f.cta}
      <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M6 18 18 6M6 6h12v12"></path></svg>
    </a>
  </div>
  <div class="faq-list">
    {f.items.map((i) => (
      <details>
        <summary>
          {i.q}
          <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M5 12h14M12 5v14"></path></svg>
        </summary>
        <div class="detail-content"><p>{i.a}</p></div>
      </details>
    ))}
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
</section>
