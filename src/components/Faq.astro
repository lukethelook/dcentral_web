---
import data from '../content/site/faq.json';
import { hl } from '../lib/text';
const faqs = data.items;
const jsonLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---

<section class="faq" id="faq">
  <div class="shell shell--wide faq__grid">
    <div class="faq__head">
      <p class="eyebrow" data-st>[ 05 ] {data.eyebrow}</p>
      <h2 class="faq__title display" data-st set:html={hl(data.title)}></h2>
      <a href="#kontakt" class="faq__cta link-underline" data-st>{data.cta}</a>
    </div>

    <ul class="faq__list" data-skew>
      {faqs.map((f) => (
        <li class="faq__item" data-st>
          <details>
            <summary><span class="faq__q">{f.q}</span><span class="faq__icon" aria-hidden="true"></span></summary>
            <p class="faq__a">{f.a}</p>
          </details>
        </li>
      ))}
    </ul>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</section>

<style>
  .faq { padding-block: var(--section-y); }
  .faq__grid { display: grid; grid-template-columns: 0.8fr 1.2fr; gap: clamp(2rem, 5vw, 4.5rem); align-items: start; }
  .faq__head { position: sticky; top: 7rem; }
  .faq__title { font-size: var(--step-3); margin: 1rem 0 1.4rem; }
  .faq__title em { font-style: normal; color: var(--color-signal); }
  .faq__cta { font-family: var(--font-mono); font-size: var(--step--1); color: var(--color-signal); text-transform: uppercase; letter-spacing: 0.05em; }

  .faq__list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--color-line); }
  .faq__item { border-bottom: 1px solid var(--color-line); }
  details summary { list-style: none; cursor: pointer; display: flex; align-items: center; gap: 1.2rem; justify-content: space-between; padding: clamp(1rem, 2.4vw, 1.4rem) 0; }
  details summary::-webkit-details-marker { display: none; }
  .faq__q { font-family: var(--font-display); font-variation-settings: "wght" 600, "wdth" 105; text-transform: uppercase; font-size: var(--step-1); line-height: 1.15; letter-spacing: -0.01em; }
  .faq__icon { position: relative; flex: 0 0 14px; width: 14px; height: 14px; }
  .faq__icon::before, .faq__icon::after { content: ""; position: absolute; inset: 0; margin: auto; background: var(--color-signal); transition: transform 0.45s var(--ease-out); }
  .faq__icon::before { width: 14px; height: 1.5px; }
  .faq__icon::after { width: 1.5px; height: 14px; }
  details[open] .faq__icon::after { transform: scaleY(0); }
  .faq__a { margin: 0; padding: 0 2.5rem clamp(1rem, 2.4vw, 1.4rem) 0; max-width: 62ch; color: var(--color-ash); line-height: 1.55; }

  @media (max-width: 820px) { .faq__grid { grid-template-columns: 1fr; } .faq__head { position: static; } }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { prefersReducedMotion, registerGsap } from '../lib/motion';

  document.querySelectorAll<HTMLDetailsElement>('#faq details').forEach((d) => {
    const ans = d.querySelector<HTMLElement>('.faq__a')!;
    d.addEventListener('toggle', () => { if (!prefersReducedMotion && d.open) gsap.fromTo(ans, { height: 0, opacity: 0 }, { height: 'auto', opacity: 1, duration: 0.45, ease: 'expo.out' }); });
  });
  if (!prefersReducedMotion) {
    registerGsap();
    gsap.from('#faq [data-st]', { y: 26, opacity: 0, duration: 0.9, ease: 'expo.out', stagger: 0.06, scrollTrigger: { trigger: '#faq', start: 'top 74%' } });
  }
</script>
