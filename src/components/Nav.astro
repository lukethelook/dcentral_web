---
const links = [
  { href: '#leistungen', label: 'Leistungen' },
  { href: '#arbeiten', label: 'Arbeiten' },
  { href: '#studio', label: 'Studio' },
  { href: '#region', label: 'Region' },
];
const menu = [...links, { href: '#kontakt', label: 'Reden wir' }];
---

<header class="nav" id="site-nav" data-top="true">
  <div class="nav__inner shell shell--wide">
    <a href="#top" class="wordmark" aria-label="dcentral — zum Seitenanfang">dcentral<span>.</span></a>

    <nav class="nav__links" aria-label="Hauptnavigation">
      {links.map((l, i) => (
        <a href={l.href} class="nav__link">
          <span class="nav__num">0{i + 1}</span>
          <span class="link-underline">{l.label}</span>
        </a>
      ))}
    </nav>

    <a href="#kontakt" class="nav__cta" data-magnetic>
      <span class="nav__dot"></span> Reden wir
    </a>

    <button class="nav__burger" id="nav-burger" aria-label="Menü öffnen" aria-expanded="false" aria-controls="navmenu">
      <span></span><span></span>
    </button>
  </div>
</header>

<div class="navmenu" id="navmenu" aria-hidden="true">
  <nav class="navmenu__links" aria-label="Menü">
    {menu.map((l, i) => (
      <a href={l.href} class="navmenu__link" style={`transition-delay:${0.06 * i + 0.1}s`}>
        <span class="navmenu__num">0{i + 1}</span><span>{l.label}</span>
      </a>
    ))}
  </nav>
  <div class="navmenu__foot">
    <span class="meta">Salzkammergut, OÖ</span>
    <a href="mailto:hallo@dcentral.at" class="navmenu__mail link-underline">hallo@dcentral.at</a>
  </div>
</div>

<style>
  .nav {
    position: fixed; inset: 0 0 auto 0; z-index: 70;
    padding-block: clamp(0.8rem, 1.8vw, 1.1rem);
    transition: transform 0.5s var(--ease-out), background 0.4s ease, border-color 0.4s ease;
    border-bottom: 1px solid transparent;
  }
  .nav:not([data-top="true"]) {
    background: color-mix(in srgb, var(--color-carbon) 80%, transparent);
    backdrop-filter: blur(12px); border-bottom-color: var(--color-line);
  }
  .nav[data-hidden="true"] { transform: translateY(-110%); }
  .nav[data-menu] { transform: none; background: transparent; border-color: transparent; }
  .nav__inner { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }

  .wordmark {
    font-family: var(--font-display); font-variation-settings: "wght" 760, "wdth" 110;
    font-size: clamp(1.2rem, 2vw, 1.5rem); text-transform: uppercase; letter-spacing: -0.02em;
    text-decoration: none; color: var(--color-paper); position: relative; z-index: 2;
  }
  .wordmark span { color: var(--color-signal); }

  .nav__links { display: flex; align-items: center; gap: clamp(1.2rem, 2.6vw, 2.4rem); }
  .nav__link {
    display: inline-flex; align-items: baseline; gap: 0.4rem; text-decoration: none;
    font-family: var(--font-mono); font-size: var(--step--1); letter-spacing: 0.04em;
    text-transform: uppercase; color: var(--color-paper);
  }
  .nav__num { color: var(--color-ash); font-size: 0.7em; }

  .nav__cta {
    display: inline-flex; align-items: center; gap: 0.55rem; text-decoration: none;
    font-family: var(--font-mono); font-size: var(--step--1); letter-spacing: 0.06em;
    text-transform: uppercase; color: var(--color-carbon); background: var(--color-signal);
    padding: 0.6rem 1.05rem; will-change: transform;
    transition: background 0.4s var(--ease-out), color 0.4s var(--ease-out);
  }
  .nav__cta:hover { background: var(--color-paper); }
  .nav__dot { width: 7px; height: 7px; border-radius: 50%; background: var(--color-carbon); }

  /* Burger */
  .nav__burger {
    display: none; position: relative; z-index: 2; width: 46px; height: 46px;
    background: none; border: 1px solid var(--color-line); cursor: pointer;
    flex-direction: column; align-items: center; justify-content: center; gap: 6px;
  }
  .nav__burger span {
    display: block; width: 22px; height: 1.5px; background: var(--color-signal);
    transition: transform 0.4s var(--ease-out), opacity 0.3s ease;
  }
  .nav[data-menu] .nav__burger span:nth-child(1) { transform: translateY(3.75px) rotate(45deg); }
  .nav[data-menu] .nav__burger span:nth-child(2) { transform: translateY(-3.75px) rotate(-45deg); }

  /* Fullscreen menu */
  .navmenu {
    position: fixed; inset: 0; z-index: 60; background: var(--color-carbon);
    display: flex; flex-direction: column; justify-content: center;
    padding: clamp(5rem, 14vh, 8rem) var(--gutter) clamp(2rem, 6vh, 3rem);
    clip-path: inset(0 0 100% 0); pointer-events: none;
    transition: clip-path 0.7s var(--ease-io);
  }
  .navmenu[data-open] { clip-path: inset(0 0 0% 0); pointer-events: auto; }
  .navmenu__links { display: flex; flex-direction: column; gap: 0.1rem; margin-top: auto; }
  .navmenu__link {
    display: flex; align-items: baseline; gap: 1rem; text-decoration: none;
    font-family: var(--font-display); font-variation-settings: "wght" 720, "wdth" 110;
    text-transform: uppercase; font-size: clamp(2.4rem, 13vw, 4.5rem); line-height: 1.04;
    letter-spacing: -0.02em; color: var(--color-paper);
    transform: translateY(40px); opacity: 0;
    transition: transform 0.6s var(--ease-out), opacity 0.6s ease, color 0.3s ease;
  }
  .navmenu[data-open] .navmenu__link { transform: none; opacity: 1; }
  .navmenu__link:active, .navmenu__link:hover { color: var(--color-signal); }
  .navmenu__num { font-family: var(--font-mono); font-size: 0.9rem; color: var(--color-signal); }
  .navmenu__foot {
    margin-top: auto; display: flex; align-items: center; justify-content: space-between;
    gap: 1rem; flex-wrap: wrap; padding-top: 2rem; border-top: 1px solid var(--color-line);
  }
  .navmenu__mail { font-family: var(--font-mono); color: var(--color-signal); text-decoration: none; }

  @media (max-width: 820px) {
    .nav__links, .nav__cta { display: none; }
    .nav__burger { display: inline-flex; }
  }
  @media (prefers-reduced-motion: reduce) {
    .navmenu { transition: none; }
    .navmenu__link { transition: none; }
  }
</style>

<script>
  import { magnetic, prefersReducedMotion, lockScroll, unlockScroll } from '../lib/motion';

  const nav = document.getElementById('site-nav');
  const menu = document.getElementById('navmenu');
  const burger = document.getElementById('nav-burger');

  if (nav) {
    nav.querySelectorAll<HTMLElement>('[data-magnetic]').forEach((el) => magnetic(el, 0.25));

    let lastY = scrollY, ticking = false;
    const onScroll = () => {
      const y = scrollY;
      nav.dataset.top = y < 40 ? 'true' : 'false';
      if (!prefersReducedMotion && !nav.hasAttribute('data-menu')) {
        nav.dataset.hidden = (y > lastY && y > 220) ? 'true' : 'false';
      }
      lastY = y; ticking = false;
    };
    addEventListener('scroll', () => { if (!ticking) { requestAnimationFrame(onScroll); ticking = true; } }, { passive: true });
  }

  /* Fullscreen menu toggle */
  if (menu && burger && nav) {
    const open = () => {
      menu.setAttribute('data-open', ''); menu.setAttribute('aria-hidden', 'false');
      nav.setAttribute('data-menu', ''); burger.setAttribute('aria-expanded', 'true');
      burger.setAttribute('aria-label', 'Menü schließen');
      lockScroll();
    };
    const close = () => {
      menu.removeAttribute('data-open'); menu.setAttribute('aria-hidden', 'true');
      nav.removeAttribute('data-menu'); burger.setAttribute('aria-expanded', 'false');
      burger.setAttribute('aria-label', 'Menü öffnen');
      unlockScroll();
    };
    burger.addEventListener('click', () => (menu.hasAttribute('data-open') ? close() : open()));
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', close));
    addEventListener('keydown', (e) => { if (e.key === 'Escape' && menu.hasAttribute('data-open')) close(); });
  }
</script>
