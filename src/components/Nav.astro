---
// Home uses in-page anchors; subpages link back to the homepage sections.
interface Props { home?: boolean }
const { home = false } = Astro.props;
const base = home ? '' : '/';
const links = [
  { href: `${base}#leistungen`, label: 'Leistungen' },
  { href: `${base}#arbeiten`, label: 'Arbeiten' },
  { href: '/fotografie', label: 'Fotografie' },
  { href: `${base}#studio`, label: 'Studio' },
  { href: `${base}#impact`, label: 'Impact' },
];
---

<header class="site-header">
  <a aria-label="dcentral – Startseite" class="brand" href={home ? '#top' : '/'}>dcentral<span>.</span></a>
  <nav aria-label="Hauptnavigation" id="navigation">
    {links.map((l) => <a href={l.href}>{l.label}</a>)}
  </nav>
  <a class="header-contact" href={`${base}#kontakt`} data-contact="talk">
    Reden wir
    <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M6 18 18 6M6 6h12v12"></path></svg>
  </a>
  <button aria-controls="navigation" aria-expanded="false" aria-label="Menü öffnen" class="menu-toggle" type="button">
    <span></span><span></span>
  </button>
</header>
