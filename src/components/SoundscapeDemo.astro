---
// Interactive demo of the Project Baby Bloom „Neural Soundscape" player.
// Parameters follow published research (sources listed in the component).
// Visuals: canvas + band scale (soundscape-demo.js). Sound: generated live
// with Web Audio, only after an explicit click — never autoplay.
const states = [
  { id: 'schlaf', label: 'Schlaf' },
  { id: 'ruhe', label: 'Ruhe' },
  { id: 'wach', label: 'Wach' },
  { id: 'froh', label: 'Fröhlich' },
];
const layers = [
  { id: 'freq', label: 'Frequenzschicht', hint: 'binaurale Schwebung' },
  { id: 'noise', label: 'Rosa Rauschen', hint: 'wie sanfter Regen' },
  { id: 'ocean', label: 'Meeresrauschen', hint: 'Welle alle 10 s' },
  { id: 'heart', label: 'Herzschlag', hint: '60 bpm' },
];
// EEG bands on a log scale from 0.5 to 30 Hz (for the band ruler).
const LO = Math.log(0.5), HI = Math.log(30);
const pos = (f: number) => ((Math.log(f) - LO) / (HI - LO)) * 100;
const bands = [
  { id: 'delta', name: 'Delta', from: 0.5, to: 4 },
  { id: 'theta', name: 'Theta', from: 4, to: 8 },
  { id: 'alpha', name: 'Alpha', from: 8, to: 13 },
  { id: 'beta', name: 'Beta', from: 13, to: 30 },
].map((b) => ({ ...b, left: pos(b.from), width: pos(b.to) - pos(b.from) }));
const ticks = [0.5, 1, 2, 4, 8, 13, 30].map((f) => ({ f, left: pos(f) }));
---

<section class="ssd" data-soundscape-demo aria-labelledby="ssd-title">
  <div class="ssd-copy">
    <p class="ssd-eyebrow"><span></span>Live-Demo</p>
    <h2 id="ssd-title">Neural Soundscape <em>zum Ausprobieren.</em></h2>
    <p class="ssd-lead">Jeder Zustand folgt einem Frequenzband aus der Schlaf- und EEG-Forschung. Die Schwebung entsteht in Echtzeit und verbindet sich mit Rauschen, Wellen und Herzschlag. Mit Kopfhörern am besten.</p>

    <div class="ssd-states" role="radiogroup" aria-label="Gewünschter Zustand">
      <span class="ssd-states-ind" aria-hidden="true"></span>
      {states.map((s) => (
        <button type="button" role="radio" aria-checked={s.id === 'schlaf' ? 'true' : 'false'} data-state={s.id} tabindex={s.id === 'schlaf' ? 0 : -1}>{s.label}</button>
      ))}
    </div>

    <div class="ssd-science" aria-live="polite">
      <strong data-band>Delta · 0,5–4 Hz</strong>
      <span data-science>Delta-Wellen prägen den Tiefschlaf – das Ziel beim Einschlafen.</span>
    </div>

    <div class="ssd-layers">
      {layers.map((l) => (
        <label class="ssd-layer">
          <span class="ssd-layer-name">{l.label}<small data-hint={l.id}>{l.hint}</small></span>
          <input type="range" min="0" max="100" value="50" data-layer={l.id} aria-label={`${l.label}: Anteil im Mix`} />
        </label>
      ))}
    </div>

    <div class="ssd-transport">
      <button type="button" class="ssd-play" aria-pressed="false" aria-label="Soundscape abspielen">
        <svg class="ssd-ring" aria-hidden="true" viewBox="0 0 72 72"><circle cx="36" cy="36" r="33" pathLength="1"></circle></svg>
        <svg class="i-play" aria-hidden="true" viewBox="0 0 24 24"><path d="M7 4.5v15l13-7.5-13-7.5Z"></path></svg>
        <svg class="i-pause" aria-hidden="true" viewBox="0 0 24 24"><rect x="6" y="4" width="4" height="16" rx="1.5"></rect><rect x="14" y="4" width="4" height="16" rx="1.5"></rect></svg>
      </button>
      <div class="ssd-readout">
        <strong data-readout-profile>2 Hz Schwebung · 180 Hz Träger</strong>
        <span data-readout-status>Bereit · Ton startet erst auf Klick</span>
      </div>
      <div class="ssd-eq" aria-hidden="true">{Array.from({ length: 12 }, () => <i></i>)}</div>
    </div>

    <details class="ssd-sources">
      <summary>Wissenschaftliche Grundlage</summary>
      <ul>
        <li><b>Frequenzbänder</b> nach klinischer EEG-Einteilung: Delta 0,5–4 Hz · Theta 4–8 Hz · Alpha 8–13 Hz · Beta 13–30 Hz.</li>
        <li><b>Binaurale Schwebung:</b> Oster, G. (1973). Auditory beats in the brain. <i>Scientific American</i>, 229(4).</li>
        <li><b>Rauschen zum Einschlafen:</b> Spencer, J. A. D. et al. (1990). White noise and sleep induction. <i>Archives of Disease in Childhood</i>, 65(1).</li>
        <li><b>Herzschlag:</b> Salk, L. (1962). Mothers' heartbeat as an imprinting stimulus. <i>Transactions of the New York Academy of Sciences</i>, 24.</li>
        <li><b>Atemrhythmus 6/min (0,1 Hz):</b> Lehrer, P. M. &amp; Gevirtz, R. (2014). Heart rate variability biofeedback. <i>Frontiers in Psychology</i>, 5.</li>
        <li><b>Lautstärke:</b> Hugh, S. C. et al. (2014). Infant sleep machines and hazardous sound pressure levels. <i>Pediatrics</i>, 133(4) – leise halten, Abstand zum Bett.</li>
      </ul>
      <p>Bei Säuglingen liegen die EEG-Grundrhythmen altersabhängig niedriger. Die Demo veranschaulicht das Prinzip der App im Browser – kein Medizinprodukt.</p>
    </details>
  </div>

  <div class="ssd-visual">
    <div class="ssd-stage" aria-hidden="true">
      <canvas></canvas>
      <div class="ssd-center">
        <strong data-timer>30:00</strong>
        <span data-center-label>Einschlafen</span>
      </div>
    </div>
    <div class="ssd-bands" aria-hidden="true">
      <div class="ssd-bands-track">
        {bands.map((b) => (
          <span class="ssd-band" data-band-seg={b.id} style={`left:${b.left.toFixed(2)}%;width:${b.width.toFixed(2)}%`}><em>{b.name}</em></span>
        ))}
        <span class="ssd-marker" data-marker><b data-marker-label>2 Hz</b></span>
      </div>
      <div class="ssd-ticks">{ticks.map((t, i) => <span style={`left:${t.left.toFixed(2)}%`}>{String(t.f).replace('.', ',')}{i === ticks.length - 1 ? ' Hz' : ''}</span>)}</div>
    </div>
  </div>
</section>

<script>
  import '../scripts/soundscape-demo.js';
</script>
