---
import data from '../content/site/prozess.json';
import { hl } from '../lib/text';
const steps = data.steps;
---

<section class="proz" id="prozess">
  <div class="shell shell--wide">
    <div class="proz__head">
      <p class="eyebrow" data-st>[ 04 ] {data.eyebrow}</p>
      <h2 class="proz__title display" data-st set:html={hl(data.title)}></h2>
    </div>

    <ol class="proz__steps">
      <span class="proz__line" data-line aria-hidden="true"></span>
      {steps.map((s) => (
        <li class="step" data-st>
          <span class="step__dot" aria-hidden="true"></span>
          <span class="step__no display">{s.no}</span>
          <h3 class="step__t display">{s.t}</h3>
          <p class="step__d">{s.d}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .proz { padding-block: var(--section-y); background: var(--color-void); }
  /* Desktop: full-viewport panel so the pinned sequence shows everything at once */
  @media (min-width: 901px) {
    .proz { min-height: 100vh; display: flex; align-items: center; padding-block: clamp(4rem, 9vh, 7rem); }
    .proz > .shell { width: 100%; }
  }
  .proz__head { max-width: 60ch; margin-bottom: clamp(2.6rem, 6vw, 4.5rem); }
  .proz__title { font-size: var(--step-4); margin-top: 1rem; }
  .proz__title em { font-style: normal; color: var(--color-signal); }

  .proz__steps { list-style: none; margin: 0; padding: 0; position: relative; display: grid; grid-template-columns: repeat(4, 1fr); gap: clamp(1.4rem, 3vw, 2.4rem); }
  .proz__line { position: absolute; top: 6px; left: 0; height: 1px; width: 100%; background: var(--color-line); }
  .proz__line::after { content: ""; position: absolute; inset: 0; transform-origin: left; background: var(--color-signal); transform: scaleX(var(--p, 0)); }
  .step { position: relative; padding-top: 2rem; }
  .step__dot { position: absolute; top: 0; left: 0; width: 13px; height: 13px; background: var(--color-carbon); border: 1.5px solid var(--color-ash); transition: all 0.4s ease; transform: translateY(-6px); }
  .step[data-on] .step__dot { border-color: var(--color-signal); background: var(--color-signal); }
  .step__no { font-size: var(--step-1); color: var(--color-signal); }
  .step__t { font-size: var(--step-2); margin: 0.4rem 0 0.7rem; }
  .step__d { margin: 0; font-size: var(--step-0); line-height: 1.5; color: var(--color-ash); }

  @media (max-width: 820px) {
    .proz__steps { grid-template-columns: 1fr; gap: 0; }
    .proz__line { left: 6px; top: 0; width: 1px; height: 100%; }
    .proz__line::after { transform-origin: top; transform: scaleY(var(--p, 0)); width: 100%; height: 100%; }
    .step { padding: 1.8rem 0 1.8rem 2rem; }
    .step__dot { top: 2rem; transform: none; }
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { prefersReducedMotion, registerGsap } from '../lib/motion';

  if (!prefersReducedMotion) {
    registerGsap();
    const section = document.getElementById('prozess')!;
    const line = section.querySelector<HTMLElement>('[data-line]')!;
    const steps = gsap.utils.toArray<HTMLElement>('#prozess .step');

    // head (eyebrow + title) always reveals on enter
    gsap.from('#prozess .proz__head [data-st]', {
      y: 26, opacity: 0, duration: 0.9, ease: 'expo.out', stagger: 0.08,
      scrollTrigger: { trigger: '#prozess', start: 'top 75%' },
    });

    const reveal = (p: number) => {
      line.style.setProperty('--p', String(gsap.utils.clamp(0, 1, p)));
      steps.forEach((s, i) => {
        const r = gsap.utils.clamp(0, 1, (p - i / steps.length) * steps.length + 0.5);
        s.style.opacity = String(0.2 + 0.8 * r);
        s.style.transform = `translateY(${(1 - r) * 22}px)`;
        r > 0.55 ? s.setAttribute('data-on', '') : s.removeAttribute('data-on');
      });
    };

    const desktop = window.matchMedia('(min-width: 901px)').matches;
    if (desktop) {
      // Pinned storytelling: section stays fixed while the four steps reveal in sequence.
      steps.forEach((s) => { s.style.opacity = '0.2'; });
      ScrollTrigger.create({
        trigger: '#prozess', start: 'top top', end: '+=170%',
        pin: true, scrub: 0.6, anticipatePin: 1,
        onUpdate: (self) => reveal(self.progress),
        onRefresh: (self) => reveal(self.progress),
      });
    } else {
      // Mobile / fallback: normal scroll-driven reveal (no pin)
      ScrollTrigger.create({
        trigger: '.proz__steps', start: 'top 85%', end: 'bottom 70%', scrub: 0.5,
        onUpdate: (self) => reveal(self.progress),
        onRefresh: (self) => reveal(self.progress),
      });
    }
  } else document.querySelectorAll('#prozess .step').forEach((s) => s.setAttribute('data-on', ''));
</script>
