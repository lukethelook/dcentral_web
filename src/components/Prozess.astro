---
import p from '../content/site/prozess.json';
import { hl } from '../lib/text';
---

<section class="process section shell" id="prozess">
  <h2 set:html={hl(p.title)} />
  <ol class="steps">
    {p.steps.map((s) => (
      <li>
        <span>{s.no}</span>
        <h3>{s.t}</h3>
        <p>{s.d}</p>
      </li>
    ))}
  </ol>
</section>
